<odoo noupdate="1">

        <!-- Rule for Regular Users: Strict access based on access_user_ids -->
        <record id="rule_mailbox_account_user_strict" model="ir.rule">
            <field name="name">Mailbox Account: Strict User Access</field>
            <field name="model_id" ref="model_mailbox_account"/>
            <field name="groups" eval="[(4, ref('group_mailbox_user'))]"/>
            <field name="domain_force">[('access_user_ids', 'in', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule for Admins: Full access -->
        <record id="rule_mailbox_account_admin_all" model="ir.rule">
            <field name="name">Mailbox Account: Admin Full Access</field>
            <field name="model_id" ref="model_mailbox_account"/>
            <field name="groups" eval="[(4, ref('group_mailbox_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

