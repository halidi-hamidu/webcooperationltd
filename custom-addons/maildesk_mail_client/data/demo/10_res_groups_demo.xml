<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <!-- Assign Mailbox Admin to Mitchell Admin via the group's users field -->
    <record id="group_mailbox_admin" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Assign Mailbox User to Marc Demo via the group's users field -->
    <record id="group_mailbox_user" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_demo'))]"/>
    </record>

</odoo>
