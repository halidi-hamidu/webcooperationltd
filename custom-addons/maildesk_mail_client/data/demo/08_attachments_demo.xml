<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <!-- Demo Attachments for Email Messages -->
    <!--
      Core attachments are defined in 07_ui_cache_demo.xml so that ui_cache can safely
      reference them via ref() during XML eval (manifest load order).
    -->

    <!-- PRO Demo Attachments -->
    <record id="attach_pro_invoice_q1_services" model="ir.attachment">
        <field name="name">Invoice_INV-2025-001_Q1_Services.pdf</field>
        <field name="type">binary</field>
        <field name="datas" type="base64" file="account/static/demo/in_invoice_yourcompany_demo_1.pdf"/>
        <field name="res_model">maildesk.message_index</field>
        <field name="res_id" ref="msg_pro_invoice_001"/>
        <field name="mimetype">application/pdf</field>
        <field name="description">Demo invoice PDF for pro scenario</field>
    </record>

    <record id="attach_pro_logo_concepts" model="ir.attachment">
        <field name="name">Logo_Concepts.png</field>
        <field name="type">binary</field>
        <field name="datas" type="base64" file="mail/static/src/img/odoobot.png"/>
        <field name="res_model">maildesk.message_index</field>
        <field name="res_id" ref="msg_pro_design_001"/>
        <field name="mimetype">image/png</field>
        <field name="description">Logo concept mockups (demo image)</field>
    </record>

</odoo>
