    <!-- Demo IMAP Servers -->
    <record id="demo_imap_server_support" model="fetchmail.server">
        <field name="name">Demo IMAP - Support</field>
        <field name="server">imap.example.com</field>
        <field name="port">993</field>
        <field name="is_ssl" eval="True"/>
        <field name="server_type">imap</field>
        <field name="user">support@example.com</field>
        <field name="password">demo_password</field>
        <field name="attach" eval="True"/>
