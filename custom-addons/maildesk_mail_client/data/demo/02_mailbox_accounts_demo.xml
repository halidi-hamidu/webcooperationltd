<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <!-- Shared Support Mailbox (IMAP) -->
    <record id="demo_mailbox_support" model="mailbox.account">
        <field name="sequence">10</field>
        <!-- Demo safety: keep provider sync crons from calling external services -->
        <field name="backoff_until" eval="datetime.now() + relativedelta(years=10)"/>
        <field name="name">Support Team</field>
        <field name="email">support@example.com</field>
        <field name="mail_server_id" ref="demo_imap_server_support"/>
        <field name="mail_send_server_id" ref="demo_smtp_server_support"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="is_shared" eval="True"/>
        <field name="access_user_ids" eval="[(6, 0, [ref('base.user_admin'), ref('base.user_demo')])]"/>
        <field name="signature"><![CDATA[<p>Best regards,<br/>Support Team<br/>YourCompany</p>]]></field>
    </record>

    <!-- Shared Sales Mailbox (Gmail) -->
    <record id="demo_mailbox_sales" model="mailbox.account">
        <field name="sequence">20</field>
        <field name="backoff_until" eval="datetime.now() + relativedelta(years=10)"/>
        <field name="name">Sales Department</field>
        <field name="email">sales@example.com</field>
        <field name="mail_server_id" ref="demo_gmail_server_sales"/>
        <field name="mail_send_server_id" ref="demo_smtp_server_sales"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="is_shared" eval="True"/>
        <field name="access_user_ids" eval="[(6, 0, [ref('base.user_admin'), ref('base.user_demo')])]"/>
        <field name="signature"><![CDATA[<p>Best regards,<br/>Sales Team<br/>YourCompany</p>]]></field>
        <field name="is_gmail" eval="True"/>
    </record>

