        <field name="mail_send_server_id" ref="demo_smtp_server_admin"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="is_shared" eval="False"/>
        <field name="access_user_ids" eval="[(6, 0, [ref('base.user_admin')])]"/>
