<?xml version="1.0" encoding="UTF-8" ?>
<!--
    MailDetail Component Template
    Message viewer with iframe body, actions toolbar, and attachments
-->
<templates xml:space="preserve">

    <t t-name="maildesk_mail_client.MailDetailComponent" owl="1">
        <section class="maildesk-content flex-grow-1 d-flex flex-column">
            <!-- Empty State -->
            <div class="maildesk-full-message rounded shadow-sm p-4 h-100">
            <t t-if="!hasMessage">
                <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-muted h-100">
                    <i class="fa fa-envelope-open-o fa-4x mb-3"/>
                    <p>Select a message to view</p>
                </div>
            </t>

            <t t-else="">

                <!-- Toolbar -->
                <div
                        class="maildesk-full-message-header scrollable-buttons d-flex justify-content-between align-items-center pb-3 d-flex gap-2"
                    >
                        <div class="d-flex gap-2" t-if="!selectedMessage.is_draft">
                            <button
                                class="btn rounded-pill d-flex align-items-center"
                                t-on-click="() =&gt; this.openReplyComposer(selectedMessage)"
                                data-tooltip="Reply to sender"
                                accesskey="r"
                            >
                                <img
                                    src="/maildesk_mail_client/static/src/icons/reply.svg"
                                    class="me-1"
                                    width="16"
                                    height="16"
                                />Reply
                            </button>
                            <button
                                class="btn rounded-pill d-flex align-items-center"
                                t-on-click="() =&gt; this.openReplyAllComposer(selectedMessage)"
                                data-tooltip="Reply to all recipients"
                                accesskey="a"
                            >
                                <img
                                    src="/maildesk_mail_client/static/src/icons/reply_all.svg"
                                    class="me-1"
                                    width="16"
                                    height="16"
                                />Reply All
                            </button>
                            <button
                                class="btn rounded-pill d-flex align-items-center"
                                t-on-click="() =&gt; this.openForwardComposer(selectedMessage)"
                                data-tooltip="Forward this message"
                                accesskey="f"
                            >
                                <img
                                    src="/maildesk_mail_client/static/src/icons/forward.svg"
                                    class="me-1"
                                    width="16"
                                    height="16"
                                />Forward
                            </button>
                        </div>

                        <t t-if="selectedMessage.is_draft">
                            <div class="d-flex gap-2">
                                <button
                                    class="btn rounded-pill d-flex align-items-center"
                                    t-on-click="() =&gt; this.openDraftComposer(selectedMessage)"
                                    data-tooltip="Edit draft"
                                    accesskey="e"
                                >
                                    <img
                                        src="/maildesk_mail_client/static/src/icons/drafts.svg"
                                        class="me-1"
                                        width="16"
                                        height="16"
                                    />Edit Draft
                                </button>
                            </div>
                        </t>

                        <div class="d-flex">
                            <button
                                class="btn rounded-pill d-flex align-items-center"
                                t-on-click="() =&gt; this.printMessage()"
                                data-tooltip="Print this email"
                                accesskey="p"
                            >
                                <img
                                    src="/maildesk_mail_client/static/src/icons/drafts.svg"
                                    class="me-1"
                                    width="16"
                                    height="16"
                                />Print
                            </button>

                            <t t-if="!selectedMessage.avatar_partner_id">
                                <button
                                    class="btn rounded-pill d-flex align-items-center"
                                    t-on-click="() => this.createPartnerFromMessage(selectedMessage)"
                                    data-tooltip="Create a new contact from this sender"
                                    accesskey="c"
                                >
                                    <img
                                        src="/maildesk_mail_client/static/src/icons/create_contact.svg"
                                        class="me-1"
                                        width="16"
                                        height="16"
                                    />
                                    Create Contact
                                </button>
                            </t>
                            <t t-if="selectedMessage.avatar_partner_id">
                                <button
                                    class="btn rounded-pill d-flex align-items-center"
                                    t-on-click="() => this.onClickViewProfile(selectedMessage.avatar_partner_id)"
                                    data-tooltip="View sender's profile"
                                    accesskey="c"
                                >
                                    <img
                                        src="/maildesk_mail_client/static/src/icons/open_contact.svg"
                                        class="me-1"
                                        width="16"
                                        height="16"
                                    />
                                    Open Contact
                                </button>
                            </t>
                            <t t-if="selectedMessage.model and selectedMessage.res_id">
                                <button
                                    class="btn rounded-pill d-flex align-items-center"
                                    t-on-click="() => this.openLinkedDocument(selectedMessage)"
                                    data-tooltip="Open linked document"
                                    accesskey="o"
                                >
                                    <img
                                        src="/maildesk_mail_client/static/src/icons/open_document.svg"
                                        class="me-1"
                                        width="16"
                                        height="16"
                                    />Open Document
                                </button>
                            </t>
                        </div>

                        <div class="d-flex align-items-center gap-3 text-primary-emphasis">
                            <img
                                src="/maildesk_mail_client/static/src/icons/archive.svg"
                                width="18"
                                height="18"
                                class="cursor-pointer"
                                data-tooltip="Archive message"
                                t-on-click="() =&gt; this.moveMessagesToFolder('is_archive', selectedMessage)"
                            />
                            <img
                                src="/maildesk_mail_client/static/src/icons/trash.svg"
                                width="18"
                                height="18"
                                class="cursor-pointer"
                                data-tooltip="Delete message"
                                t-on-click.stop="() =&gt; this.deleteSelected(selectedMessage)"
                            />
                            <img
                                src="/maildesk_mail_client/static/src/icons/unread.svg"
                                width="18"
                                height="18"
                                class="cursor-pointer"
                                data-tooltip="Mark as unread"
                                t-on-click="() =&gt; this.markSelectedAsUnread()"
                            />
                            <img
                                src="/maildesk_mail_client/static/src/icons/starred.svg"
                                width="18"
                                height="18"
                                class="cursor-pointer"
                                t-att-class="selectedMessage?.is_starred ? 'cursor-pointer star-active' : 'cursor-pointer'"
                                data-tooltip="Toggle star"
                                t-on-click="() =&gt; this.toggleStarForSelected()"
                            />
                            <img
                                src="/maildesk_mail_client/static/src/icons/tags.svg"
                                width="18"
                                height="18"
                                class="cursor-pointer"
                                data-tooltip="Assign tags"
                                t-on-click="() =&gt; this.openAssignTagsDialog(selectedMessage)"
                            />
                            <img
                                src="/maildesk_mail_client/static/src/icons/move.svg"
                                width="18"
                                height="18"
                                class="cursor-pointer"
                                data-tooltip="Move to folder"
                                t-on-click="() =&gt; this.openMoveToFolderDialog(selectedMessage)"
                            />
                        </div>
                    </div>

                <!-- Message Header -->
                <div class="maildesk-detail-header p-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-start flex-wrap mb-3 info-container">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <div
                                    t-out="selectedMessage.avatar_html"
                                    class="overflow-hidden sender-icon"
                                    style="width: 48px; height: 48px; cursor: pointer"
                                    t-on-click.stop="(ev) =&gt; this.onClickPartner(ev, selectedMessage.avatar_partner_id)"
                                />
                            </div>
                            <div>
                                <h5
                                    class="mb-0 fw-semibold"
                                    t-out="selectedMessage.sender_display_name || '?'"
                                    style="cursor: pointer"
                                    t-on-click.stop="(ev) =&gt; this.onClickPartner(ev, selectedMessage.avatar_partner_id)"
                                />
                                <div class="mt-1 info-container-bod">
                                    <div class="text-muted small">
                                        <t t-if="isSentFolder">
                                            <strong>From mailbox:</strong> <span class="text-muted small" t-out="mailboxEmail" />
                                        </t>
                                        <t t-else="">
                                            <strong>From:</strong> <span class="text-muted small" t-out="selectedMessage.email_from" />
                                        </t>
                                    </div>
                                </div>
                                <div class="text-muted small">
                                    <t t-if="selectedMessage.account_display">
                                        <div>
                                            <strong>Mailbox:</strong>
                                            <span t-out="selectedMessage.account_display" />
                                        </div>
                                    </t>
                                    <t t-if="selectedMessage.to_display">
                                        <div>
                                            <strong>To:</strong> <span t-out="selectedMessage.to_display" />
                                        </div>
                                    </t>
                                    <t t-if="selectedMessage.cc_display">
                                        <div>
                                            <strong>Cc:</strong> <span t-out="selectedMessage.cc_display" />
                                        </div>
                                    </t>
                                    <t t-if="selectedMessage.bcc_display">
                                        <div>
                                            <strong>Bcc:</strong> <span t-out="selectedMessage.bcc_display" />
                                        </div>
                                    </t>
                                    <t t-if="selectedMessage.reply_to">
                                        <div>
                                            <strong>Reply to:</strong> <span t-out="selectedMessage.reply_to" />
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="text-end mt-2 mt-md-0">
                            <div
                                class="text-muted small small-formatted_date mb-2"
                                t-out="formatUserDate(selectedMessage.formatted_date)"
                            />
                            <!-- Folder & Mailbox Info -->
                            <div class="d-flex align-items-end gap-1 mb-2">
                                <t t-if="mailboxName">
                                    <span class="badge bg-light text-dark border fw-normal ms-auto" title="Mailbox">
                                        <i class="fa fa-inbox me-1 text-muted"/>
                                        <t t-out="mailboxName"/>
                                    </span>
                                </t>
                                <t t-if="folderName">
                                    <span class="badge bg-light text-dark border fw-normal ms-auto" title="Folder">
                                        <i class="fa fa-folder-open-o me-1 text-muted"/>
                                        <t t-out="folderName"/>
                                    </span>
                                </t>
                            </div>
                            <t t-if="selectedMessage.tag_ids">
                                <div class="d-flex gap-1 mt-2 justify-content-end">
                                    <t t-foreach="selectedMessage.tag_ids" t-as="tag" t-key="tag.id">
                                        <span
                                            class="badge rounded-pill text-white fw-medium justify-content-end"
                                            t-att-style="'background-color:' + tag.color + ';'"
                                            t-out="tag.name"
                                        />
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>

                    <h3 t-out="selectedMessage.subject || 'No Subject'" />
                    <t t-set="selectedMessage.partner_trusted" t-value="selectedMessage.content_trusted"/>
                    <t t-if="!selectedMessage.force_show_content and !selectedMessage.partner_trusted">
                        <div class="alert alert-warning d-block p-3">
                            <div class="d-flex align-items-center mb-2">
                                <img
                                    src="/maildesk_mail_client/static/src/icons/security.svg"
                                    width="20"
                                    height="20"
                                    class="me-2"
                                />
                                <strong class="me-1">Safe Mode:</strong> Suspicious content has been blocked for your
                                safety.
                            </div>
                            <p class="mb-2">
                                To view the full content, we recommend checking this email or only trusting known
                                senders.
                            </p>
                            <div class="d-flex gap-2 trust-buttons flex-wrap">
                                <button
                                    class="btn rounded-pill d-flex align-items-center"
                                    t-on-click="() => this.trustEmailOnce(selectedMessage)"
                                    accesskey="t"
                                    data-tooltip="Trust this email and display its full content."
                                >
                                    <img
                                        src="/maildesk_mail_client/static/src/icons/show_once.svg"
                                        class="me-1"
                                        width="16"
                                        height="16"
                                    />
                                    Show Once
                                </button>

                                <button
                                    class="btn rounded-pill d-flex align-items-center"
                                    t-on-click="() => this.trustPartner(selectedMessage)"
                                    accesskey="u"
                                    data-tooltip="Trust the sender of this email for all future communications."
                                >
                                    <img
                                        src="/maildesk_mail_client/static/src/icons/security.svg"
                                        class="me-1"
                                        width="16"
                                        height="16"
                                    />
                                    Trust Sender
                                </button>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Email Body (iframe) -->
                <div class="maildesk-detail-body flex-grow-1 overflow-auto p-3">
                    <iframe
                        t-ref="iframe"
                        class="email-preview-iframe w-100 border-0"
                        t-att-srcdoc="state.iframeSrcdoc"
                        t-att-sandbox="iframeSandbox"
                        src="about:blank"
                    />
                </div>

	                <t t-if="selectedMessage.attachments?.length">
	                        <t t-if="selectedMessage.attachments?.length">
	                            <div class="mt-3 mb-5 pb-4">
	                                <AttachmentList
	                                    attachments="attachmentsForAttachmentList"
	                                    unlinkAttachment="() =&gt; {}"
	                                />
	                            </div>
	                        </t>
	                    </t>
                    <t t-else="">
                        <div class="pb-4" />
                    </t>

                <!-- Thread History (below selected message, Gmail/Outlook style) -->
                <t t-if="threadMessages.length > 0">
                    <div class="maildesk-thread-history border-top pt-3 mt-3">
                        <ThreadContainer messages="threadMessages"/>
                    </div>
                </t>
            </t>
            </div>
        </section>
    </t>

</templates>
