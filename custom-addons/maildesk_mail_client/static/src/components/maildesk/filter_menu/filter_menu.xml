<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="maildesk_mail_client.FilterMenu" owl="1">
       <div class="custom-context-menu">
            <ul>
                <t t-foreach="props.items" t-as="item" t-key="item.id">
                    <li t-on-click="() => this.onItemClick(item)" t-att-data-action="item.id">
                        <t t-out="item.label"/>
                    </li>
                </t>
            </ul>
        </div>
    </t>
</templates>
