<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="maildesk_mail_client.UndoToast" owl="1">
       <div class="maildesk-toast-wrapper">
          <div class="toast fade-in">
              <div class="toast-content">
                  <span t-out="props.message" />
                  <button type="button" class="undo-btn" t-on-click="onUndoClick" t-out="props.undoText" />
              </div>
              <div class="toast-progress"></div>
          </div>
       </div>
    </t>
</templates>
