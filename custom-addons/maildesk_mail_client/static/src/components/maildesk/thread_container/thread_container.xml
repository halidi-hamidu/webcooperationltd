<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ThreadContainer Component Template
    Iterates over thread messages and renders ThreadMessage for each.
-->
<templates xml:space="preserve">

    <t t-name="maildesk_mail_client.ThreadContainerComponent" owl="1">
        <div class="maildesk-thread-container">
            <t t-foreach="props.messages" t-as="msg" t-key="msg.msg_key">
                <ThreadMessage message="msg"/>
            </t>
        </div>
    </t>

</templates>
