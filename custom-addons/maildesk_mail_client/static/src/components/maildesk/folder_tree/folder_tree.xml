<?xml version="1.0" encoding="UTF-8" ?>
<!--
    FolderTree Component Template
    Extracted from maildesk.xml Sidebar template
-->
<templates xml:space="preserve">

    <t t-name="maildesk_mail_client.FolderTreeComponent" owl="1">
        <aside class="maildesk-sidebar bg-light border-end p-3">
            <!-- Compose Button -->
            <div class="d-flex align-items-center justify-content-center mb-3 composer-par">
                <button
                    class="btn btn-composer w-100"
                    t-on-click="onComposeClick"
                    data-tooltip="Compose a new email"
                    accesskey="n"
                >
                    <img
                        loading="lazy"
                        src="/maildesk_mail_client/static/src/icons/composer.svg"
                        style="width: 34px; height: 31px; padding-bottom: 4px; filter: brightness(0.5);"
                    /> Compose
                </button>
            </div>

            <t t-if="partnerName">
                <div class="alert alert-info py-2 px-3 d-flex align-items-center gap-2 mb-3" role="alert">
                    <div
                        class="flex-grow-1"
                        style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer"
                        t-on-click.stop="(ev) =&gt; this.partnerCard.open(ev.currentTarget, { id: partnerId })"
                    >
                        <img
                            loading="lazy"
                            src="/maildesk_mail_client/static/src/icons/open_contact.svg"
                            class="me-1 folder-icon"
                            width="21"
                            height="21"
                            style="margin-bottom: 2px"
                        />
                        <span t-out="partnerName" />
                    </div>
                    <button
                        class="btn d-flex align-items-center"
                        t-on-click="clearContactFilter"
                        data-tooltip="Remove contact filter and show all"
                    >
                        <i class="fa fa-times" />
                    </button>
                </div>
            </t>

            <!-- No Accounts Warning -->
            <t t-if="accounts.length === 0">
                <div class="alert alert-info" role="alert">
                    <strong>No mailboxes configured</strong><br/>
                </div>
            </t>

            <t t-else="">
                <!-- All Mailboxes Filter -->
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <a
                        href="#"
                        class="btn btn-sm w-100 text-start fw-bold rounded filter-alle-btn ps-0"
                        t-att-class="isAllFilterActive() ? 'selected-filter' : 'text-muted'"
                        t-on-click="onResetFilters"
                        data-tooltip="Show all mailboxes and folders"
                    >
                        <img
                            loading="lazy"
                            src="/maildesk_mail_client/static/src/icons/inbox.svg"
                            class="me-2 folder-icon"
                            width="21"
                            height="21"
                        />
                        All Mailboxes
                    </a>
                </div>

                <!-- Account List -->
                <t t-foreach="accounts" t-as="account" t-key="account.id">
                    <hr class="mt-1"/>

                    <h6
                        class="mt-3 account-name d-flex align-items-center text-truncate p-1 rounded"
                        t-att-data-account-id="account.id"
                        t-att-class="isAccountActive(account.id) ? 'selected-account' : 'text-muted'"
                        t-att-title="account.email"
                    >
                        <i
                            class="fa me-2 folder-toggle-icon fa-chevron-right"
                            role="button"
                            data-bs-toggle="collapse"
                            t-att-data-bs-target="'#folders-' + account.id"
                            t-att-aria-expanded="isFolderExpanded(account.id, 'account') ? 'true' : 'false'"
                            aria-controls="'folders-' + account.id"
                            style="cursor: pointer"
                            t-on-click.stop="() => toggleFolderExpand(account.id, 'account')"
                        />

                        <span
                            class="flex-grow-1"
                            style="cursor: pointer"
                            t-out="account.name"
                            t-on-click="() =&gt; filterByAccount(account.id)"
                        />
                    </h6>

                    <ul class="list-unstyled ms-2 collapse"
                        t-att-class="{show: isFolderExpanded(account.id, 'account')}"
                        t-att-id="'folders-' + account.id">
                        <!-- Folder Loading Skeleton -->
                        <t t-if="maildeskStore.loading.folders[account.id]">
                            <li class="folder-li">
                                <div class="d-flex align-items-center p-1 skelPulse" style="height: 28px;">
                                    <span class="skel-line" style="width: 60%; height: 14px; border-radius: 4px;"/>
                                </div>
                            </li>
                            <li class="folder-li">
                                <div class="d-flex align-items-center p-1 skelPulse" style="height: 28px;">
                                    <span class="skel-line" style="width: 45%; height: 14px; border-radius: 4px;"/>
                                </div>
                            </li>
                            <li class="folder-li">
                                <div class="d-flex align-items-center p-1 skelPulse" style="height: 28px;">
                                    <span class="skel-line" style="width: 52%; height: 14px; border-radius: 4px;"/>
                                </div>
                            </li>
                        </t>
                        <!-- Actual Folder Tree -->
                        <t t-else="">
                            <t t-set="tree" t-value="this.getFolderTree(account.id)" />
                            <t t-foreach="tree" t-as="folder" t-key="folder.id">
                                <t t-call="maildesk_mail_client.FolderTreeItem">
                                    <t t-set="folder" t-value="folder" />
                                    <t t-set="accountId" t-value="account.id" />
                                    <t t-set="depth" t-value="0" />
                                </t>
                            </t>
                        </t>
                    </ul>
                </t>

                <!-- Tags Section -->
                <t t-if="tags.length > 0">
                    <div class="d-flex justify-content-between align-items-center mt-4 mb-2 ms-2">
                        <strong>Tags</strong>
                        <a
                            href="#"
                            class="btn btn-link p-0 text-decoration-none"
                            t-on-click="onClearTags"
                            data-tooltip="Remove all tag filters"
                        >
                            Clear
                        </a>
                    </div>
                    <ul class="list-unstyled ms-2">
                        <t t-foreach="tags" t-as="tag" t-key="tag.id">
                            <li>
                                <a
                                    href="#"
                                    class="d-flex align-items-center p-1 rounded"
                                    t-att-class="isTagActive(tag.id) ? 'selected-filter' : 'text-muted'"
                                    t-on-click="() => onTagClick(tag.id)"
                                >
                                    <span
                                        class="badge rounded-pill px-2 py-1 text-white fw-medium"
                                        t-att-style="'background-color:' + tag.color + ';'"
                                        t-out="tag.name"
                                    />
                                </a>
                            </li>
                        </t>
                    </ul>
                </t>
            </t>
        </aside>
    </t>

    <!-- Recursive Folder Item Template -->
    <t t-name="maildesk_mail_client.FolderTreeItem" owl="1">
        <li class="folder-li">
            <div
                class="d-flex align-items-center w-100"
                t-att-class="this.isFolderActive(folder.id) ? 'selected-folder' : 'text-muted'"
                t-att-style="'padding-left: ' + (depth * 12) + 'px;'"
            >
                <!-- Expand/Collapse Icon (if has children) -->
                <t t-if="folder.children and folder.children.length">
                    <i
                        class="fa fa-chevron-right me-2 ms-1 folder-toggle-icon cursor-pointer"
                        role="button"
                        data-bs-toggle="collapse"
                        t-att-data-bs-target="'#subfolders-' + folder.id"
                        t-att-aria-expanded="this.isFolderExpanded(folder.id, 'folder') ? 'true' : 'false'"
                        aria-controls="'subfolders-' + folder.id"
                        style="cursor: pointer; width: 14px;"
                        t-on-click.stop="() => this.toggleFolderExpand(folder.id, 'folder')"
                    />
                </t>

                <i class="fa me-2" t-else="" style="width: 14px; opacity: 0;" />
                <!-- Folder Icon + Name -->
                <a
                    href="#"
                    class="d-flex align-items-center text-decoration-none flex-grow-1 p-1 rounded"
                    t-att-class="{'fw-bold selected-folder': state.currentFolderId === folder.id}"
                    t-on-click="() => onFolderClick(folder.id, accountId)"
                >
                    <img
                        loading="lazy"
                        t-att-src="this.getFolderIcon(folder)"
                        class="me-2 folder-icon"
                        width="18"
                        height="18"
                    />
                    <span t-out="folder.name"/>
                </a>

                <!-- Unread Badge -->
                <t t-if="this.getFolderUnread(folder.id) > 0">
                    <span class="badge badge-folder-unread" t-out="this.getFolderUnread(folder.id)"/>
                </t>
            </div>

            <!-- Children (recursive) -->
            <t t-if="folder.children and folder.children.length">
                <ul class="list-unstyled ms-2 collapse"
                    t-att-class="{show: this.isFolderExpanded(folder.id, 'folder')}"
                    t-att-id="'subfolders-' + folder.id">
                    <t t-foreach="folder.children" t-as="child" t-key="child.id">
                        <t t-call="maildesk_mail_client.FolderTreeItem">
                            <t t-set="folder" t-value="child"/>
                            <t t-set="accountId" t-value="accountId"/>
                            <t t-set="depth" t-value="depth + 1"/>
                        </t>
                    </t>
                </ul>
            </t>
        </li>
    </t>

</templates>
