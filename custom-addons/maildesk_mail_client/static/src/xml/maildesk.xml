<templates xml:space="preserve">
    <t t-name="maildesk_mail_client.MailDesk" owl="1">
        <div class="maildesk-mail-client">
            <div class="maildesk-body d-flex bg-light">
                <!-- Sidebar / Folder Tree -->
                <FolderTree/>

                <!-- Message List -->
                <MailList currentFolderName="currentFolderName"/>

                <!-- Message Detail -->
                <MailDetail message="maildeskStore.selectedMessage"/>
            </div>

            <t t-if="state.undoToast">
                <UndoToast t-props="state.undoToast" />
            </t>
        </div>
    </t>

</templates>
