<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="send_sms_notification_atras" forcecreate='True' model="ir.cron">
            <field name="name">Send SMS Notifications (LATRA- VTS)</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="model_id" ref="model_sms_notification"/>
            <field name="state">code</field>
            <field name="code">model.send_sms_notification_cron()</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="queue_sms_notification_atras" forcecreate='True' model="ir.cron">
            <field name="name">Queue SMS Notifications (LATRA- VTS)</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="model_id" ref="model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.queue_sms_notification()</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="get_delivered_reports_sms_notification" forcecreate='True' model="ir.cron">
            <field name="name">Update SMS Delivery Status (LATRA- VTS)</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_sms_notification"/>
            <field name="state">code</field>
            <field name="code">model.update_delivery_status()</field>
        </record>
    </data>
</odoo>
