<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Queue SMS Notification Cron - Generates SMS mailings.
        This cron job creates mailing.mailing records for invoice reminders
    -->
    <data noupdate="1">
        <record id="queue_sms_notification_atras" forcecreate='True' model="ir.cron">
            <field name="name">Queue SMS Notifications (LATRA- VTS)</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="model_id" ref="model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.queue_sms_notification()</field>
        </record>
    </data>

</odoo>
