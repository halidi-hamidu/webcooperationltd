<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sms_tree_view" model="ir.ui.view">
            <field name="name">sms.notification.tree.view</field>
            <field name="model">sms.notification</field>
            <field name="arch" type="xml">
                <list string="SMS Notifications" default_order="create_date desc"
                    decoration-muted="state=='canceled'"
                    decoration-danger="state=='error'">
                    <field name="create_date" string="Created Date" />
                    <field name="customer" />
                    <field name="invoice_id" />
                    <field name="invoice_date" string="Invoice Date" />
                    <field name="phone_number" />
                    <field name="message" widget="html" />
                    <field name="sent_datetime" />
                    <field name="delivered_datetime" />
                    <button name="send_again" string="Send Now" type="object"
                        icon="fa-paper-plane text-success"
                        invisible="state == 'outgoing'" confirm="Do you want send the Message now?" />
                    <button name="mark_outgoing" string="Retry" type="object"
                        icon="fa-repeat text-success"
                        invisible="state != 'error'" confirm="Retry Sending the Message now?" />
                    <button name="cancel" string="Cancel Email" type="object"
                        icon="fa-times-circle text-danger"
                        invisible="state != 'outgoing'" confirm="Are you sure you want to Cancel the Message?" />
                    <field name="type" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="sms_view_form" model="ir.ui.view">
            <field name="name">sms.notification.view.form</field>
            <field name="model">sms.notification</field>
            <field name="arch" type="xml">
                <form string="Email message">
                    <header>
                        <button name="send_again" string="Send Now" type="object" invisible="state != 'outgoing'"
                            class="oe_highlight" />
                        <button name="mark_outgoing" string="Retry" type="object"
                            invisible="state != 'error'" />
                        <button name="cancel" string="Cancel" type="object" invisible="state != 'outgoing'" />
                        <field name="state" widget="statusbar"
                            statusbar_visible="outgoing,sent,delivered,error,cancel" />
                    </header>
                    <sheet>
                        <group class="oe_right">
                            <!-- message_count -->
                            <div class="text-right">
                                <button name="view_message" type="object"
                                    class="oe_right">
                                    <i class="fa fa-commenting-o fa-5x" aria-hidden="true"></i>

                                    <field name="message_count" readonly="True"/>
                                </button>
    
                            </div>
                        </group>
                        <group>
                            
                            <group>
                                 <field name="customer"
                                    readonly="state in ('state','in',('sent','canceled','error','delivered'))" />
                                <field name="create_date" string="Created Date" />
                                <field name="phone_number" />
                                <field name="invoice_id"
                                    readonly="state in ('state','in',('sent','canceled','error','delivered'))" />
                            </group>
                            <group>
                                <field name="type"
                                    readonly="state in ('state','in',('sent','canceled','error','delivered'))" />
                                <field name="sent_datetime" readonly="1" />
                                <field name="delivered_datetime" readonly="1" />
                                <field name="use_sms_template"
                                    readonly="state in ('state','in',('sent','canceled','error','delivered'))" />
                                <field name="template_id"
                                    options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"
                                    readonly="state in ('state','in',('sent','canceled','error','delivered'))" />
                            </group>

                        </group>

                        <notebook>
                            <page string="Body"
                                readonly="use_sms_template == True">
                                <field name="message" widget="text"
                                    readonly="state in ('state','in',('sent','canceled','error','delivered'))" />
                            </page>
                            <page string="Failure Reason"
                                readonly="state != 'error'">
                                <field name="failure_reason" readonly="True" />
                            </page>
                            <page string="Waiting Delivery Status"
                                readonly="state != 'sent'">
                                <group>
                                    <button class="oe_highlight" name="mark_outgoing" type="object"
                                        string="Enable Editing On Delivery Failure"
                                        confirm="Do you really wish to perform this action?" />
                                </group>

                                <field name="after_sent_state" readonly="True" />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

