        <record id="sms_act_window" model="ir.actions.act_window">
            <field name="name">SMS Notifications</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sms.notification</field>
            <field name="view_mode">list,form,search</field>
            <field name="context">{"search_default_group_customer":0}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Messages Found
                </p>
            </field>
        </record>

        <!-- sms broad casting  section -->
        <record id="sms__broadcasting_tree_view" model="ir.ui.view">
            <field name="name">sms.notification.tree.view</field>
            <field name="model">sms.notification.broadcast</field>
            <field name="arch" type="xml">
                <list string="SMS Notifications Broadcasting " default_order="create_date desc">
                    <field name="name" string="Notification Broadcasting" />
                    <field name="customer_tags" string="Customer tags" widget="many2many_tags" />
                    <field name="customer_count"/>
                </list>
            </field>
        </record>

        <record id="sms_broadcasting_view_form" model="ir.ui.view">
            <field name="name">sms.notification.broadcasting.view.form</field>
            <field name="model">sms.notification.broadcast</field>
            <field name="arch" type="xml">
                <form string="Email message">
                    <header>
                        <button name="generate_sms" string="Generate SMS" type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,finish" />
                    </header>
                    <sheet>
                        <div class="text-right">
                            <button name="action_view_customers" type="object"
                                class="oe_right">
                                <i class="fa fa-users fa-5x" aria-hidden="true"></i>
                                <field name="customer_count" readonly="True"/>
                            </button>

                        </div>

                        <separator string=" " colspan="4" />
                        <group>
                            <field name="name" />
                            <field name="customer_tags" widget="many2many_tags" />
                         
                        </group>
                        <notebook>
                            <page string="Body">
                                <field name="body_html" widget="text" />
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="sms_broadcasting_act_window" model="ir.actions.act_window">
            <field name="name">SMS Broadcast Notifications</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sms.notification.broadcast</field>
            <field name="view_mode">list,form,search</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Template found
                </p>
            </field>
        </record>

        <menuitem id="sms_root" name="SMS" parent="sale.sale_menu_root"
            sequence="20" />
        <menuitem id="sms_notification_menu" name="SMS Notifications" parent="sms_root"
            action="sms_act_window" sequence="10" />
        <menuitem id="sms_broadCasting_menu" name="Broadcast Template" parent="sms_root"
            action="sms_broadcasting_act_window" sequence="20" />


    </data>
</odoo>