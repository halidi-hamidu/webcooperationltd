<?xml version="1.0"?>
<odoo>

    <record id="view_partner_form_sms_notification" model="ir.ui.view">
        <field name="name">res.partner.form.sms.notification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                    name="action_open_sms_notification" context="{'default_customer': id, 'default_team_id': False}" icon="fa-envelope" invisible="sms_count == 0">
                    <div class="o_stat_info">
                        <field name="sms_count" class="o_stat_value"/>
                        <span class="o_stat_text"> SMS</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
