<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sms_notification_inherit" model="ir.ui.view">
        <field name="name">account.move.form.sms.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             <xpath expr="//notebook" postion="inside">
                <page name="sms_info" string="SMS Info" groups="base.group_system">
                        <group string="SMS Info">
                            <group id="sms_tab_group">
                                <field name="sms_notification_limit"/>
                                <field name="new_registration_sms_limit"/>
                                <field name="seven_days_sms_limit"/>
                                <field name="above_seven_days_sms_limit"/>
                                <field name="fifteen_days_sms_limit"/>
                                <field name="thirty_days_before_sms_limit"/>
                                <field name="due_day_sms_limit"/>
                            </group>
                        </group>
                </page>
           </xpath>
        </field>
    </record>
</odoo>