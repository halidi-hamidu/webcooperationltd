<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_trips_list_view" model="ir.ui.view">
        <field name="name">fleet_trips_view_list</field>
        <field name="model">fleet.traccar.trips</field>
        <field name="arch" type="xml">
            <list create="0" string="fleet_trips_list">
                <field name="name"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="distance_in_km" sum="Total Distance"/>
                <field name="average_speed_kph" avg="Avereage Speed"/>
                <field name="max_speed_kph"/>
                <field name="duration_hr" sum="Total Time Spent"/>
                <field name="spent_fuel" sum="Total Fuel"/>
                <field name="start_address"/>
                <field name="end_address"/>
                <field name="start_lat" optional="hide"/>
                <field name="end_lat" optional="hide"/>
                <field name="start_lon" optional="hide"/>
                <field name="end_lon" optional="hide"/>
                <button name="open_map" type="object" string="View on Map"></button>
            </list>
        </field>
    </record>

    <record id="fleet_trips_search_view" model="ir.ui.view">
        <field name="name">Traccar.fleet_trips.search</field>
        <field name="model">fleet.traccar.trips</field>
        <field name="arch" type="xml">
            <search string="Fleet Trips">
                <field name="name" string="Vehicle"/>
                <filter string="Start Date" name="start_time" date="start_time"/>
                <filter string="End Date" name="end_time" date="end_time"/>
                <group>
                    <filter string="Vehicle" name="group_name"
                            context="{'group_by':'name'}"/>
                    <separator/>
                    <filter string="Start Date" name="start_time_grp" context="{'group_by': 'start_time'}"/>
                    <filter string="End Date" name="end_time_grp" context="{'group_by': 'end_time'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fleet_trips_action" model="ir.actions.act_window">
        <field name="name">Fleet Trips</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.traccar.trips</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_name':1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No trips currently
            </p>
        </field>
    </record>

    <menuitem id="menu_fleet_trips_action"
              name="Fleet Trips"
              parent="fleet.menu_fleet_reporting"
              action="fleet_trips_action"
              sequence="4"
              groups="fleet.fleet_group_manager"/>

</odoo>