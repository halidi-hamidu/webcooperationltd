<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_stops_list_view" model="ir.ui.view">
        <field name="name">fleet_stops_view_list</field>
        <field name="model">fleet.traccar.stops</field>
        <field name="arch" type="xml">
            <list create="0" string="fleet_stops_list">
                <field name="name"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="duration_hr" sum="Total Time Stoped"/>
                <field name="engine_hours_hr"/>
                 <field name="address"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <button name="open_map" type="object" string="View on Map"></button>
            </list>
        </field>
    </record>

    <record id="fleet_stops_search_view" model="ir.ui.view">
        <field name="name">Traccar.fleet_stops.search</field>
        <field name="model">fleet.traccar.stops</field>
        <field name="arch" type="xml">
            <search string="Fleet Stops">
                <field name="name" string="Vehicle"/>
                <filter string="Start Date" name="start_time" date="start_time"/>
                <filter string="End Date" name="end_time" date="end_time"/>
                <group>
                    <filter string="Vehicle" name="group_name" context="{'group_by':'name'}"/>
                    <separator/>
                    <filter string="Start Date" name="start_time_grp" context="{'group_by': 'start_time'}"/>
                    <filter string="End Date" name="end_time_grp" context="{'group_by': 'end_time'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fleet_stops_action" model="ir.actions.act_window">
        <field name="name">Fleet Stops</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.traccar.stops</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_name':1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No stops currently
            </p>
        </field>
    </record>

    <menuitem id="menu_fleet_stops_action"
              name="Fleet Stops"
              parent="fleet.menu_fleet_reporting"
              action="fleet_stops_action"
              sequence="3"
              groups="fleet.fleet_group_manager"/>
</odoo>