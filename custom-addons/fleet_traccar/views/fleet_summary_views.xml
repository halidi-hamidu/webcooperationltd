<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_summary_view_tree" model="ir.ui.view">
        <field name="name">fleet_summary_view_tree</field>
        <field name="model">fleet.traccar.summary</field>
        <field name="arch" type="xml">
            <tree create="0" string="fleet_summary_tree" >
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="start_time" string="Date"/>
                <field name="distance_in_km" sum="Total Distance"/>
                <field name="average_speed_kph" avg="Avereage Speed"/>
                <field name="engine_hours_hr" />
                <field name="max_speed_kph" />
                <field name="spent_fuel" sum="Total Fuel"/>
                <field name="end_time" />
            </tree>
        </field>
    </record>

    <record id="fleet_summary_search_view" model="ir.ui.view">
        <field name="name">Traccar.fleet_summary.search</field>
        <field name="model">fleet.traccar.summary</field>
        <field name="arch" type="xml">
            <search string="Fleet Summary">
                <field name="name" string="Vehicle" />
                <filter string="Date" name="start_time" date="start_time"/>
                <group expand="1" string="Group By">
                    <filter string="Vehicle" name="group_name"
                            context="{'group_by':'name'}"/>
                    <separator/>
                    <filter string="Date" name="start_time_grp" context="{'group_by': 'start_time'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fleet_summary_action" model="ir.actions.act_window">
        <field name="name">Fleet Summary</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.traccar.summary</field>
        <field name="view_mode">tree,search,form</field>
        <field name="context">{'search_default_group_name':1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No Summary currently
            </p>
        </field>
    </record>

    <menuitem id="menu_fleet_summary_action"
              name="Fleet Summary"
              parent="fleet.menu_fleet_reporting"
              action="fleet_summary_action"
              sequence="2"
              groups="fleet.fleet_group_manager"/>


</odoo>