<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="fleet_events_cron" forcecreate='True' model="ir.cron">
            <field name="name">Snyc Fleet Events</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_fleet_traccar_events"/>
            <field name="state">code</field>
            <field name="code">model.sync_events()</field>
        </record>

        <record id="fleet_trips_cron" forcecreate='True' model="ir.cron">
            <field name="name">Snyc Fleet Trips</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_fleet_traccar_trips"/>
            <field name="state">code</field>
            <field name="code">model.sync_trips()</field>
        </record>

        <record id="fleet_stops_cron" forcecreate='True' model="ir.cron">
            <field name="name">Snyc Fleet Stops</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_fleet_traccar_stops"/>
            <field name="state">code</field>
            <field name="code">model.sync_stops()</field>
        </record>

        <record id="fleet_events_summary" forcecreate='True' model="ir.cron">
            <field name="name">Snyc Fleet Summary</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_fleet_traccar_summary"/>
            <field name="state">code</field>
            <field name="code">model.sync_summary()</field>
        </record>

        <record id="fleet_vehicle_sync" forcecreate='True' model="ir.cron">
            <field name="name">Snyc Fleet Vehicles Data</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model.sync_devices()</field>
        </record>

        <record id="fleet_vehicle_import" forcecreate='True' model="ir.cron">
            <field name="name">Import Fleet Vehicles Data</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model.import_devices()</field>
        </record>

    </data>
</odoo>