<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="brand_traccar" model="fleet.vehicle.model.brand">
      	<field name="name">Traccar</field>
      	<field name="image_128" type="base64" file="fleet_traccar/static/img/traccar.png"/>
      </record>
      
      <record id="model_traccar" model="fleet.vehicle.model">
          <field name="name">Traccar</field>
          <field name="brand_id" ref="brand_traccar" />
          <field name="vehicle_type">car</field>
      </record>
</odoo>
