<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_nps_feedback" model="ir.cron">
            <field name="name">Send Feedback Email To Customer To Calculate NPS</field>

            <!-- The model to run -->
            <field name="model_id" ref="model_net_promoter_score"/>

            <!-- Method execution -->
            <field name="state">code</field>
            <field name="code">model.send_feedback_form_to_customers()</field>

            <!-- Run every 1 month -->
            <field name="interval_type">months</field>
            <field name="interval_number">1</field>

            <!-- Start running on the last day of the month -->
           <field name="nextcall">2026-06-2 09:00:00</field>


            <!-- Run forever -->
            <field name="numbercall">-1</field>

            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
