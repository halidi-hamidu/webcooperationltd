<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nps_tree" model="ir.ui.view">
        <field name="name">nps.tree</field>
        <field name="model">net.promoter.score</field>
        <field name="arch" type="xml">
            <list string="NPS Responses">
                <field name="name"/>
                <field name="email"/>
                <field name="score"/>
                <field name="voter_identification"/>
                <field name="is_submitted"/>
            </list>
        </field>
    </record>

    <record id="action_nps_list" model="ir.actions.act_window">
        <field name="name">List of NPS Voters</field>
        <field name="res_model">net.promoter.score</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
