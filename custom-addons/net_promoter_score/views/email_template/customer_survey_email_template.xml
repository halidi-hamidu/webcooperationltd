<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="email_template_customer_feedback" model="mail.template">
            <field name="name">Customer Feedback Template</field>
            <field name="email_from">service@ictpack.com</field>
            <field name="email_to">"{{ object.email }}"</field>
            <field name="subject">Quick Survey – We Appreciate Your Inputs !</field>
            <field name="body_html">
            <![CDATA[
                <p>
                    Dear <t t-out="object.name"/>,
                    <br/>
                </p>
                    <p>We appreciate your business! Please take a few minutes to provide feedback.</p>
                    <p><a href="http://nps.tunnel.ictpack.net/customer-feedback/form">Click here to complete the survey</a></p>
                    <p>Thank you!</p>
                ]]>
            </field>
            <field name="model_id" ref="base.model_res_partner" />
        </record>

    </data>
</odoo>