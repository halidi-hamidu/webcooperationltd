<odoo>
    <record id="action_nps_form" model="ir.actions.act_window">
        <field name="name">Submit Feedback</field>
        <field name="res_model">net.promoter.score</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_nps_list" model="ir.actions.act_window">
        <field name="name">List of Voters</field>
        <field name="res_model">net.promoter.score</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <!-- Server action to manually send NPS emails -->
    <record id="action_send_nps_email" model="ir.actions.server">
        <field name="name">Send NPS Feedback Email</field>
        <field name="model_id" ref="model_net_promoter_score"/>
        <field name="state">code</field>
        <field name="code">model.send_feedback_form_to_customers()</field>
    </record>
</odoo>
