<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--Account Move: View-->
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="narration" position="before">
                    <field name="amount_in_word"/>
                </field>
                <field name="payment_reference" position="before">
                    <field name="business_line"/>
                </field>
                <field name="ref" position="after">
                    <field name="po_no" attrs="{'invisible':[('move_type', '!=', 'out_invoice')]}"/>
                    <field name="po_date" attrs="{'invisible':[('move_type', '!=', 'out_invoice')]}"/>
                </field>
                <field name="journal_id" position="attributes">
                    <attribute name="attrs">{'readonly': [('name', '!=', '/')],'invisible':['|',('is_payment', '=', True),('is_petty', '=', True)]}</attribute>
                </field>
                <field name="company_id" position="before">
                    <field name="is_payment" invisible="1"/>
                    <field name="is_petty" invisible="1"/>
                    <field name="name" invisible="1"/>
                </field>
                <xpath expr="//form/sheet/div[2]/span/field[@name='move_type']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', '|',('move_type', '=', 'entry'), ('state', '=', 'draft'),('is_payment', '=', True),('is_petty', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//form/sheet/div[2]/span/field[@name='move_type']" position="after">
                    <field name="move_type" string="Payment Voucher" attrs="{'invisible': ['|', ('is_payment', '=', False), ('state', '=', 'draft')]}" readonly="1" nolabel="1"/>
                    <field name="move_type" string="Pettycash Voucher" attrs="{'invisible': ['|', ('is_petty', '=', False), ('state', '=', 'draft')]}" readonly="1" nolabel="1"/>
                </xpath>
                <xpath expr="//form/sheet/div[2]/h1[1]" position="replace">
                    <h1>
                                <span attrs="{'invisible': ['|', '|', ('move_type', '!=', 'out_invoice'), ('state', '!=', 'draft'), ('name', '!=', '/')]}">PROFORMA Invoice</span>
                                <span attrs="{'invisible': ['|', '|', ('move_type', '!=', 'out_refund'), ('state', '!=', 'draft'), ('name', '!=', '/')]}">Draft Credit Note</span>
                                <span attrs="{'invisible': ['|', '|', ('move_type', '!=', 'in_invoice'), ('state', '!=', 'draft'), ('name', '!=', '/')]}">Draft Bill</span>
                                <span attrs="{'invisible': ['|', '|', ('move_type', '!=', 'in_refund'), ('state', '!=', 'draft'), ('name', '!=', '/')]}">Draft Refund</span>
                                <span attrs="{'invisible': ['|', '|', ('move_type', '!=', 'out_receipt'), ('state', '!=', 'draft'), ('name', '!=', '/')]}">Draft Sales Receipt</span>
                                <span attrs="{'invisible': ['|', '|', '|',('move_type', '!=', 'in_receipt'), ('state', '!=', 'draft'), ('name', '!=', '/'), ('is_payment', '=', False)]}">Draft Payment Voucher</span>
                                <span attrs="{'invisible': ['|', '|', '|',('move_type', '!=', 'in_receipt'), ('state', '!=', 'draft'), ('name', '!=', '/'), ('is_petty', '=', False)]}">Draft Pettycash Voucher</span>
                    </h1>
                </xpath>
                <button name="button_draft" position="attributes">
                    <attribute name="groups">account.group_account_manager</attribute>
                </button>
            </field>
        </record>

        <record id="account.action_move_in_receipt_type" model="ir.actions.act_window">
            <field name="name">Payment Vouchers</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form,graph</field>
            <field name="domain">[('journal_id.type','=','payment'),('move_type', '=', 'in_receipt')]</field>
            <field name="context">{'default_move_type': 'in_receipt','default_is_payment':True}</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register a Payment Voucher
                </p>
                <p>
                    Payment vouchers are used to register liquidity movements. You can process those payment vouchers by
                    your own means or by using installed facilities.
                </p>
            </field>
        </record>

        <record id="action_account_petty_payable" model="ir.actions.act_window">
            <field name="name">Pettycash Vouchers</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form,graph</field>
            <field name="domain">[('journal_id.type','=','petty'),('move_type', '=', 'in_receipt')]</field>
            <field name="context">{'default_move_type': 'in_receipt','default_is_petty':True}</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click to register a Petty Cash Voucher.
                </p>
                <p>
                    When the Petty Cash Voucher is confirmed, you can record the
                    vendor payment related to this Petty Cash Voucher.
                </p>
            </field>
        </record>

        <menuitem
                id="menu_action_move_in_receipt_type"
                name="Payment Voucher"
                action="account.action_move_in_receipt_type"
                parent="account.menu_finance_payables"
                sequence="20"
        />

        <menuitem
                id="menu_action_account_petty_payable"
                name="Petty-cash Voucher"
                action="action_account_petty_payable"
                parent="account.menu_finance_payables"
                sequence="21"
        />
        
    </data>
</odoo>
