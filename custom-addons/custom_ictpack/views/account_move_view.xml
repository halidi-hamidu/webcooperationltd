<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--Account Move: View-->
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="partner_shipping_id" position="before">
                    <field name="po_no" readonly="state != 'draft'" />
                    <field name="po_date" readonly="state != 'draft'" />
                </field>
                <field name="narration" position="before">
                    <field name="amount_in_word"/>
                </field>
                <xpath expr="//field[@name='date']/following-sibling::field[@name='payment_reference']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Replace the payment_reference in the Other Info tab with our version that includes duplicate warning -->
                <xpath expr="//page[@name='other_info']//group[@name='sale_info_group']/field[@name='payment_reference']" position="replace">
                    <field name="payment_reference" invisible="move_type not in ('out_invoice', 'out_refund')" readonly="inalterable_hash" placeholder="Standard communication"/>
                    <field name="has_duplicate_payment_ref" invisible="1"/>
                    <div colspan="2" invisible="not has_duplicate_payment_ref">
                        <div class="alert alert-warning mb-2" role="alert">
                            <i class="fa fa-exclamation-triangle"/>
                            <strong> Warning:</strong> This payment reference has been used in other invoices.
                            <button name="action_show_payment_reference_warning"
                                    type="object"
                                    class="btn btn-link"
                                    style="padding: 0; margin-left: 5px;">
                                <i class="fa fa-external-link"/> View details
                            </button>
                        </div>
                    </div>
                </xpath>
                <field name="ref" position="after">
                    <field name="po_no" invisible="[('move_type', '!=', 'out_invoice')]"/>
                    <field name="po_date" invisible="[('move_type', '!=', 'out_invoice')]"/>
                </field>
                <field name="journal_id" position="attributes">
                    <attribute name="readonly">[('name', '!=', '/')]</attribute>
                    <attribute name="invisible">['|',('is_payment', '=', True),('is_petty', '=', True)]</attribute>
                </field>
                <field name="company_id" position="before">
                    <field name="is_payment" invisible="1"/>
                    <field name="is_petty" invisible="1"/>
                    <field name="name" invisible="1"/>
                </field>
                <xpath expr="//form/sheet/div[2]/span/field[@name='move_type']" position="attributes">
                    <attribute name="invisible">['|', '|', '|',('move_type', '=', 'entry'), ('state', '=', 'draft'),('is_payment', '=', True),('is_petty', '=', True)]</attribute>
                </xpath>
                <xpath expr="//form/sheet/div[2]/span/field[@name='move_type']" position="after">
                    <field name="move_type" string="Payment Voucher" invisible="['|', ('is_payment', '=', False), ('state', '=', 'draft')]" readonly="1" nolabel="1"/>
                    <field name="move_type" string="Pettycash Voucher" invisible="['|', ('is_petty', '=', False), ('state', '=', 'draft')]" readonly="1" nolabel="1"/>
                </xpath>
                <xpath expr="//form/sheet/div[2]/h1[1]" position="replace">
                    <h1>
                        <span invisible="['|', '|', ('move_type', '!=', 'out_invoice'), ('state', '!=', 'draft'), ('name', '!=', '/')]">PROFORMA Invoice</span>
                        <span invisible="['|', '|', ('move_type', '!=', 'out_refund'), ('state', '!=', 'draft'), ('name', '!=', '/')]">Draft Credit Note</span>
                        <span invisible="['|', '|', ('move_type', '!=', 'in_invoice'), ('state', '!=', 'draft'), ('name', '!=', '/')]">Draft Bill</span>
                        <span invisible="['|', '|', ('move_type', '!=', 'in_refund'), ('state', '!=', 'draft'), ('name', '!=', '/')]">Draft Refund</span>
                        <span invisible="['|', '|', ('move_type', '!=', 'out_receipt'), ('state', '!=', 'draft'), ('name', '!=', '/')]">Draft Sales Receipt</span>
                        <span invisible="['|', '|', '|',('move_type', '!=', 'in_receipt'), ('state', '!=', 'draft'), ('name', '!=', '/'), ('is_payment', '=', False)]">Draft Payment Voucher</span>
                        <span invisible="['|', '|', '|',('move_type', '!=', 'in_receipt'), ('state', '!=', 'draft'), ('name', '!=', '/'), ('is_petty', '=', False)]">Draft Pettycash Voucher</span>
                    </h1>
                </xpath>
                <button name="button_draft" position="attributes">
                    <attribute name="groups">account.group_account_manager</attribute>
                </button>

                <!-- Payment display fields for invoice printout -->
                <xpath expr="//page[@name='other_info']//group[@name='sale_info_group']" position="after">
                    <group string="Invoice Payment Display"
                           invisible="move_type != 'out_invoice'">
                        <field name="company_partner_id" invisible="1"/>
                        <field name="partner_till_alias" readonly="1"
                               invisible="not partner_till_alias"/>
                        <field name="invoice_bank_account_id"
                               domain="[('partner_id', '=', company_partner_id)]"
                               options="{'no_create': True, 'no_quick_create': True}"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="action_move_in_receipt_type" model="ir.actions.act_window">
            <field name="name">Payment Vouchers</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,graph</field>
            <field name="domain">[('journal_id.type','=','payment'),('move_type', '=', 'in_receipt')]</field>
            <field name="context">{'default_move_type': 'in_receipt','default_is_payment':True}</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register a Payment Voucher
                </p>
                <p>
                    Payment vouchers are used to register liquidity movements. You can process those payment vouchers by
                    your own means or by using installed facilities.
                </p>
            </field>
        </record>

        <record id="action_account_petty_payable" model="ir.actions.act_window">
            <field name="name">Pettycash Vouchers</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,graph</field>
            <field name="domain">[('journal_id.type','=','petty'),('move_type', '=', 'in_receipt')]</field>
            <field name="context">{'default_move_type': 'in_receipt','default_is_petty':True}</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click to register a Petty Cash Voucher.
                </p>
                <p>
                    When the Petty Cash Voucher is confirmed, you can record the
                    vendor payment related to this Petty Cash Voucher.
                </p>
            </field>
        </record>

        <menuitem
                id="menu_action_move_in_receipt_type"
                name="Payment Voucher"
                action="action_move_in_receipt_type"
                parent="account.menu_finance_payables"
                sequence="20"
        />

        <menuitem
                id="menu_action_account_petty_payable"
                name="Petty-cash Voucher"
                action="action_account_petty_payable"
                parent="account.menu_finance_payables"
                sequence="21"
        />

        <!-- Journal: CIPS/Selcom checkbox -->
        <record id="view_journal_form_cips" model="ir.ui.view">
            <field name="name">account.journal.form.cips</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="is_cips_journal"/>
                </field>
            </field>
        </record>
        
    </data>
</odoo>
