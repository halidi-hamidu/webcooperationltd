<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="contract_contract_form_view" model="ir.ui.view">
            <field name="name">contract.contract.form.view</field>
            <field name="model">contract.contract</field>
            <field name="inherit_id" ref="contract.contract_contract_form_view"/>
            <field name="arch" type="xml">
                <field name="tag_ids" position="after">
                    <field name="business_line" />
                </field>
            </field>
        </record>

        <record id="contract_contract_tree_view" model="ir.ui.view">
            <field name="name">contract.contract.tree.view</field>
            <field name="model">contract.contract</field>
            <field name="inherit_id" ref="contract.contract_contract_tree_view"/>
            <field name="arch" type="xml">
                    <field name="partner_id" position="after">
                        <field name="date_start" />
                        <field name="recurring_next_date" />
                    </field>
            </field>
        </record>

        <record id="contract_contract_search_view" model="ir.ui.view">
            <field name="name">contract.contract.search.view</field>
            <field name="model">contract.contract</field>
             <field name="inherit_id" ref="contract.contract_contract_search_view"/>
            <field name="arch" type="xml">
                    <field name="partner_id" position="after">
                        <field name="business_line" />
                    </field>
                    <filter name="inactive" position="after">
                        <filter string="IoT VTS" domain="[('business_line', '=', 'atras')]" name="atras" />
                        <filter string="IoT ECTS" domain="[('business_line', '=', 'ects')]" name="ects" />
                        <filter string="ITSM" domain="[('business_line', '=', 'itms')]" name="itms" />
                        <filter string="UIS" domain="[('business_line', '=', 'uis')]" name="uis" />
                        <filter string="AS" domain="[('business_line', '=', 'ictpack')]" name="ictpack" />
                    </filter>
            </field>
        </record>

    </data>
</odoo>