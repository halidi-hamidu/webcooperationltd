<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="web.external_layout_striped">
            <div t-attf-class="o_company_#{company.id}_layout header">
                <div class="o_background_header" style="min-height:10px !important;">
                    <div class="row" style="position:relative;">
                        <div class="col-3 text-start">
                            <img src="/custom_ictpack/static/description/ips_trademark.png" alt="IPS" style="width:85%"
                                 class="float-start"/>
                        </div>
                        <t t-if="o and o._name">
                        <div class="col-8 text-end" style="position: absolute;bottom: 0;right: 0;">
                            <div t-if="o._name == 'account.move'" class="mt16 text-primary">
                                <style>
                                    .report-title{
                                    font-size:38px !important;
                                    font-weight: bold;
                                    color:#2d74b5;
                                    }
                                </style>
                                <span t-if="o.move_type == 'out_invoice' and (o.state == 'posted' or o.state == 'authorize')">
                                    <h4 t-if="o.is_vfd_receipt_generated == False" class="report-title">INVOICE</h4>
                                    <h4 t-if="o.is_vfd_receipt_generated == True" class="report-title">TAX INVOICE</h4>
                                </span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">
                                    <h4 class="report-title">PROFORMA INVOICE</h4>
                                </span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                    <h4 class="report-title">CANCELED INVOICE</h4>
                                </span>
                                <span t-if="o.move_type == 'out_refund'">
                                    <h4 class="report-title">REFUND</h4>
                                </span>
                                <span t-if="o.move_type == 'in_refund'">
                                    <h4 class="report-title">VENDOR REFUND</h4>
                                </span>
                                <span t-if="o.move_type == 'in_invoice'">
                                    <h4 class="report-title">VENDOR BILL</h4>
                                </span>
                            </div>
                            <div t-if="o._name == 'purchase.order'" class="mt16 text-primary">
                                <style>
                                    .report-title-purchase{
                                    font-size:36px !important;
                                    font-weight: bold;
                                    color:#2d74b5;
                                    }
                                </style>
                                <span t-if="o.state in ['draft', 'sent', 'to approve']">
                                    <h4 class="report-title-purchase">REQUEST FOR QUOTATION</h4>
                                </span>
                                <span t-if="o.state in ['purchase', 'done']">
                                    <h4 class="report-title-purchase">PURCHASE ORDER</h4>
                                </span>
                                <span t-if="o.state == 'cancel'">
                                    <h4 class="report-title-purchase">CANCELLED PURCHASE ORDER</h4>
                                </span>
                            </div>
                        	<div t-if="o._name == 'sale.order'" class="mt16 text-primary">
                                <style>
                                    .report-title-purchase{
                                    font-size:36px !important;
                                    font-weight: bold;
                                    color:#2d74b5;
                                    }
                                </style>
                                <span t-if="env.context.get('proforma', False) or is_pro_forma">
                                    <h4 class="report-title-purchase">PROFORMA INVOICE</h4>
                                </span>
                                <span t-elif="o.state in ['draft','sent']">
                                    <h4 class="report-title-purchase">QUOTATION</h4>
                                </span>
                                <span t-else="">
                                    <h4 class="report-title-purchase">ORDER</h4>
                                </span>
                            </div>
                        </div>
                        </t>
                    </div>
                    <div class="clearfix mb8"/>
                </div>
            </div>

            <t t-set="layout_background_url" t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else ''"/>
            <div style="font-size:12px !important; margin-top:1px !important;padding-top:1px !important;"
                 t-attf-class="o_company_#{company.id}_layout article o_report_layout_striped  {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
                 t-attf-style="font-size:12px!important; {{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
                 t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-call="web.address_layout"/>
                <t t-out="0"/>
            </div>

            <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <div class="o_footer_content border-top pt-2 text-center">
                    <ul class="list-inline">
                        <li t-if="company.phone" class="list-inline-item">
                            <i class="fa fa-phone" role="img" aria-label="Phone" title="Phone"/>
                            <span class="o_force_ltr" t-field="company.phone"/>
                        </li>
                        <li t-if="company.email" class="list-inline-item">
                            <i class="fa fa-at" role="img" aria-label="Email" title="Email"/>
                            <span t-field="company.email"/>
                        </li>
                        <li t-if="company.website" class="list-inline-item">
                            <i class="fa fa-globe" role="img" aria-label="Website" title="Website"/>
                            <span t-field="company.website"/>
                        </li>
                        <li t-if="company.vat" class="list-inline-item">
                            <i class="fa fa-building-o" role="img" aria-label="Fiscal number"/>
                            <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                            <span t-field="company.vat"/>
                        </li>
                    </ul>
                    <div style="display:none" t-field="company.report_footer"/>
                    <div t-if="report_type == 'pdf'" class="text-muted">
                        Page:
                        <span class="page"/>
                        of
                        <span class="topage"/>
                    </div>
                </div>
            </div>
        </template>

    </data>
</odoo>