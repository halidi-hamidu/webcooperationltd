<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="purchase.report_purchaseorder_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <!--                <t t-set="address">-->
                <!--                    <div t-field="o.partner_id"-->
                <!--                         t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>-->
                <!--                </t>-->
                <t t-if="o.dest_address_id">
                    <t t-set="information_block">
                        <!--                        <strong>Shipping address:</strong>-->
                        <!--                        <div t-if="o.dest_address_id">-->
                        <!--                            <div t-field="o.dest_address_id"-->
                        <!--                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'-->
                        <!--                                 name="purchase_shipping_address"/>-->
                        <!--                        </div>-->

                    </t>
                </t>
                <div></div>

                <div class="page">
                    <div class="oe_structure"/>
                    <!-- Company and Document Info. -->
                    <style>
                        .table-head-bg{
                        background-color:#bcd5ed !important;
                        color:black !important;
                        }
                        .text-primary-alt{
                        color:#2d74b5 !important;
                        }
                    </style>
                    <div class="row">
                        <div class="col-12">
                            <table class="table table-sm o_main_table table-borderless" style="border:none !important">
                                <tbody>
                                    <tr>
                                        <td width="60%" style="border-top:none !important">
                                            <strong>
                                                <span class="text-primary-alt" t-field="o.company_id.name"/>
                                            </strong>
                                            <br/>
                                            <span t-field="o.company_id.street"/>
                                            <br/>
                                            <span t-field="o.company_id.street2"/>,<span t-field="o.company_id.city"/>,
                                            <span t-field="o.company_id.country_id"/>
                                            <br/>
                                            <span t-field="o.company_id.phone"/>
                                            <br/>
                                            <t t-if="o.company_id.vat">
                                                <strong>
                                                    <span class="text-primary-alt">TIN:</span>
                                                </strong>
                                                <span t-field="o.company_id.vat"/>
                                            </t>
                                            <!-- TODO: Add VRN in company model.-->
                                            <t t-if="o.company_id.vrn">
                                                <strong>
                                                    <span class="text-primary-alt">VRN:</span>
                                                </strong>
                                                <span t-field="o.company_id.vrn"/>
                                            </t>
                                        </td>
                                        <td width="40%" style="border-top:none !important">
                                            <div class="row">
                                                <div class="col-6">
                                                    <span>
                                                        <strong class="text-primary-alt">Order No:</strong>
                                                    </span>
                                                </div>
                                                <div class="col-6">
                                                    <span class="text-primary-alt" t-field="o.name"/>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-6">
                                                    <strong class="text-primary-alt">Order Date</strong>
                                                </div>
                                                <div class="col-6">
                                                    <p class="text-primary-alt" t-field="o.date_order"/>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-6">
                                                    <strong class="text-primary-alt">Due Date</strong>
                                                </div>
                                                <div class="col-6">
                                                    <p class="text-primary-alt" t-field="o.date_planned"/>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-6">
                                                    <strong class="text-primary-alt">Purchase Rep</strong>
                                                </div>
                                                <div class="col-6">
                                                    <p class="text-primary-alt" t-field="o.user_id"/>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-6">
                                                    <strong class="text-primary-alt">Order Currency</strong>
                                                </div>
                                                <div class="col-6">
                                                    <p class="text-primary-alt" t-field="o.currency_id"/>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <hr/>

                    <!-- Billing address -->
                    <div class="row">
                        <div class="col-12">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th width="60%" class="table-head-bg">
                                            <strong class="text-primary-alt">SUPPLIER:</strong>
                                        </th>
                                        <th width="40%" class="table-head-bg">
                                            <strong class="text-primary-alt">DELIVER TO:</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody style="border-top:0px !important">
                                    <tr>
                                        <td>
                                            <strong>
                                                <span class="text-primary-alt" t-field="o.partner_id.name"/>
                                            </strong>
                                            <br/>
                                            <span t-field="o.partner_id.street"/>
                                            <br/>
                                            <span t-field="o.partner_id.street2"/>,<span t-field="o.partner_id.city"/>,
                                            <span t-field="o.partner_id.country_id"/>
                                            <br/>
                                            <span t-field="o.partner_id.phone"/>
                                            <br/>
                                            <t t-if="o.partner_id.vat">
                                                <strong>
                                                    <span class="text-primary-alt">TIN:</span>
                                                </strong>
                                                <span t-field="o.partner_id.vat"/>
                                            </t>

                                            <t t-if="o.partner_id.vrn">
                                                <strong>
                                                    <span class="text-primary-alt">VRN:</span>
                                                </strong>
                                                <span t-field="o.partner_id.vrn"/>
                                            </t>
                                        </td>
                                        <td>
                                            <div class="row">
                                                <div class="col-12">
                                                    <strong>
                                                        <span class="text-primary-alt" t-field="o.company_id.name"/>
                                                    </strong>
                                                    <br/>
                                                    <span t-field="o.company_id.street"/>
                                                    <br/>
                                                    <span t-field="o.company_id.street2"/>,<span
                                                        t-field="o.company_id.city"/>,
                                                    <span t-field="o.company_id.country_id"/>
                                                    <br/>
                                                    <span t-field="o.company_id.phone"/>
                                                    <br/>

                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>
                    </div>
                    <hr size="10"/>

                    <!-- Supplier Information -->
                    <div class="row">
                        <div class="col-12">
                            <table class="table table-bordered o_main_table table-sm">
                                <thead>
                                    <tr>
                                        <th class="table-head-bg">
                                            <strong class="text-primary-alt">Supplier Reference</strong>
                                        </th>
                                        <th class="table-head-bg">
                                            <strong class="text-primary-alt">Payment Terms</strong>
                                        </th>
                                        <th class="table-head-bg">
                                            <strong class="text-primary-alt">Incoterms</strong>
                                        </th>
                                        <th class="table-head-bg">
                                            <strong class="text-primary-alt">Delivery Date</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody style="border-top:0px !important">

                                    <tr>
                                    	<td>
											<p t-field="o.partner_ref"/>
                                        </td>
                                        <td>
                                            <p t-field="o.payment_term_id"/>
                                        </td>
                                        <td>
                                            <p t-field="o.incoterm_id"/>
                                        </td>
                                        <td>
                                            <p t-field="o.date_planned"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <br/>

                    <!-- Display is set to none for it's invisibility -->
                    <div id="informations" class="row mt-4 mb32" style="display:none">
                        <div t-if="o.user_id" class="col-3 bm-2">
                            <strong>Purchase Representative:</strong>
                            <p t-field="o.user_id" class="m-0"/>
                        </div>
                        <div t-if="o.partner_ref" class="col-3 bm-2">
                            <strong>Your Order Reference:</strong>
                            <p t-field="o.partner_ref" class="m-0"/>
                        </div>
                        <div t-if="o.state in ['purchase','done'] and o.date_approve" class="col-3 bm-2">
                            <strong>Order Date:</strong>
                            <p t-field="o.date_approve" class="m-0"/>
                        </div>
                        <div t-elif="o.date_order" class="col-3 bm-2">
                            <strong>Order Deadline:</strong>
                            <p t-field="o.date_order" class="m-0"/>
                        </div>
                    </div>

                    <table class="table table-sm o_main_table mt-4">
                        <thead>
                            <tr>
                                <th class="table-head-bg" name="th_description">
                                    <strong>Description</strong>
                                </th>
                                <th class="table-head-bg" name="th_taxes">
                                    <strong>Taxes</strong>
                                </th>
                                <th name="th_date_req" class="text-center table-head-bg">
                                    <strong>Date Req.</strong>
                                </th>
                                <th name="th_quantity" class="text-end table-head-bg">
                                    <strong>Qty</strong>
                                </th>
                                <th name="th_price_unit" class="text-end table-head-bg">
                                    <strong>Unit Price</strong>
                                </th>
                                <th name="th_amount" class="text-end table-head-bg">
                                    <strong>Amount</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                                   groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                                   groups="account.group_show_line_subtotals_tax_included"/>

                                <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="not line.display_type">
                                        <td id="product">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td name="td_taxes">
                                            <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="line.date_planned"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.product_qty"/>
                                            <span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99" id="section">
                                            <span t-field="line.name"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99" id="note">
                                            <span t-field="line.name"/>
                                        </td>
                                    </t>
                                </tr>
                                <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-end">
                                        <td colspan="99" id="subtotal">
                                            <strong class="mr16 text-primary-alt">Subtotal</strong>
                                            <span
                                                    t-esc="current_subtotal"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div id="total" class="row justify-content-end">
                        <div class="col-4">
                            <table class="table table-sm">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="account.document_tax_totals"/>
                            </table>
                        </div>
                    </div>

                    <p t-field="o.notes" class="mt-4"/>
                    <div class="oe_structure"/>
                </div>
            </t>
        </template>

        <!--Request for Quotation Inherit-->
        <template id="purchase.report_purchasequotation_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="forced_vat"
                   t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
                <t t-set="address">
                    <div></div>
<!--                    <div t-field="o.partner_id" style="display:none"-->
<!--                         t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>-->
                </t>
                <t t-if="o.dest_address_id">
                    <t t-set="information_block">
                        <div></div>
<!--                        <strong style="display:none">Shipping address:</strong>-->
<!--                        <div style="display:none" t-field="o.dest_address_id"-->
<!--                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'-->
<!--                             name="purchase_shipping_address"/>-->
                    </t>
                </t>
                <!--Company and invoice Info Begins-->

                <div class="page">
                    <div class="oe_structure"/>
                    <style>
                        .table-head-bg{
                        background-color:#bcd5ed !important;
                        color:black !important;
                        }
                        .text-primary-alt{
                        color:#2d74b5 !important;
                        }
                    </style>

                    <div class="row">
                        <div class="col-12">
                            <table class="table table-sm o_main_table table-borderless" style="border:none !important">
                                <tbody>
                                    <tr>
                                        <td width="60%" style="border-top:none !important">
                                            <strong>
                                                <span class="text-primary-alt" t-field="o.company_id.name"/>
                                            </strong>
                                            <br/>
                                            <span t-field="o.company_id.street"/>
                                            <br/>
                                            <span t-field="o.company_id.street2"/>,<span t-field="o.company_id.city"/>,
                                            <span t-field="o.company_id.country_id"/>
                                            <br/>
                                            <span t-field="o.company_id.phone"/>
                                            <br/>
                                            <t t-if="o.company_id.vat">
                                                <strong>
                                                    <span class="text-primary-alt">TIN:</span>
                                                </strong>
                                                <span t-field="o.company_id.vat"/>
                                            </t>
                                            <!-- TODO: Add VRN in company model.-->
                                            <t t-if="o.company_id.vrn">
                                                <strong>
                                                    <span class="text-primary-alt">VRN:</span>
                                                </strong>
                                                <span t-field="o.company_id.vrn"/>
                                            </t>
                                        </td>
                                        <td width="40%" style="border-top:none !important">

                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <hr/>

                    <h2 style="display:none" class="mt-4">Request for Quotation
                        <span t-field="o.name"/>
                    </h2>

                    <table class="table table-sm mt-4">
                        <thead style="display: table-row-group">
                            <tr>
                                <th name="th_description" class="table-head-bg">
                                    <strong>Description</strong>
                                </th>
                                <th name="th_expected_date" class="text-center table-head-bg">
                                    <strong>Expected Date</strong>
                                </th>
                                <th name="th_quantity" class="text-end table-head-bg">
                                    <strong>Qty</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.order_line" t-as="order_line">
                                <tr t-att-class="'bg-200 fw-bold o_line_section' if order_line.display_type == 'line_section' else 'fst-italic o_line_note' if order_line.display_type == 'line_note' else ''">
                                    <t t-if="not order_line.display_type">
                                        <td id="product">
                                            <span t-field="order_line.name"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="order_line.date_planned"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="order_line.product_qty"/>
                                            <span t-field="order_line.product_uom" groups="uom.group_uom"/>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="99" id="section">
                                            <span t-field="order_line.name"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <p t-field="o.notes" class="mt-4"/>

                    <div class="oe_structure"/>
                </div>
            </t>
        </template>
    </data>
</odoo>