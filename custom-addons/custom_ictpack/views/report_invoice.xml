<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <template id="report_invoice_custom" inherit_id="account.report_invoice_document">
            <xpath expr="//t[@t-set='address']" position="replace"/>
            <xpath expr="//div[@class='row']" position="replace">
                <div class="row"></div>
            </xpath>
            <xpath expr=".//t/div[2]/div/h2" position="replace"/>
            <xpath expr="//div[@class='mt-5'][1]" position="attributes">
                <attribute name="class">'mt-1'</attribute>
            </xpath>
            <xpath expr=".//t/div[2]/div/div[@id='informations']" position="replace">
                <style>
                    .table-head-bg{
                    background-color:#bcd5ed !important;
                    color:black !important;
                    }
                    .text-primary-alt{
                    color:#2d74b5 !important;
                    }
                </style>
                <br/>
                <!--Company and invoice Info Begins-->
                <div class="row">
                    <div class="col-12">
                        <table class="table table-sm o_main_table table-borderless" style="border:none !important">
                            <tbody>
                                <tr>
                                    <td width="60%" style="border-top:none !important">
                                        <strong>
                                            <span class="text-primary-alt" t-field="o.company_id.name"/>
                                        </strong>
                                        <br/>
                                        <span t-field="o.company_id.street"/>
                                        <br/>
                                        <span t-field="o.company_id.street2"/>,<span t-field="o.company_id.city"/>,
                                        <span t-field="o.company_id.country_id"/>
                                        <br/>
                                        <span t-field="o.company_id.phone"/>
                                        <br/>
                                        <t t-if="o.company_id.vat">
                                            <strong>
                                                <span class="text-primary-alt">TIN:</span>
                                            </strong>
                                            <span t-field="o.company_id.vat"/>
                                        </t>
                                        <!-- TODO: Add VRN in company model.-->
	                                     <t t-if="o.company_id.vrn">
	                                          <strong>
	                                              <span class="text-primary-alt">VRN:</span>
	                                           </strong>
	                                           <span t-field="o.company_id.vrn"/>
	                                      </t>
                                    </td>
                                    <td width="40%" style="border-top:none !important">
                                        <div class="row">
                                            <div class="col-6">
                                                <span t-if="o.move_type == 'out_invoice' and (o.state == 'posted' or o.state == 'authorize')">
                                                    <strong class="text-primary-alt">Invoice No:</strong>
                                                </span>
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'proforma2'">
                                                    <strong class="text-primary-alt">PRO-FORMA</strong>
                                                </span>
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">
                                                    <strong class="text-primary-alt">Draft Invoice</strong>
                                                </span>
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                                    <strong class="text-primary-alt">Cancelled Invoice</strong>
                                                </span>
                                                <span t-if="o.move_type == 'out_refund'">
                                                    <strong class="text-primary-alt">Refund</strong>
                                                </span>
                                                <span t-if="o.move_type == 'in_refund'">
                                                    <strong class="text-primary-alt">Vendor
                                                        Refund
                                                    </strong>
                                                </span>
                                                <span t-if="o.move_type == 'in_invoice'">
                                                    <strong class="text-primary-alt">Vendor
                                                        Bill
                                                    </strong>
                                                </span>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-primary-alt" t-field="o.name"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong class="text-primary-alt">Invoice Date</strong>
                                            </div>
                                            <div class="col-6">
                                                <p class="text-primary-alt" t-field="o.invoice_date"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong class="text-primary-alt">Due Date</strong>
                                            </div>
                                            <div class="col-6">
                                                <p class="text-primary-alt" t-field="o.invoice_date_due"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong class="text-primary-alt">Sales Rep</strong>
                                            </div>
                                            <div class="col-6">
                                                <p class="text-primary-alt" t-field="o.user_id"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong class="text-primary-alt">Invoice Currency</strong>
                                            </div>
                                            <div class="col-6">
                                                <p class="text-primary-alt" t-field="o.currency_id"/>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <hr/>
<!--                Billing Address-->
                <div class="row">
                    <div class="col-12">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th width="60%" class="table-head-bg">
                                        <strong class="text-primary-alt">BILL TO:</strong>
                                    </th>
                                    <th width="40%" class="table-head-bg">
                                        <strong class="text-primary-alt">DELIVER TO:</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="border-top:0px !important">
                                <tr>
                                    <td>
                                        <strong>
                                            <span class="text-primary-alt" t-field="o.partner_id.name"/>
                                        </strong>
                                        <br/>
                                        <span t-field="o.partner_id.street"/>
                                        <br/>
                                        <span t-field="o.partner_id.street2"/>,<span t-field="o.partner_id.city"/>,
                                        <span t-field="o.partner_id.country_id"/>
                                        <br/>
                                        <span t-field="o.partner_id.phone"/>
                                        <br/>
                                        <t t-if="o.partner_id.vat">
                                            <strong>
                                                <span class="text-primary-alt">TIN:</span>
                                            </strong>
                                            <span t-field="o.partner_id.vat"/>
                                        </t>

                                      <t t-if="o.partner_id.vrn">
                                           <strong>
                                                <span class="text-primary-alt">VRN:</span>
                                           </strong>
                                           <span t-field="o.partner_id.vrn"/>
                                      </t>
                                    </td>
                                    <td>
                                        <div class="row">
                                            <div class="col-12">
                                                <strong>
                                                    <span class="text-primary-alt" t-field="o.partner_id.name"/>
                                                </strong>
                                                <br/>
                                                <span t-field="o.partner_id.street"/>
                                                <br/>
                                                <span t-field="o.partner_id.street2"/>,<span
                                                    t-field="o.partner_id.city"/>,
                                                <span t-field="o.partner_id.country_id"/>
                                                <br/>
                                                <span t-field="o.partner_id.phone"/>
                                                <br/>

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </div>
                <hr size="10"/>
                <br/>
<!--                Purchase Order Information-->
                <div class="row">
                    <div class="col-12">
                        <table class="table table-bordered o_main_table table-sm">
                            <thead>
                                <tr>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">PO/Contract Reference</strong>
                                    </th>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">PO/Contract Date Date</strong>
                                    </th>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">Payment Terms</strong>
                                    </th>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">Project Status/Delivery</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="border-top:0px !important">

                                <tr>
                                    <td>
                                       <p t-field="o.po_no"/>
                                    </td>
                                    <td>
                                        <p t-field="o.po_date"/>
                                    </td>
                                    <td>
                                        <p t-field="o.invoice_payment_term_id"/>
                                    </td>
                                    <td>

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <br/>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']" position="replace">
                <!--Items Table Begins-->
                <table class="table table-sm table-bordered o_main_table" name="invoice_line_table">
                    <thead>
                        <tr>
                            <!-- TODO: remove in master -->
                            <th class="table-head-bg">S/N</th>
                            <t t-set="colspan" t-value="6"/>
                            <th name="th_description" class="text-left table-head-bg">
                                <span>Description</span>
                            </th>
                            <!-- TODO: remove in master -->
                            <th name="th_source" class="d-none text-left table-head-bg" t-if="0">
                                <span>Source Document</span>
                            </th>
                            <th name="th_quantity" class="text-right table-head-bg">
                                <span>Qty</span>
                            </th>
                            <th name="th_priceunit"
                                t-attf-class="table-head-bg text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Unit Price</span>
                            </th>
                            <th name="th_price_unit" t-if="display_discount"
                                t-attf-class="table-head-bg text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Disc.%</span>
                                <!-- TODO: remove in master -->
                                <t t-set="colspan" t-value="colspan+1"/>
                            </th>
                            <th name="th_taxes"
                                t-attf-class="table-head-bg text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>18% VAT</span>
                            </th>
                            <th name="th_subtotal" class="text-right table-head-bg">
                                <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="lines"
                           t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                        <t t-foreach="lines" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                               groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                               groups="account.group_show_line_subtotals_tax_included"/>
                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                    <td>
                                        <span t-esc="line_index+1"/>
                                    </td>
                                    <td name="account_invoice_line_name">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                        <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                    </td>
                                    <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span class="text-nowrap" t-field="line.price_unit"/>
                                    </td>
                                    <td t-if="display_discount"
                                        t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span class="text-nowrap" t-field="line.discount"/>
                                    </td>
                                    <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"
                                              id="line_tax_ids"/>
                                    </td>
                                    <td class="text-end o_price_total">
                                        <span class="text-nowrap" t-field="line.price_subtotal"
                                              groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <span class="text-nowrap" t-field="line.price_total"
                                              groups="account.group_show_line_subtotals_tax_included"/>
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>
                            </tr>
                            <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                                t-esc="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

            </xpath>

            <!--Items Table Ends-->

            <xpath expr="//div[@class='clearfix mb-4'][1]" position="replace">
                <div id="total" class="row">
                    <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ms-auto">
                        <table class="table table-bordered table-sm;page-break-inside: avoid;">
                            <tr class="border-black o_subtotal" style="">
                                <td>
                                    <strong class="text-primary-alt">Tax Base Total</strong>
                                </td>
                                <td class="text-right">
                                    <span t-field="o.amount_untaxed"/>
                                </td>
                            </tr>
                        	<tr>
                            <td>
                                    <strong class="text-primary-alt">Tax</strong>
                                </td>
                                <td class="text-right">
                                    <span t-field="o.amount_tax"/>
                                </td>
                        </tr>
                            <!--                            <t t-foreach="o.amount_by_group" t-as="amount_by_group">-->
                            <!--                                <tr style="">-->
                            <!--                                    <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) == 1 and o.amount_untaxed == amount_by_group[2]">-->
                            <!--                                        <td>-->
                            <!--                                            <span t-esc="amount_by_group[0]"/>-->
                            <!--                                        </td>-->
                            <!--                                        <td class="text-right o_price_total">-->
                            <!--                                            <span t-esc="amount_by_group[3]"/>-->
                            <!--                                        </td>-->
                            <!--                                    </t>-->
                            <!--                                    <t t-else="">-->
                            <!--                                        <td>-->
                            <!--                                            <span t-esc="amount_by_group[0]"/>-->
                            <!--                                            <span>&amp;nbsp;-->
                            <!--                                                <span>on</span>-->
                            <!--                                                <t t-esc="amount_by_group[4]"/>-->
                            <!--                                            </span>-->
                            <!--                                        </td>-->
                            <!--                                        <td class="text-right o_price_total">-->
                            <!--                                            <span t-esc="amount_by_group[3]"/>-->
                            <!--                                        </td>-->
                            <!--                                    </t>-->
                            <!--                                </tr>-->
                            <!--                            </t>-->
                            <tr class="border-black o_total">
                                <td>
                                    <strong class="text-primary-alt">Grand Total</strong>
                                </td>
                                <td class="text-right">
                                    <span t-field="o.amount_total"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 mt8">
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">AMOUNT IN WORDS:</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="border-top:0px !important">
                                <tr>
                                    <td>
                                        <span t-field="o.amount_in_word"/>                                   
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <br/>
                <div class="row">
                    <div class="col-12">
                        <table class="table table-bordered table-sm">
                            <tbody>
                                <tr>
                                    <td class="60%">
                                         <t t-if="o.business_line == 'ictpack' or o.business_line == 'uis' or o.business_line =='itms'">
                                            <strong>BANK DETAILS:</strong>
                                            <br/>
                                            <span>Account Number(TZS):
                                                <strong>
                                                    <span class="text-primary-alt">0150259120400</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>Account Number(USD):
                                                <strong>
                                                    <span class="text-primary-alt">0250259120400</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>Account Name:
                                                <strong>
                                                    <span class="text-primary-alt">ICTPACK SOLUTIONS LIMITED</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>Bank Name:
                                                <strong>
                                                    <span class="text-primary-alt">CRDB BANK PLC</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>SWIFTCODE:
                                                <strong>
                                                    <span class="text-primary-alt">CORUTZTZ</span>
                                                </strong>
                                            </span>
                                            <br/>
                                        </t>
                                        <t t-if="o.business_line == 'atras' or o.business_line == 'ects'">
                                            <strong>PAYMENT DETAILS:</strong>
                                            <br/>
                                            <span>
                                                <strong>
                                                    <span class="text-primary-alt">CRDB BANK PLC</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>Bank Name:
                                                <strong>
                                                    <span class="text-primary-alt">CRDB BANK PLC</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>Account Number(TZS):
                                                <strong>
                                                    <span class="text-primary-alt">0150259120402</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>Account Name:
                                                <strong>
                                                    <span class="text-primary-alt">ICTPACK SOLUTIONS LIMITED</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <br/>
                                            <span>
                                                <strong>TIGOPESA ACCOUNT - Namna ya kulipa kwa TIGOPESA</strong>
                                            </span>
                                            <br/>
                                            <span>Hatua ya 1. Bonyeza <strong>*150*01#</strong> kisha Chagua
                                                Namba 4:
                                                <strong>LIPIA BILI</strong>
                                            </span>
                                            <br/>
                                            <span>Hatua ya 2. Chagua Namba 3:
                                                <strong>INGIZA NAMBA YA KAMPUNI</strong>
                                            </span>
                                            <br/>
                                            <span>Hatua ya 3. Ingiza namba ya kampuni:
                                                <strong>
                                                    <span class="text-primary-alt">477477</span>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>Hatua ya 4. Ingiza kumbukumbu Namba:
                                                <strong>
                                                    <span t-field="o.inv_reference"/>
                                                </strong>
                                            </span>
                                            <br/>
                                            <span>Hatua ya 5. Ingiza kiasi unacholipia:
                                                <strong>
                                                    <span t-field="o.amount_total"/>
                                                </strong>
                                                Kisha ngiza namba yako ya siri: <strong>****</strong> kukamilisha
                                                muamala
                                            </span>
                                        </t>
                                    </td>
                                    <td width="40%" class="table-head-bg">                                  
                                        <div t-if="o.vfd_receipt_ids" class="row align-items-center">
                                            <div class="col-6 align-self-center text-right pt-4">
                                                <br/>
                                                <strong class="text-primary-alt">Scan to Verify</strong>
                                                <br/>
                                                Tax Verification Code:
                                                <br/>
                                                <strong class="text-primary-alt">
                                                    <span t-field="o.vfd_receipt_ids.verification_code"/>
                                                </strong>
                                            </div>
                                            <div class="col-6">
                                                <img class="mt-2"
                                                     t-att-src="'/report/barcode/QR/'+str(o.vfd_receipt_ids.receipt_url)"
                                                     style="height:120px; width:120px;" alt="QR Code"/>
                                            </div>
                                        </div>
                                        <div t-if="o.vfd_receipt_ids" class="row">
                                            <div class="col-12 mt8 text-center">
                                                <span t-esc="str(o.vfd_receipt_ids.receipt_url)"/>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </xpath>
            <xpath expr="//p[@class='mt-4'][1]" position="replace"/>
