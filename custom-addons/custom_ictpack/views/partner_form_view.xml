<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--Partner: Outstanding Payments smart button-->
        <record id="partner_form_outstanding_payments_btn" model="ir.ui.view">
            <field name="name">partner.form_outstanding_payments_btn</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button
                        name="action_view_outstanding_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="outstanding_payment_count == 0"
                        groups="account.group_account_user"
                    >
                        <field name="outstanding_payment_count" widget="statinfo"
                               string="Outstanding&#10;Payments"/>
                    </button>
                </div>
            </field>
        </record>

        <!--Partner: VRN field after VAT-->
        <record id="partner_form_vrn_field" model="ir.ui.view">
            <field name="name">partner.form_vrn_field</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="vat" position="after">
                    <field name="vrn"/>
                </field>
            </field>
        </record>

        <!--Partner: Selcom Till Alias field and button-->
        <record id="partner_form_till_alias" model="ir.ui.view">
            <field name="name">partner.form_till_alias</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="vrn" position="after">
                    <field name="till_alias" string="Lipa Namba"/>
                    <button
                        name="action_create_till_alias"
                        string="Create Till Alias"
                        type="object"
                        class="oe_highlight"
                        invisible="till_alias_synced == True"
                    />
                </field>
            </field>
        </record>
    </data>
</odoo>
