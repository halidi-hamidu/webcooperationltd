<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="vts_reported_problem_form_view" model="ir.ui.view">
            <field name="name">vts_reported_problem.form</field>
            <field name="model">vts.reported.problems</field>
            <field name="arch" type="xml">
                <form string="VTS Reported Problem">
                    <sheet>
                        <group>
                            <field name="value"/>
                            <field name="key"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="vts_reported_problem_tree_view" model="ir.ui.view">
            <field name="name">vts.reported.problem.tree</field>
            <field name="model">vts.reported.problems</field>
            <field name="arch" type="xml">
                <list string="VTS Reported Problem">
                    <field name="value"/>
                    <field name="key"/>
                </list>
            </field>
        </record>

        <record id="vts_reported_problem_act_window" model="ir.actions.act_window">
            <field name="name">VTS Reported Problem</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.reported.problems</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Reported Problems found.
                </p>
            </field>
        </record>

        <menuitem name="Reported Problems" id="vts_reported_problem_menu" parent="vts_config_menu" action="vts_reported_problem_act_window"/>

    </data>
</odoo>