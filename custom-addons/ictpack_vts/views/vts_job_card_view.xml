<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ects_trip_form_view" model="ir.ui.view">
            <field name="name">vts.job.card.form</field>
            <field name="model">vts.job.card</field>
            <field name="arch" type="xml">
                <form string="Job Card">
                    <header>
                        <button name="action_create_project_from_job_card" type="object" string="Create Project" invisible="project_id or state != 'approved' or service_type != 'installation'" class="oe_highlight"></button>
                        <button name="action_create_ticket_wizard" type="object" string="Create Ticket" invisible="ticket_id or state != 'approved' or service_type != 'service-routine'" class="oe_highlight"/>
                        <button name="action_create_sale_order" type="object" string="Create Sale Order" invisible="sale_order_id or state != 'approved'" class="oe_highlight"/>
                        <button string="Reviewed" name="action_reviewed" type="object" class="oe_highlight" invisible="state != 'submitted'" />
                        <button string="Approved" name="action_approved" type="object" class="oe_highlight" invisible="state in ['draft', 'submitted', 'approved', 'rejected']" />
                        <button string="Rejected" name="action_rejected" type="object" class="oe_highlight" invisible="state in ['draft', 'submitted', 'approved', 'rejected']"/>
                        <field name="state" widget="statusbar" options="{'fold_field': 'fold'}"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'" />
                        <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'" />
                        <field name="customer_signature" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Job Card Number"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id"/>
                                <field name="customer_mobile" />
                                <field name="customer_phone" />
                                <field name="customer_address" />
                                <field name="business_name" />
                                <field name="name_of_signatory" />
                                <field name="service_type" />
                                <field name="create_date" string="Service Date" />
                                <field name="vts_employee" />
                                <field name="project_id" />
                                <field name="task_id" invisible="not task_id"/>
                                <field name="ticket_id" invisible="not ticket_id"/>
                                <field name="sale_order_id" invisible="not sale_order_id"/>
                            </group>
                            <group>
                                <field name="driver_name" />
                                <field name="driver_mobile" />
                                <field name="driver_license" />
                                <field name="license_plate" />
                                <field name="vehicle_model" />
                                <field name="vehicle_make" />
                                <field name="location" />
                            </group>
                        </group>
                        <notebook>
                            <page name="installation" string="Installation">
                                <group>
                                    <field name="serial_number" />
                                    <field name="imei" />
                                    <field name="sim_card" />
                                    <field name="tag_id" />
                                </group>
                            </page>
                            <page name="service" string="Service">
                                <group>
                                    <group name="reported_problems" string="Reported Problems">
                                        <field name="reported_problems_display" nolabel="1" colspan="2" >
                                            <!-- <tree editable="bottom">
                                                <field name="value" />
                                            </tree> -->
                                        </field>
                                    </group>
                                    <group name="seen_problem" string="Problem Seen">
                                        <field name="problems_seen_display" nolabel="1" colspan="2" >
                                        </field>
                                    </group>
                                </group>
                                <group name="taken_action" string="Action Taken">
                                    <field name="actions_taken_display" nolabel="1" colspan="2" />
                                </group>
                            </page>
                            <page name="veihicle_inspection" string="Vehicle  Inspection">
                                <field name="inspection_html_table" />
                            </page>
                            <page name="remarks" string="Remarks">
                                <field name="general_remarks" nolabel="1" colspan="2" />
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" options="{'post_refresh':True}" help="Follow this project to automatically track the events associated to tasks and issues of this project."/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="vts_job_card_tree_view" model="ir.ui.view">
            <field name="name">vts.job.card.tree</field>
            <field name="model">vts.job.card</field>
            <field name="arch" type="xml">
                <list string="VTS Job Cards" create="false" edit="false">
                    <field name="name" />
                    <field name="vts_employee" />
                    <field name="customer_id" />
                    <field name="license_plate" />
                    <field name="reported_problems_text" />
                    <field name="ownership_type" />
                    <field name="create_date" string="Service Date" />

                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_vts_job_card_search" model="ir.ui.view">
            <field name="name">vts.job.card.search</field>
            <field name="model">vts.job.card</field>
            <field name="arch" type="xml">
                <search string="VTS Job Cards">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="vts_employee"/>
                    <filter name="new_installation" string="New Installation" domain="[('service_type', '=', 'installation')]"/>
                    <filter name="service_routine" string="Service Routine" domain="[('service_type', '=', 'service-routine')]"/>
                    <filter name="driver_registration" string="Driver Registration" domain="[('service_type', '=', 'driver-registration')]"/>
                    <separator/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                    <filter name="reviewed" string="Reviewed" domain="[('state', '=', 'reviewed')]"/>
                    <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                    <group>
                        <filter string="Employee" name="employee_id" context="{'group_by':'vts_employee'}"/>
                        <filter string="Status" name="status" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="vts_job_card_act_window" model="ir.actions.act_window">
            <field name="name">VTS Job Cards</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.job.card</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_example_field":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Records Found.
                </p>
            </field>
        </record>

        <record id="vts_new_installation_job_card_act_window" model="ir.actions.act_window">
            <field name="name">VTS New Installation Job Cards</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.job.card</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_new_installation":1, "search_default_submitted":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Records Found.
                </p>
            </field>
        </record>

        <record id="vts_service_routine_job_card_act_window" model="ir.actions.act_window">
            <field name="name">VTS Service Routine Job Cards</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.job.card</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_service_routine":1, "search_default_submitted":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Records Found.
                </p>
            </field>
        </record>

        <record id="vts_driver_registration_job_card_act_window" model="ir.actions.act_window">
            <field name="name">VTS Driver Registration Job Cards</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.job.card</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_driver_registration":1, "search_default_submitted":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Records Found.
                </p>
            </field>
        </record>

        <menuitem id="vts_root_menu" name="VTS" web_icon="ictpack_vts,static/description/icon.png"/>
        <menuitem name="Job Cards" sequence="2" id="vts_job_card_menu" parent="vts_root_menu" action="vts_job_card_act_window"/>
        <menuitem name="New Installations" sequence="2" id="vts_new_installation_job_card_menu" parent="vts_job_card_menu" action="vts_new_installation_job_card_act_window"/>
        <menuitem name="Service Routine" sequence="3" id="vts_service_routine_job_card_menu" parent="vts_job_card_menu" action="vts_service_routine_job_card_act_window"/>
        <menuitem name="Driver Registration" sequence="4" id="vts_driver_registration_job_card_menu" parent="vts_job_card_menu" action="vts_driver_registration_job_card_act_window"/>
        <menuitem name="Configuration" id="vts_config_menu" parent="vts_root_menu"/>
    </data>
</odoo>