<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="vts_checklist_config_form_view" model="ir.ui.view">
            <field name="name">vts.checklist.config.form</field>
            <field name="model">vts.checklist.config</field>
            <field name="arch" type="xml">
                <form string="VTS Checklist Config">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="type"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="vts_checklist_config_tree_view" model="ir.ui.view">
            <field name="name">vts.checklist.config.tree</field>
            <field name="model">vts.checklist.config</field>
            <field name="arch" type="xml">
                <list string="VTS Checklist Config">
                    <field name="name"/>
                    <field name="key"/>
                    <field name="type"/>
                </list>
            </field>
        </record>

        <record id="vts_checklist_config_act_window" model="ir.actions.act_window">
            <field name="name">VTS Checklist Config</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.checklist.config</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Checklist Config found.
                </p>
            </field>
        </record>

        <!-- create a serach view with filters -->
        <record id="vts_checklist_config_search_view" model="ir.ui.view">
            <field name="name">vts.checklist.config.search</field>
            <field name="model">vts.checklist.config</field>
            <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="key" string="Key"/>
                <field name="type" string="Type"/>
                <separator />
                <filter string="Action Taken" name="vts_action_taken_filter" domain="[('type','=','action-taken')]"/>
                <filter string="Problem Seen" name="vts_problems_seen_filter" domain="[('type','=','problem-seen')]"/>
                <filter string="Reported problems" name="vts_reported_problems_filter" domain="[('type','=','reported-problem')]"/>
            </search>
            </field>
        </record>

        <record id="vts_action_taken_act_window" model="ir.actions.act_window">
            <field name="name">Action Taken</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.checklist.config</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_vts_action_taken_filter":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Config Found.
                </p>
            </field>
        </record>

        <record id="vts_reported_problems_act_window" model="ir.actions.act_window">
            <field name="name">Action Taken</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.checklist.config</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_vts_reported_problems_filter":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Config Found.
                </p>
            </field>
        </record>

        <record id="vts_problems_seen_act_window" model="ir.actions.act_window">
            <field name="name">Action Taken</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.checklist.config</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_vts_problems_seen_filter":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Config Found.
                </p>
            </field>
        </record>
        <menuitem name="Action Taken" id="vts_action_taken_config_menu" parent="vts_config_menu" action="vts_action_taken_act_window"/>
        <menuitem name="Reported Problems" id="vts_reported_problems_config_menu" parent="vts_config_menu" action="vts_reported_problems_act_window"/>
        <menuitem name="Problems Seen" id="vts_problems_seen_config_menu" parent="vts_config_menu" action="vts_problems_seen_act_window"/>

    </data>
</odoo>