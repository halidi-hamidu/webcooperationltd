<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_task_vts_inhert" model="ir.ui.view">
            <field name="name">project.task.form.vts</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <!-- <xpath expr="//button[@name='action_assign_to_me']" position="after">
                    <header invisible="project_business_line != 'atras' or vts_job_card">
                        <button class="d-none" name="action_create_job_card_from_task" type="object" string="Create JobCard"></button>
                    </header>
                </xpath> -->
                <xpath expr="header" position="after">
                    <header invisible="project_business_line != 'atras'">
                        <field name="vts_state" widget="statusbar"/>
                        <field name="project_business_line" invisible="1" />
                    </header>
                </xpath>
                <xpath expr="//field[@class='o_task_user_field']" position="after">
                    <field name="vts_employee" />
                </xpath>
                <xpath expr="//page[@name='extra_info']" position="after">
                    <page name="vts_details" string="VTS Details">
                        <field name="vts_job_card" />
                    </page>
                </xpath>

            </field>
        </record>

        <record id="view_edit_project_vts_inhert" model="ir.ui.view">
            <field name="name">project.project.form.vts</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" name="open_job_cards" icon="fa-file-text-o" invisible="not job_card_count">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="job_card_count" nolabel="1"/>
                            </span>
                            <span class="o_stat_text">
                                Job Cards
                            </span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>