<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="vts_daily_checkup_list_form_view" model="ir.ui.view">
            <field name="name">vts.checkup.list.form</field>
            <field name="model">vts.daily.checkup.list</field>
            <field name="arch" type="xml">
                <form string="Daily Checklist" create="false" edit="false" delete="false">
                    <header>
                        <field name="state" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}" can_create="true" can_write="true"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Checklist Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="created_date_time"/>
                                <field name="employee_id" />
                                <field name="location"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="projects" string="Projects">
                                    <field name="projects_ids" no_label="1">
                                        <list>
                                            <field name="display_name"/>
                                            <field name="computed_inspection_status" string="Status" />
                                            <field name="computed_inspection_remarks" string="Remarks" />
                                        </list>
                                    </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" options="{'post_refresh':True}" help="Follow this project to automatically track the events associated to tasks and issues of this project."/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="vts_daily_checkup_list_tree_view" model="ir.ui.view">
            <field name="name">vts.daily.checkup.list.tree</field>
            <field name="model">vts.daily.checkup.list</field>
            <field name="arch" type="xml">
                <list string="VTS Job Cards" create="false" edit="false">
                    <field name="name" />
                    <field name="created_date_time" />
                    <field name="employee_id" />
                    <field name="location" />

                </list>
            </field>
        </record>

        <record id="vts_daily_check_up_list_act_window" model="ir.actions.act_window">
            <field name="name">VTS Daily Checkup List</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.daily.checkup.list</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_example_field":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Record Found.
                </p>
            </field>
        </record>

        <menuitem name="Daily Checkup List" sequence="3" id="vts_daily_checkup_list_menu" parent="vts_root_menu" action="vts_daily_check_up_list_act_window"/>
    </data>
</odoo>