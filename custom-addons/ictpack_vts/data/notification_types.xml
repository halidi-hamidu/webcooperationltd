<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Job Card Notifications -->
        <record id="notif_job_card_submitted" model="vts.notification.type">
            <field name="key">job_card_submitted</field>
            <field name="name">Job Card Submitted</field>
        </record>

        <record id="notif_job_card_approved" model="vts.notification.type">
            <field name="key">job_card_approved</field>
            <field name="name">Job Card Approved</field>
        </record>

        <record id="notif_job_card_rejected" model="vts.notification.type">
            <field name="key">job_card_rejected</field>
            <field name="name">Job Card Rejected</field>
        </record>

        <record id="notif_job_card_reviewed" model="vts.notification.type">
            <field name="key">job_card_reviewed</field>
            <field name="name">Job Card Reviewed</field>
        </record>

        <record id="notif_job_card_done" model="vts.notification.type">
            <field name="key">job_card_done</field>
            <field name="name">Job Card Done (LATRA)</field>
        </record>

        <!-- Customer Feedback Notifications -->
        <record id="notif_feedback_submitted" model="vts.notification.type">
            <field name="key">feedback_submitted</field>
            <field name="name">Customer Feedback Submitted</field>
        </record>

    </data>
</odoo>
