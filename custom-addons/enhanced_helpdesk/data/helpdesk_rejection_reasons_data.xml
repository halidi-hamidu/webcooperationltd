<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <data>
        <!-- Default Rejection Reasons -->
        <record id="rejection_reason_workload" model="helpdesk.rejection.reason">
            <field name="name">Too busy with current workload</field>
            <field name="description">I have too many tasks and cannot take on additional responsibilities at this time.</field>
            <field name="sequence">10</field>
        </record>

        <record id="rejection_reason_expertise" model="helpdesk.rejection.reason">
            <field name="name">Lack of expertise in this area</field>
            <field name="description">I don't have the necessary skills or knowledge to handle this type of ticket effectively.</field>
            <field name="sequence">20</field>
        </record>

        <record id="rejection_reason_unavailable" model="helpdesk.rejection.reason">
            <field name="name">Currently unavailable</field>
            <field name="description">I am currently on leave, out of office, or otherwise unavailable to handle this request.</field>
            <field name="sequence">30</field>
        </record>

        <record id="rejection_reason_wrong_assignment" model="helpdesk.rejection.reason">
            <field name="name">Wrong person for this task</field>
            <field name="description">This ticket should be assigned to someone else who is better suited for this type of work.</field>
            <field name="sequence">40</field>
        </record>

        <record id="rejection_reason_conflicting_priorities" model="helpdesk.rejection.reason">
            <field name="name">Conflicting priorities</field>
            <field name="description">I have other high-priority tasks that conflict with handling this ticket at this time.</field>
            <field name="sequence">50</field>
        </record>

        <record id="rejection_reason_resources" model="helpdesk.rejection.reason">
            <field name="name">Insufficient resources</field>
            <field name="description">I don't have access to the necessary tools, systems, or resources needed to handle this ticket.</field>
            <field name="sequence">60</field>
        </record>
    </data>
</odoo>