<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_check_sla_status" model="ir.cron">
        <field name="name">Check SLA Status Updates</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
model._check_sla_status_updates()
        ]]></field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_check_sla_breaches" model="ir.cron">
        <field name="name">Check SLA Breaches</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
model._check_sla_breaches()
        ]]></field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
