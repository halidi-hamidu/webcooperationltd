<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Hold Reasons -->
        <record id="hold_reason_waiting_customer" model="helpdesk.hold.reason">
            <field name="name">Waiting for Customer Response</field>
            <field name="sequence">10</field>
            <field name="description">The assignment is on hold pending customer feedback or response</field>
        </record>
        
        <record id="hold_reason_insufficient_info" model="helpdesk.hold.reason">
            <field name="name">Insufficient Information</field>
            <field name="sequence">20</field>
            <field name="description">Need more details or information to proceed with the assignment</field>
        </record>
        
        <record id="hold_reason_external_dependency" model="helpdesk.hold.reason">
            <field name="name">External Dependency</field>
            <field name="sequence">30</field>
            <field name="description">Waiting for external systems, vendors, or third-party responses</field>
        </record>
        
        <record id="hold_reason_resource_unavailable" model="helpdesk.hold.reason">
            <field name="name">Required Resources Unavailable</field>
            <field name="sequence">40</field>
            <field name="description">Necessary resources, tools, or personnel are currently unavailable</field>
        </record>
        
        <record id="hold_reason_priority_conflict" model="helpdesk.hold.reason">
            <field name="name">Higher Priority Work</field>
            <field name="sequence">50</field>
            <field name="description">Currently handling higher priority tasks or emergencies</field>
        </record>
        
        <record id="hold_reason_technical_issue" model="helpdesk.hold.reason">
            <field name="name">Technical Issue/Blocker</field>
            <field name="sequence">60</field>
            <field name="description">Technical problems or blockers preventing progress</field>
        </record>
    </data>
</odoo>