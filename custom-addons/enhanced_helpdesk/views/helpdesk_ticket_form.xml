<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_helpdesk_ticket_form_inherit_transfer_tab" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form.transfer.tab</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
    <field name="arch" type="xml">
    
      <header>
        <xpath expr="//field[@name='stage_id']" position="before">
          <button name="%(enhanced_helpdesk.action_ticket_report)d"
            string="Print Ticket Report"
            type="action"
            class="oe_highlight" />
        </xpath>
      </header>
      
      <xpath expr="//field[@name='description']" position="before">
        <field name="is_on_hold" invisible="1" />
        <div attrs="{'invisible': [('is_on_hold', '=', False)]}">
          <label for="common_reasons_to_hold_ticket" string="Select That Apply" />
        </div>
        <field name="common_reasons_to_hold_ticket" widget="many2many_checkboxes" string="Select Reasons" attrs="{'invisible': [('is_on_hold', '=', False)]}"/>
        <field name="reason_description_to_hold_ticket" attrs="{'invisible': [('is_on_hold', '=', False)]}" placeholder="Briefly Describe" />
      </xpath>
      
      <xpath expr="//field[@name='description']" position="before">
        <notebook>
          <page string="Ticket Transfer History">
            <field name="tag_transfer_ids">
              <tree string="Tag Transfer Lines" create="false" edit="false" delete="false">
                <field name="tagged_user_id" string="Tagged User"/>
                  <field name="team_id" string="Team"/>
                <field name="tagged_by_user_id" string="Tagged By"/>
                <field name="date_tagged" string="Date Tagged"/>
                <field name="action" string="Status" 
                       decoration-info="action == 'pending'" 
                       decoration-success="action == 'accept'" 
                       decoration-danger="action == 'reject'" 
                       decoration-warning="action == 'hold'"/>
                <field name="accepted_at" string="Accepted At" attrs="{'invisible': [('action', '!=', 'accept')]}"/>
                <field name="rejected_at" string="Rejected At" attrs="{'invisible': [('action', '!=', 'reject')]}"/>
                <field name="held_at" string="Put on Hold At" attrs="{'invisible': [('action', '!=', 'hold')]}"/>
                <field name="response_duration" string="Response Time (Hours)" widget="float_time" optional="hide"/>
                <field name="can_user_act" invisible="1"/>
                <button name="action_accept" 
                        string="Accept" 
                        type="object" 
                        class="btn-success"
                        attrs="{'invisible': ['|', ('action', '!=', 'pending'), ('can_user_act', '=', False)]}"
                        groups="base.group_user"/>
                <button name="action_reject" 
                        string="Reject" 
                        type="object" 
                        class="btn-danger"
                        attrs="{'invisible': ['|', ('action', '!=', 'pending'), ('can_user_act', '=', False)]}"
                        groups="base.group_user"/>
                <!-- <button name="action_hold" 
                        string="Hold" 
                        type="object" 
                        class="btn-warning"
                        attrs="{'invisible': ['|', ('action', '!=', 'pending'), ('can_user_act', '=', False)]}"
                        groups="base.group_user"/> -->
                <button name="action_view_details" 
                        string="View Details" 
                        type="object" 
                        class="btn-info"
                        icon="fa-info-circle"
                        attrs="{'invisible': [('action', 'in', ['pending', 'accept'])]}"
                        groups="base.group_user"/>
              </tree>
            </field>
          </page>
        </notebook>
      </xpath>

    </field>
  </record>
</odoo>
