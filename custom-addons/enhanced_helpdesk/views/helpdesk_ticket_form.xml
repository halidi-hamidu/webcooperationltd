<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_helpdesk_ticket_form_inherit_transfer_tab" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form.transfer.tab</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
    <field name="arch" type="xml">
    
      <header>
        <xpath expr="//field[@name='stage_id']" position="before">
          <button name="%(enhanced_helpdesk.action_ticket_report)d"
            string="Print Ticket Report"
            type="action"
            class="oe_highlight" />
        </xpath>
      </header>
      
      <xpath expr="//field[@name='description']" position="before">
        <field name="is_on_hold" invisible="1" />
        <div invisible="not is_on_hold">
          <label for="common_reasons_to_hold_ticket" string="Select That Apply" />
        </div>
        <field name="common_reasons_to_hold_ticket" widget="many2many_checkboxes" string="Select Reasons" invisible="not is_on_hold"/>
        <field name="reason_description_to_hold_ticket" invisible="not is_on_hold" placeholder="Briefly Describe" />
      </xpath>
      
      <!-- ── Field order: Team → Tags → Tag Category → SLA → Priority → Assignee ── -->

      <!-- Step 1: Remove user_id and priority from original positions (re-added below) -->
      <xpath expr="//group[@class='mb-0 mt-4']//field[@name='user_id']" position="replace"/>
      <xpath expr="//group[@class='mb-0 mt-4']//field[@name='priority']" position="replace"/>

      <!-- Step 2: Update tag_ids — filter by team, no create -->
      <xpath expr="//group[@class='mb-0 mt-4']//field[@name='tag_ids']" position="attributes">
        <attribute name="options">{'color_field': 'color', 'no_create': True, 'no_create_edit': True}</attribute>
        <attribute name="domain">[('team_id', '=', team_id)]</attribute>
      </xpath>

      <!-- Step 3: After tag_ids → Tag Category → SLA → Priority → Assignee -->
      <xpath expr="//group[@class='mb-0 mt-4']//field[@name='tag_ids']" position="after">
        <field name="tag_category_id"
               string="Tag Category"
               domain="[('team_id', '=', team_id)]"
               options="{'no_create': True, 'no_create_edit': True}"
               context="{'default_team_id': team_id}"/>
        <field name="sla_ids"
               string="SLA"
               required="1"
               domain="[('team_id', '=', team_id), ('tag_category_id', '=', tag_category_id)]"
               options="{'no_create': True, 'no_create_edit': True}"
               groups="helpdesk.group_use_sla"
               widget="many2many_tags"/>
        <field name="priority" widget="priority"/>
        <field name="domain_user_ids" invisible="1"/>
        <field name="user_id"
               class="field_user_id"
               string="Assignee"
               domain="[('id', 'in', domain_user_ids)]"
               widget="many2one_avatar_user"
               options="{'no_open': True}"/>
      </xpath>
      
      <!-- Add Ticket Transfer History after description field -->
      <xpath expr="//field[@name='description']" position="after">
        <separator string="Ticket Transfer History"/>
        <field name="tag_transfer_ids" nolabel="1">
          <list string="Tag Transfer Lines" create="false" edit="false" delete="false">
            <field name="tagged_user_id" string="Tagged User"/>
            <field name="team_id" string="Team"/>
            <field name="tagged_by_user_id" string="Tagged By"/>
            <field name="date_tagged" string="Date Tagged"/>
            <field name="action" string="Status" 
                   decoration-info="action == 'pending'" 
                   decoration-success="action == 'accept'" 
                   decoration-danger="action == 'reject'" 
                   decoration-warning="action == 'hold'"
                   decoration-muted="action == 'closed'"
                   decoration-primary="action == 'in_progress'"/>
            <field name="accepted_at" string="Accepted At" column_invisible="True" invisible="action != 'accept'"/>
            <field name="rejected_at" string="Rejected At" column_invisible="True" invisible="action != 'reject'"/>
            <field name="held_at" string="Put on Hold At" column_invisible="True" invisible="action != 'hold'"/>
            <field name="closed_at" string="Closed At" optional="show"/>
            <field name="response_duration" string="Response Time (Hours)" widget="float_time" optional="hide"/>
            <field name="resolution_time" string="Resolution Time (Hours)" widget="float_time" optional="show"/>
            <field name="can_user_act" column_invisible="True"/>
            <button name="action_accept" 
                    string="Accept" 
                    type="object" 
                    class="btn-success"
                    invisible="action != 'pending' or not can_user_act"
                    groups="base.group_user"/>
            <button name="action_reject" 
                    string="Reject" 
                    type="object" 
                    class="btn-danger"
                    invisible="action != 'pending' or not can_user_act"
                    groups="base.group_user"/>
            <button name="action_close" 
                    string="Close" 
                    type="object" 
                    class="btn-primary"
                    invisible="action not in ('accept', 'in_progress') or not can_user_act or closed_at"/>
            <button name="action_hold" 
                    string="Put on Hold" 
                    type="object" 
                    class="btn-warning"
                    invisible="action != 'pending' or not can_user_act"
                    groups="base.group_user"/>
            <button name="action_view_details" 
                    string="View Details" 
                    type="object" 
                    class="btn-info"
                    icon="fa-info-circle"
                    invisible="action in ('pending', 'accept')"
                    groups="base.group_user"/>
            <button name="action_unhold_ticket"
                    string="Unhold"
                    type="object"
                    class="btn-success"
                    invisible="action != 'hold'"
                    help="Remove ticket from hold and resume SLA timer"
                    groups="base.group_user"/>
          </list>
        </field>
        
        <!-- Add Hold Time Logs -->
        <separator string="Hold Time Tracking" invisible="total_hold_time_hours == 0.0"/>
        <group invisible="total_hold_time_hours == 0.0">
          <field name="total_hold_time_hours" widget="float_time" readonly="1"/>
        </group>
        <field name="hold_time_logs" nolabel="1" invisible="total_hold_time_hours == 0.0">
          <list string="Hold Time Logs" create="false" edit="false" delete="false">
            <field name="start_time" string="Hold Started"/>
            <field name="end_time" string="Hold Ended"/>
            <field name="duration_hours" string="Duration (Hours)" widget="float_time"/>
            <field name="reason" string="Reason"/>
          </list>
        </field>
      </xpath>

    </field>
  </record>
</odoo>
