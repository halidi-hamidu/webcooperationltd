<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_helpdesk_ticket_form_inherit_transfer_tab" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form.transfer.tab</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
    <field name="arch" type="xml">
      <!-- Add Print Ticket Report Button in the Header -->
      <header>
        <xpath expr="//field[@name='stage_id']" position="before">
          <button name="%(enhanced_helpdesk.action_ticket_report)d"
            string="Print Ticket Report"
            type="action"
            class="oe_highlight" />

        </xpath>
      </header>
      <xpath expr="//field[@name='description']" position="before">
        <field name="is_on_hold" invisible="1" />
          <div attrs="{'invisible': [('is_on_hold', '=', False)]}">
            <label for="common_reasons_to_hold_ticket"
              string="Select That Apply" />
          </div>
        <field name="common_reasons_to_hold_ticket"  widget="many2many_checkboxes" string="Select Reasons"   attrs="{'invisible': [('is_on_hold', '=', False)]}"/>


       
        <field name="reason_description_to_hold_ticket"
          attrs="{'invisible': [('is_on_hold', '=', False)]}"
          placeholder="Breifly Describe" />


      </xpath>
      <xpath expr="//field[@name='description']" position="before">
        <notebook>
          <page string="Ticket Transfers">

            <!-- ✅ Editable Tree for Helpdesk Admin and System Admin -->
            <field name="transfer_ids" groups="helpdesk.group_helpdesk_admin,base.group_system">
              <tree string="Transfer History" editable="bottom">
                <field name="ticket_id" />
                <field name="old_team_id" />
                <field name="old_user_id" string="Assigned To" />
                <field name="transfer_date" />
                <field name="time_commited_to_resolve_the_ticket_by_the_team"
                  string="Commited Time To Resolve" />
                <field name="status" />
                <field name="time_taken_for_the_team_to_resolve" string="Time Spent to Resolve" />
                <field name="team_status_on_ticket_assigned" string="Team Status" readonly="1" />
                <button string="Initiate Task"
                  type="object"
                  name="transfer_as_task"
                  class="oe_highlight btn-primary"
                  icon="fa-tasks"
                  groups="helpdesk.group_helpdesk_admin,base.group_system" />

              </tree>
            </field>

            <!-- 🚫 Read-only Tree for other users -->
            <field name="transfer_ids" groups="!helpdesk.group_helpdesk_admin,!base.group_system">
              <tree string="Transfer History" editable="false">
                <field name="ticket_id" readonly="1" />
                <field name="old_team_id" readonly="1" />
                <field name="old_user_id" string="Assigned To" readonly="1" />
                <field name="transfer_date" readonly="1" />
                <field name="time_commited_to_resolve_the_ticket_by_the_team"
                  string="Commited Time To Resolve" readonly="1" />
                <field name="status" readonly="1" />
                <field name="time_taken_for_the_team_to_resolve" string="Time Spent to Resolve"
                  readonly="1" />
                <field name="team_status_on_ticket_assigned" string="Team Status" readonly="1" />
              </tree>
            </field>

          </page>
        </notebook>

      </xpath>

    </field>
  </record>
</odoo>