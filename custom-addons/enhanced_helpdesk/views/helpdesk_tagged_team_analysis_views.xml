<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Pivot View -->
    <record id="helpdesk_tagged_team_analysis_pivot" model="ir.ui.view">
        <field name="name">helpdesk.tagged.team.analysis.pivot</field>
        <field name="model">helpdesk.tagged.team.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Tagged Team Analysis" display_quantity="1" disable_linking="1" sample="1" default_order="team_id asc">
                <field name="team_id" type="row"/>
                <field name="total_response_time" widget="float_time" type="measure"/>
                <field name="avg_response_time" widget="float_time" type="measure"/>
                <field name="tag_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="helpdesk_tagged_team_analysis_graph" model="ir.ui.view">
        <field name="name">helpdesk.tagged.team.analysis.graph</field>
        <field name="model">helpdesk.tagged.team.analysis</field>
        <field name="arch" type="xml">
            <graph string="Tagged Team Analysis" type="bar" sample="1">
                <field name="team_id"/>
                <field name="total_response_time" type="measure" widget="float_time"/>
            </graph>
        </field>
    </record>

    <!-- Tree View -->
    <record id="helpdesk_tagged_team_analysis_tree" model="ir.ui.view">
        <field name="name">helpdesk.tagged.team.analysis.tree</field>
        <field name="model">helpdesk.tagged.team.analysis</field>
        <field name="arch" type="xml">
            <tree string="Tagged Team Analysis" create="false" edit="false">
                <field name="ticket_id"/>
                <field name="ticket_name"/>
                <field name="team_id"/>
                <field name="ticket_team_id"/>
                <field name="tag_count"/>
                <field name="total_response_time" widget="float_time"/>
                <field name="avg_response_time" widget="float_time"/>
                <field name="ticket_stage_id"/>
                <field name="priority"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="helpdesk_tagged_team_analysis_search" model="ir.ui.view">
        <field name="name">helpdesk.tagged.team.analysis.search</field>
        <field name="model">helpdesk.tagged.team.analysis</field>
        <field name="arch" type="xml">
            <search string="Tagged Team Analysis">
                <field name="ticket_id"/>
                <field name="ticket_name"/>
                <field name="team_id"/>
                <field name="ticket_team_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter string="High Priority" name="high_priority" 
                        domain="[('priority', 'in', ['2', '3'])]"/>
                <filter string="My Tickets" name="my_tickets" 
                        domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Ticket" name="group_ticket" context="{'group_by': 'ticket_id'}"/>
                    <filter string="Tagged Team" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Ticket Team" name="group_ticket_team" context="{'group_by': 'ticket_team_id'}"/>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'ticket_stage_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Assigned To" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_helpdesk_tagged_team_analysis" model="ir.actions.act_window">
        <field name="name">Tagged Team Analysis</field>
        <field name="res_model">helpdesk.tagged.team.analysis</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="helpdesk_tagged_team_analysis_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data yet!
            </p>
            <p>
                This report shows response time analysis for tagged teams per ticket.
                Tag users in tickets to see their team's response metrics.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem 
        id="menu_helpdesk_tagged_team_analysis"
        name="Tagged Team Analysis"
        parent="helpdesk.helpdesk_ticket_report_menu_main"
        action="action_helpdesk_tagged_team_analysis"
        sequence="50"/>

</odoo>
