<?xml version="1.1" encoding="UTF-8"?>
<odoo>
    <!-- Ticket Type Form View - Add Assigned Users -->
    <record id="view_helpdesk_ticket_type_form_inherit_users" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.form.inherit.users</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="user_ids" widget="many2many_tags_avatar" 
                       options="{'color_field': 'color', 'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Ticket Type Tree View - Add Assigned Users Column -->
    <record id="view_helpdesk_ticket_type_tree_inherit_users" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.tree.inherit.users</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="user_ids" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
