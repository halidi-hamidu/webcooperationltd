<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_helpdesk_working_time_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.working.time.wizard.form</field>
        <field name="model">helpdesk.working.time.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Working Time Configuration">
                <group>
                    <field name="working_time_id" required="1"/>
                    <field name="recalculate_sla"/>
                </group>
                <group string="Selected Tickets">
                    <field name="ticket_ids" readonly="1">
                        <list string="Tickets">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="stage_id"/>
                            <field name="sla_deadline"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_apply_working_time" 
                            string="Apply Configuration" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_working_time_wizard" model="ir.actions.act_window">
        <field name="name">Apply Working Time Configuration</field>
        <field name="res_model">helpdesk.working.time.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
