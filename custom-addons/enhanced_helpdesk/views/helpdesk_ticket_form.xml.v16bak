<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_helpdesk_ticket_form_inherit_transfer_tab" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form.transfer.tab</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
    <field name="arch" type="xml">
    
      <header>
        <xpath expr="//field[@name='stage_id']" position="before">
          <button name="%(enhanced_helpdesk.action_ticket_report)d"
            string="Print Ticket Report"
            type="action"
            class="oe_highlight" />
        </xpath>
      </header>
      
      <xpath expr="//field[@name='description']" position="before">
        <field name="is_on_hold" invisible="1" />
        <div attrs="{'invisible': [('is_on_hold', '=', False)]}">
          <label for="common_reasons_to_hold_ticket" string="Select That Apply" />
        </div>
        <field name="common_reasons_to_hold_ticket" widget="many2many_checkboxes" string="Select Reasons" attrs="{'invisible': [('is_on_hold', '=', False)]}"/>
        <field name="reason_description_to_hold_ticket" attrs="{'invisible': [('is_on_hold', '=', False)]}" placeholder="Briefly Describe" />
      </xpath>
      
      <!-- Add label to Tags field -->
      <xpath expr="//field[@name='tag_ids']" position="before">
        <label for="tag_ids" string="Tags"/>
      </xpath>
      <xpath expr="//field[@name='tag_ids']" position="attributes">
        <attribute name="nolabel">0</attribute>
        <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
        <attribute name="domain">[('name', 'in', ['AS', 'ITMS', 'UIS', 'IOT'])]</attribute>
      </xpath>
      
      <!-- Add Ticket Transfer History after description field -->
      <xpath expr="//field[@name='description']" position="after">
        <separator string="Ticket Transfer History"/>
        <field name="tag_transfer_ids" nolabel="1">
          <tree string="Tag Transfer Lines" create="false" edit="false" delete="false">
            <field name="tagged_user_id" string="Tagged User"/>
              <field name="team_id" string="Team"/>
            <field name="tagged_by_user_id" string="Tagged By"/>
            <field name="date_tagged" string="Date Tagged"/>
            <field name="action" string="Status" 
                   decoration-info="action == 'pending'" 
                   decoration-success="action == 'accept'" 
                   decoration-danger="action == 'reject'" 
                   decoration-warning="action == 'hold'"
                   decoration-muted="action == 'closed'"
                   decoration-primary="action == 'in_progress'"/>
            <field name="accepted_at" string="Accepted At" attrs="{'invisible': [('action', '!=', 'accept')]}"/>
            <field name="rejected_at" string="Rejected At" attrs="{'invisible': [('action', '!=', 'reject')]}"/>
            <field name="held_at" string="Put on Hold At" attrs="{'invisible': [('action', '!=', 'hold')]}"/>
            <field name="closed_at" string="Closed At" optional="show"/>
            <field name="response_duration" string="Response Time (Hours)" widget="float_time" optional="hide"/>
            <field name="resolution_time" string="Resolution Time (Hours)" widget="float_time"   optional="show"/>
            <field name="can_user_act" invisible="1"/>
            <button name="action_accept" 
                    string="Accept" 
                    type="object" 
                    class="btn-success"
                    attrs="{'invisible': ['|', ('action', '!=', 'pending'), ('can_user_act', '=', False)]}"
                    groups="base.group_user"/>
            <button name="action_reject" 
                    string="Reject" 
                    type="object" 
                    class="btn-danger"
                    attrs="{'invisible': ['|', ('action', '!=', 'pending'), ('can_user_act', '=', False)]}"
                    groups="base.group_user"/>
            <button name="action_close" 
                    string="Close" 
                    type="object" 
                    class="btn-primary"
                    attrs="{'invisible': ['|', '|', ('action', 'not in', ['accept', 'in_progress']), ('can_user_act', '=', False), ('closed_at', '!=', False)]}"/>
            <button name="action_hold" 
                    string="Put on Hold" 
                    type="object" 
                    class="btn-warning"
                    attrs="{'invisible': ['|', ('action', '!=', 'pending'), ('can_user_act', '=', False)]}"
                    groups="base.group_user"/>
            <button name="action_view_details" 
                    string="View Details" 
                    type="object" 
                    class="btn-info"
                    icon="fa-info-circle"
                    attrs="{'invisible': [('action', 'in', ['pending', 'accept'])]}"
                    groups="base.group_user"/>
            <button name="action_unhold_ticket"
                    string="Unhold"
                    type="object"
                    class="btn-success"
                    attrs="{'invisible': [('action', '!=', 'hold')]}"
                    help="Remove ticket from hold and resume SLA timer"
                    groups="base.group_user"/>

          </tree>
        </field>
        
       
        
        <!-- Add Hold Time Logs -->
        <separator string="Hold Time Tracking" attrs="{'invisible': [('total_hold_time_hours', '=', 0.0)]}"/>
        <group attrs="{'invisible': [('total_hold_time_hours', '=', 0.0)]}">
          <field name="total_hold_time_hours" widget="float_time" readonly="1"/>
        </group>
        <field name="hold_time_logs" nolabel="1" attrs="{'invisible': [('total_hold_time_hours', '=', 0.0)]}">
          <tree string="Hold Time Logs" create="false" edit="false" delete="false">
            <field name="start_time" string="Hold Started"/>
            <field name="end_time" string="Hold Ended"/>
            <field name="duration_hours" string="Duration (Hours)" widget="float_time"/>
            <field name="reason" string="Reason"/>
          </tree>
        </field>
      </xpath>

    </field>
  </record>
</odoo>
