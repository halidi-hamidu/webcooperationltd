<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hold Analysis Pivot View -->
    <record id="helpdesk_hold_analysis_pivot" model="ir.ui.view">
        <field name="name">helpdesk.hold.analysis.pivot</field>
        <field name="model">helpdesk.hold.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Hold Analysis Report" display_quantity="1" disable_linking="1" sample="1">
                <field name="ticket_team_id" type="row"/>
                <field name="assigned_user_id" type="row"/>
                <field name="priority" type="col"/>
                <field name="hold_count" string="Hold Periods" type="measure"/>
                <field name="hold_duration_hours" string="Avg Hold Duration (hrs)" widget="float_time" type="measure"/>
                <field name="total_hold_hours" string="Total Hold Hours" widget="float_time" type="measure"/>
                <field name="sla_deadline_extended_hours" string="SLA Extended By (hrs)" widget="float_time" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Hold Analysis Graph View -->
    <record id="helpdesk_hold_analysis_graph" model="ir.ui.view">
        <field name="name">helpdesk.hold.analysis.graph</field>
        <field name="model">helpdesk.hold.analysis</field>
        <field name="arch" type="xml">
            <graph string="Hold Analysis" type="bar" sample="1">
                <field name="ticket_team_id"/>
                <field name="hold_count" string="Hold Periods" type="measure"/>
                <field name="hold_duration_hours" string="Avg Hold Duration (hrs)" type="measure" widget="float_time"/>
                <field name="total_hold_hours" string="Total Hold Hours" type="measure" widget="float_time"/>
                <field name="sla_deadline_extended_hours" string="SLA Extended By (hrs)" type="measure" widget="float_time"/>
            </graph>
        </field>
    </record>

    <!-- Hold Analysis List View -->
    <record id="helpdesk_hold_analysis_tree" model="ir.ui.view">
        <field name="name">helpdesk.hold.analysis.tree</field>
        <field name="model">helpdesk.hold.analysis</field>
        <field name="arch" type="xml">
            <list string="Hold Analysis" create="false" edit="false"
                  decoration-danger="sla_breached"
                  decoration-warning="is_currently_on_hold">
                <field name="ticket_id" string="Ticket"/>
                <field name="ticket_name" optional="show"/>
                <field name="ticket_team_id" string="Team" optional="show"/>
                <field name="assigned_user_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="hold_start" string="Hold Start"/>
                <field name="hold_end" string="Hold End" optional="show"/>
                <field name="hold_duration_hours" string="Hold Duration (hrs)" widget="float_time"/>
                <field name="total_hold_hours" string="Total Hold (hrs)" widget="float_time" optional="show"/>
                <field name="hold_reasons_text" string="Reasons" optional="show"/>
                <field name="is_currently_on_hold" string="On Hold?" optional="show"/>
                <!-- SLA impact columns -->
                <field name="sla_deadline" string="Original SLA Deadline" optional="show"/>
                <field name="sla_adjusted_deadline" string="Adjusted SLA Deadline" optional="show"/>
                <field name="sla_deadline_extended_hours" string="SLA Extended By (hrs)" widget="float_time" optional="show"/>
                <field name="sla_breached" string="SLA Breached?" optional="show"/>
                <field name="sla_status" string="SLA Status" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Hold Analysis Search View -->
    <record id="helpdesk_hold_analysis_search" model="ir.ui.view">
        <field name="name">helpdesk.hold.analysis.search</field>
        <field name="model">helpdesk.hold.analysis</field>
        <field name="arch" type="xml">
            <search string="Hold Analysis">
                <!-- Text search fields -->
                <field name="ticket_id"/>
                <field name="ticket_name"/>
                <field name="assigned_user_id"/>
                <field name="ticket_team_id"/>
                <field name="partner_id"/>
                <field name="hold_reasons_text"/>

                <!-- Date Filters -->
                <filter string="Today" name="today"
                        domain="[('hold_start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S')),
                                 ('hold_start', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter string="This Week" name="this_week"
                        domain="[('hold_start', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('hold_start', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Last 30 Days" name="last_30_days"
                        domain="[('hold_start', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last 90 Days" name="last_90_days"
                        domain="[('hold_start', '&gt;=', (context_today() - datetime.timedelta(days=90)).strftime('%Y-%m-%d'))]"/>

                <separator/>

                <!-- Status Filters -->
                <filter string="Currently on Hold" name="currently_on_hold"
                        domain="[('is_currently_on_hold', '=', True)]"/>
                <filter string="SLA Breached" name="sla_breached"
                        domain="[('sla_breached', '=', True)]"/>
                <filter string="SLA Impacted (hold &gt; 1h)" name="sla_impacted"
                        domain="[('sla_deadline_extended_hours', '&gt;', 1)]"/>
                <filter string="Long Holds (&gt;24h)" name="long_holds"
                        domain="[('hold_duration_hours', '&gt;', 24)]"/>
                <filter string="High / Urgent Priority" name="high_priority"
                        domain="[('priority', 'in', ['2', '3'])]"/>

                <separator/>

                <!-- Group By -->
                <filter string="Team" name="group_team" context="{'group_by': 'ticket_team_id'}"/>
                <filter string="Assigned To" name="group_user" context="{'group_by': 'assigned_user_id'}"/>
                <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                <filter string="SLA Status" name="group_sla_status" context="{'group_by': 'sla_status'}"/>
                <filter string="Hold Start: Month" name="group_hold_month" context="{'group_by': 'hold_start:month'}"/>
                <filter string="Currently on Hold" name="group_hold_status" context="{'group_by': 'is_currently_on_hold'}"/>
            </search>
        </field>
    </record>

    <!-- Hold Analysis Action -->
    <record id="action_helpdesk_hold_analysis" model="ir.actions.act_window">
        <field name="name">On Hold Analysis Report</field>
        <field name="res_model">helpdesk.hold.analysis</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="helpdesk_hold_analysis_search"/>
        <field name="context">{'search_default_last_30_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hold data yet!
            </p>
            <p>
                This report shows every hold period per ticket — how long it was paused,
                the hold reasons, and the resulting SLA deadline extension.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_helpdesk_hold_analysis"
        name="On Hold Analysis"
        parent="helpdesk.helpdesk_ticket_report_menu_main"
        action="action_helpdesk_hold_analysis"
        sequence="45"/>

</odoo>
