<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ── Form View ──────────────────────────────────────────────────────── -->
    <record id="helpdesk_tag_category_view_form" model="ir.ui.view">
        <field name="name">helpdesk.tag.category.view.form</field>
        <field name="model">helpdesk.tag.category</field>
        <field name="arch" type="xml">
            <form string="Tag Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Category Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Network Issues"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_id" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Optional description…"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Tags" name="tags">
                            <field name="tag_ids" nolabel="1"
                                   domain="[('team_id', '=', team_id)]"
                                   context="{'default_team_id': team_id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="color" widget="color_index"/>
                                    <field name="team_id" optional="show"
                                           options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="SLA Policies" name="sla">
                            <field name="sla_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="team_id"/>
                                    <field name="time" string="Time (Hours)"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List View ──────────────────────────────────────────────────────── -->
    <record id="helpdesk_tag_category_view_list" model="ir.ui.view">
        <field name="name">helpdesk.tag.category.view.list</field>
        <field name="model">helpdesk.tag.category</field>
        <field name="arch" type="xml">
            <list string="Tag Categories" editable="top">
                <field name="name"/>
                <field name="team_id" options="{'no_create': True}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────────── -->
    <record id="helpdesk_tag_category_view_search" model="ir.ui.view">
        <field name="name">helpdesk.tag.category.view.search</field>
        <field name="model">helpdesk.tag.category</field>
        <field name="arch" type="xml">
            <search string="Search Tag Categories">
                <field name="name"/>
                <field name="team_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Team" name="group_team" context="{'group_by': 'team_id'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────────── -->
    <record id="action_helpdesk_tag_category" model="ir.actions.act_window">
        <field name="name">Tag Categories</field>
        <field name="res_model">helpdesk.tag.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="helpdesk_tag_category_view_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Tag Category
            </p>
            <p>
                Tag Categories help classify helpdesk tags by team and link them to SLA policies.
            </p>
        </field>
    </record>

    <!-- ── Menu: under Configuration ──────────────────────────────────────── -->
    <menuitem
        id="menu_helpdesk_tag_category"
        name="Tag Categories"
        parent="helpdesk.helpdesk_menu_config"
        action="action_helpdesk_tag_category"
        sequence="35"
        groups="helpdesk.group_helpdesk_manager"/>

    <!-- ── Inherit SLA form: add Tag Category field ───────────────────────── -->
    <record id="helpdesk_sla_form_inherit_tag_category" model="ir.ui.view">
        <field name="name">helpdesk.sla.form.inherit.tag.category</field>
        <field name="model">helpdesk.sla</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_sla_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='partner_ids']" position="before">
                <field name="tag_category_id"
                       string="Tag Category"
                       domain="[('team_id', '=', team_id)]"
                       options="{'no_create': True, 'no_create_edit': True}"
                       context="{'default_team_id': team_id}"/>
            </xpath>
        </field>
    </record>

    <!-- ── Inherit SLA list: add Tags + Tag Category columns ──────────────── -->
    <record id="helpdesk_sla_list_inherit_tag_category" model="ir.ui.view">
        <field name="name">helpdesk.sla.list.inherit.tag.category</field>
        <field name="model">helpdesk.sla</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_sla_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="tag_category_id" optional="show" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- ── Inherit Tag form: add Team + Category fields ───────────────────── -->
    <record id="helpdesk_tag_form_inherit_category" model="ir.ui.view">
        <field name="name">helpdesk.tag.form.inherit.category</field>
        <field name="model">helpdesk.tag</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tag_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="team_id" options="{'no_create': True}"/>
                <field name="tag_category_id"
                       domain="[('team_id', '=', team_id)]"
                       options="{'no_create': True}"
                       context="{'default_team_id': team_id}"/>
            </xpath>
        </field>
    </record>

    <!-- ── Inherit Tag list: add Team + Category columns ─────────────────── -->
    <record id="helpdesk_tag_list_inherit_category" model="ir.ui.view">
        <field name="name">helpdesk.tag.list.inherit.category</field>
        <field name="model">helpdesk.tag</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tag_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="team_id" optional="show" options="{'no_create': True}"/>
                <field name="tag_category_id" optional="show" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
