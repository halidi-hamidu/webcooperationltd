<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Combined Helpdesk Analysis Dashboard Action -->
    <record id="action_helpdesk_analysis_dashboard" model="ir.actions.client">
        <field name="name">Helpdesk Analysis Dashboard</field>
        <field name="tag">helpdesk_analysis_dashboard</field>
        <field name="context">{}</field>
    </record>

    <!-- Alternative: Multi-tab Action -->
    <record id="action_helpdesk_comprehensive_analysis" model="ir.actions.act_window">
        <field name="name">Comprehensive Helpdesk Analysis</field>
        <field name="res_model">helpdesk.hold.analysis</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="helpdesk_hold_analysis_search"/>
        <field name="context">{'search_default_last_30_days': 1}</field>
        <field name="help" type="html">
            
            <p>
                <strong>Hold Analysis:</strong> Identify all team members who kept tickets on hold<br/>
            </p>
            <p>
                Use the filters and grouping options to get detailed insights into your team's performance.
            </p>
        </field>
    </record>



    


</odoo>