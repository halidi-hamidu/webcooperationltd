<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit SLA pivot view to add rate columns -->
    <record id="helpdesk_sla_report_analysis_view_pivot_rates" model="ir.ui.view">
        <field name="name">helpdesk.sla.report.analysis.pivot.rates</field>
        <field name="model">helpdesk.sla.report.analysis</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_sla_report_analysis_view_pivot"/>
        <field name="arch" type="xml">
            <!-- Add rate measure fields after the existing sla_status_failed field -->
            <xpath expr="//field[@name='sla_status_failed']" position="after">
                <field name="sla_fail_count" string="SLA Failures" type="measure"/>
                <field name="sla_success_count" string="SLA Successes" type="measure"/>
                <field name="sla_total_count" string="Total SLA Checks" type="measure"/>
                <field name="sla_fail_rate" string="Failure Rate (%)" type="measure"/>
                <field name="sla_success_rate" string="Success Rate (%)" type="measure"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit SLA graph view to add rate fields as invisible measures -->
    <record id="helpdesk_sla_report_analysis_view_graph_rates" model="ir.ui.view">
        <field name="name">helpdesk.sla.report.analysis.graph.rates</field>
        <field name="model">helpdesk.sla.report.analysis</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_sla_report_analysis_view_graph"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sla_exceeded_hours']" position="after">
                <field name="sla_fail_rate" string="Failure Rate (%)" invisible="1"/>
                <field name="sla_success_rate" string="Success Rate (%)" invisible="1"/>
                <field name="sla_fail_count" string="SLA Failures" invisible="1"/>
                <field name="sla_success_count" string="SLA Successes" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
