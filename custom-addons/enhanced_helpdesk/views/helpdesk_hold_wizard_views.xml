<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hold Wizard Form View -->
    <record id="view_helpdesk_ticket_hold_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.hold.wizard.form</field>
        <field name="model">helpdesk.ticket.hold.wizard</field>
        <field name="arch" type="xml">
            <form string="Put Assignment On Hold" class="o_form_view o_hold_wizard_form">
                
                <!-- Header with icon and title -->
                <header class="text-center mb-4">
                    <div class="o_form_statusbar">
                        <h3 class="text-warning mb-2">
                            <i class="fa fa-pause-circle fa-lg mr-2"/> Put Assignment On Hold
                        </h3>
                        <p class="text-muted mb-0">Select reasons and provide details for putting this assignment on hold</p>
                    </div>
                </header>

                <sheet class="o_dialog_sheet">
                    <field name="tag_transfer_id" invisible="1"/>
                    
                    <!-- Assignment Information Card -->
                    <div class="card mb-4 border-info">
                        <div class="card-header bg-light border-info">
                            <h6 class="mb-0 text-info">
                                <i class="fa fa-info-circle mr-2"/> Assignment Information
                            </h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong><i class="fa fa-ticket mr-1 text-primary"/> Ticket:</strong>
                                    <field name="ticket_id" readonly="1" nolabel="1" class="font-weight-bold text-primary"/>
                                </div>
                                <div class="col-md-6">
                                    <strong><i class="fa fa-user mr-1 text-success"/> Tagged User:</strong>
                                    <field name="tagged_user_id" readonly="1" nolabel="1" class="font-weight-bold text-success"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 1: Hold Reasons -->
                    <div class="card mb-4 border-warning">
                        <div class="card-header bg-light border-warning">
                            <h5 class="mb-0 text-warning">
                                <i class="fa fa-list-check mr-2"/> Section 1: Hold Reasons
                            </h5>
                            <small class="text-muted">Select all applicable reasons (multiple selections allowed)</small>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <field name="predefined_reasons" 
                                       widget="many2many_checkboxes" 
                                       nolabel="1"
                                       class="o_hold_reasons_checkboxes"
                                       options="{'horizontal': false}"/>
                            </div>
                            <div class="alert alert-light border-warning" role="alert">
                                <i class="fa fa-lightbulb-o mr-2 text-warning" title="Tip"/> 
                                <small><strong>Tip:</strong> Select all reasons that apply to this hold request. You can choose multiple options.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Additional Details -->
                    <div class="card mb-4 border-primary">
                        <div class="card-header bg-light border-primary">
                            <h5 class="mb-0 text-primary">
                                <i class="fa fa-edit mr-2"/> Section 2: Additional Details
                            </h5>
                            <small class="text-muted">Provide specific context, timeline, or explanations</small>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <field name="hold_reason" 
                                       nolabel="1" 
                                       widget="text"
                                       placeholder="Please provide specific details about this hold request:&#10;• What is blocking progress?&#10;• Dependencies or requirements needed&#10;• Expected timeline for resolution&#10;• Any other relevant context..."
                                       class="form-control"
                                       style="min-height: 120px;"
                                       options="{'resizable': true}"/>
                            </div>
                            <div class="alert alert-light border-primary" role="alert">
                                <i class="fa fa-info-circle mr-2 text-primary" title="Note"/> 
                                <small><strong>Note:</strong> Detailed explanations help other team members understand the situation better.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Action Summary -->
                    <div class="alert alert-success" role="alert">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <i class="fa fa-check-circle mr-2" title="Summary"/>
                                <strong>What happens when you submit:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Assignment will be marked as "On Hold"</li>
                                    <li>Selected reasons and details will be saved</li>
                                    <li>All involved users will be notified via chatter</li>
                                    <li>Action will be timestamped for tracking</li>
                                </ul>
                            </div>
                            <div class="col-md-4 text-center">
                                <i class="fa fa-clock-o fa-2x text-muted" title="Timestamp"/>
                                <br/>
                                <small class="text-muted">Timestamped Action</small>
                            </div>
                        </div>
                    </div>

                </sheet>
                
                <!-- Enhanced Footer -->
                <footer class="modal-footer bg-light border-top">
                    <div class="container-fluid">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <div class="text-muted small">
                                    <i class="fa fa-shield mr-1 text-success"/> Secure Action
                                    <span class="mx-2">•</span>
                                    <i class="fa fa-clock-o mr-1 text-info"/> Auto-timestamped
                                    <span class="mx-2">•</span>
                                    <i class="fa fa-users mr-1 text-warning"/> Team Notified
                                </div>
                            </div>
                            <div class="col-md-6 text-right">
                                <button string="Cancel" 
                                        class="btn btn-light border mr-3" 
                                        special="cancel">
                                    <i class="fa fa-times mr-1"/> Cancel
                                </button>
                                <button name="action_submit_hold" 
                                        string="Submit Hold Request" 
                                        type="object" 
                                        class="btn btn-warning btn-lg">
                                    <i class="fa fa-pause mr-1"/> Submit Hold Request
                                </button>
                            </div>
                        </div>
                    </div>
                </footer>
            </form>
        </field>
    </record>

    <!-- Hold Reason Tree View -->
    <record id="view_helpdesk_hold_reason_tree" model="ir.ui.view">
        <field name="name">helpdesk.hold.reason.tree</field>
        <field name="model">helpdesk.hold.reason</field>
        <field name="arch" type="xml">
            <tree string="Hold Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Hold Reason Form View -->
    <record id="view_helpdesk_hold_reason_form" model="ir.ui.view">
        <field name="name">helpdesk.hold.reason.form</field>
        <field name="model">helpdesk.hold.reason</field>
        <field name="arch" type="xml">
            <form string="Hold Reason">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Hold Reason Action -->
    <record id="action_helpdesk_hold_reason" model="ir.actions.act_window">
        <field name="name">Hold Reasons</field>
        <field name="res_model">helpdesk.hold.reason</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hold reasons defined!
            </p>
            <p>
                Create predefined reasons that users can select when putting tag assignments on hold.
            </p>
        </field>
    </record>

    <!-- Menu Item for Hold Reasons (under Configuration) -->
    <menuitem id="menu_helpdesk_hold_reasons"
              name="Hold Reasons"
              parent="helpdesk.helpdesk_menu_config"
              action="action_helpdesk_hold_reason"
              sequence="40"
              groups="helpdesk.group_helpdesk_manager"/>
</odoo>