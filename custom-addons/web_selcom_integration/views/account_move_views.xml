<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_selcom_lipa" model="ir.ui.view">
        <field name="name">account.move.form.selcom.lipa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="selcom_till_alias_partner"
                       string="Selcom Till Alias (Contact)"
                       placeholder="Not generated yet"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_selcom_lipa" model="ir.ui.view">
        <field name="name">account.move.tree.selcom.lipa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="selcom_till_alias_partner"
                       optional="show"
                       placeholder="Not generated yet"/>
            </xpath>
        </field>
    </record>

    <template id="report_invoice_document_inherit_selcom" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('invoice_main')]" position="before">
            <div class="row mt-2 mb-2" t-if="o.partner_id.selcom_till_alias">
                <div class="col-6 offset-col-6">
                    <strong>Lipa Namba:</strong>
                    <span t-field="o.partner_id.selcom_till_alias"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
