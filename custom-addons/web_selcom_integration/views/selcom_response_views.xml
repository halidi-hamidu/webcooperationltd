<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Till Alias Responses -->
    <!-- ============================================================ -->
    <record id="view_selcom_till_alias_response_list" model="ir.ui.view">
        <field name="name">selcom.till.alias.response.list</field>
        <field name="model">selcom.till.alias.response</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Timestamp"/>
                <field name="partner_id"/>
                <field name="memo"/>
                <field name="endpoint"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'failed'"/>
                <field name="http_status" string="HTTP"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_selcom_till_alias_response_form" model="ir.ui.view">
        <field name="name">selcom.till.alias.response.form</field>
        <field name="model">selcom.till.alias.response</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="success,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="memo"/>
                            <field name="endpoint"/>
                        </group>
                        <group>
                            <field name="create_date" string="Timestamp" readonly="1"/>
                            <field name="http_status"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Payload JSON">
                            <field name="request_payload" readonly="1"/>
                        </page>
                        <page string="Response JSON">
                            <field name="response_payload" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_selcom_till_alias_responses" model="ir.actions.act_window">
        <field name="name">Till Alias Responses</field>
        <field name="res_model">selcom.till.alias.response</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- Order Responses -->
    <!-- ============================================================ -->
    <record id="view_selcom_order_response_list" model="ir.ui.view">
        <field name="name">selcom.order.response.list</field>
        <field name="model">selcom.order.response</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Timestamp"/>
                <field name="order_id"/>
                <field name="endpoint"/>
                <field name="gateway_reference"/>
                <field name="selcom_webhook_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'failed'"/>
                <field name="http_status" string="HTTP"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_selcom_order_response_form" model="ir.ui.view">
        <field name="name">selcom.order.response.form</field>
        <field name="model">selcom.order.response</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="success,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="endpoint"/>
                            <field name="gateway_reference"/>
                            <field name="selcom_webhook_id"/>
                        </group>
                        <group>
                            <field name="create_date" string="Timestamp" readonly="1"/>
                            <field name="http_status"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Payload JSON">
                            <field name="request_payload" readonly="1"/>
                        </page>
                        <page string="Response JSON">
                            <field name="response_payload" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_selcom_order_responses" model="ir.actions.act_window">
        <field name="name">Order Responses</field>
        <field name="res_model">selcom.order.response</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- Menus: Selcom Responses (admin only) -->
    <!-- ============================================================ -->
    <menuitem id="menu_selcom_responses_root"
              name="Selcom Responses"
              parent="menu_selcom_root"
              groups="base.group_system"
              sequence="10"/>
    <menuitem id="menu_selcom_till_alias_responses"
              name="Till Alias Responses"
              parent="menu_selcom_responses_root"
              action="action_selcom_till_alias_responses"
              groups="base.group_system"/>
    <menuitem id="menu_selcom_order_responses"
              name="Order Responses"
              parent="menu_selcom_responses_root"
              action="action_selcom_order_responses"
              groups="base.group_system"/>
</odoo>
