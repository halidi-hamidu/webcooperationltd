<?xml version="1.0"?>
<odoo>

<!-- Add to project.task form view -->
<record id="view_task_form_inherit_approvals" model="ir.ui.view">
    <field name="name">project.task.form.inherit.approvals</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
                <button 
                    name="action_create_approval_request" 
                    string="Request Approval" 
                    type="object" 
                    class="btn-primary"/>   
        </xpath>
        <xpath expr="//button[@name='action_recurring_tasks']" position="after">
            <button 
                name="action_view_approval_requests" 
                type="object"
                class="oe_stat_button"
                icon="fa-thumbs-o-up"
                invisible="not approval_request_count">
                <field name="approval_request_count" widget="statinfo" string="Approvals"/>
            </button>
        </xpath>
    </field>
</record>

</odoo>