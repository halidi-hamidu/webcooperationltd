<?xml version="1.0"?>
<odoo>

<!-- Add to approval.request form view -->
<record id="view_approval_request_form_inherit_task" model="ir.ui.view">
    <field name="name">approval.request.form.inherit.task</field>
    <field name="model">approval.request</field>
    <field name="inherit_id" ref="approvals.approval_request_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//button[@name='action_get_attachment_view']" position="before">
                <button 
                    name="action_view_task" 
                    string="View Activity" 
                    type="object" 
                    class="oe_stat_button"
                    icon="fa-tasks"
                    attrs="{'invisible': [('task_id', '=', False)]}">
                    <!--<field name="task_id" widget="statinfo" string="Task"/>-->
                </button>
        </xpath>
        <xpath expr="//field[@name='category_id']" position="after">
            <field name="task_id" options="{'no_create': True}"/>
            <field name="allocated_balance"/>
        </xpath>
    </field>
</record>

<record id="view_approval_request_tree_inherit" model="ir.ui.view">
    <field name="name">approval.request.tree.inherit</field>
    <field name="model">approval.request</field>
    <field name="inherit_id" ref="approvals.approval_request_view_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='name']" position="after">
            <field name="task_id" optional="show"/>
        </xpath>
    </field>
</record>

</odoo>