<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal users get read access to fleet vehicles through their partner link.
         Odoo's standard portal record rules already cover account.move. -->
    <record id="fleet_vehicle_portal_access_rule" model="ir.rule">
        <field name="name">Web Portal: fleet vehicles of my company</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[
            '|',
            ('driver_id', 'child_of', user.partner_id.commercial_partner_id.ids),
            ('manager_id', 'child_of', user.partner_id.commercial_partner_id.ids)
        ]</field>
    </record>
</odoo>
