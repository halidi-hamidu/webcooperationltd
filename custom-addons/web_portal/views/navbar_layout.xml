<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Make the portal frontend navbar full-width (container-fluid) -->
    <template id="portal_frontend_layout_navbar" inherit_id="portal.frontend_layout">
        <xpath expr="//nav[hasclass('navbar')]" position="attributes">
            <attribute name="t-attf-class">navbar navbar-expand-lg {{ 'sticky-top' if website and website.navbar_sticky else '' }}</attribute>
        </xpath>
        <xpath expr="//nav[hasclass('navbar')]//div[hasclass('container')]" position="attributes">
            <attribute name="class">container</attribute>
        </xpath>
    </template>
</odoo>
