<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Workplan views start-->
        <record model="ir.ui.view" id="workplan_workplan_view_form">
        <field name="name">workplan.workplan.view.form</field>
        <field name="model">workplan.workplan</field>
        <field name="arch" type="xml">
            <form string="Workplan">
                <header> 
                    <button string="Submit" name="action_workplan_submit" states="draft" type="object"
                            class="oe_highlight" groups="workplan.workplan_group_manager"/>
                    <button string="Confirm" name="action_workplan_confirm" states="submit" type="object"
                            class="oe_highlight" groups="workplan.workplan_group_hod"/>
                    <button string="Approve" name="action_workplan_validate" states="confirm" type="object"
                            class="oe_highlight" groups="workplan.workplan_group_admin"/>
                    <button string="Done" name="action_workplan_done" states="validate" type="object"
                            class="oe_highlight" groups="workplan.workplan_group_hod"/>
                    <button string="Reset to Draft" name="action_workplan_draft" states="cancel,submit" type="object" groups="workplan.workplan_group_manager"/>
                    <button string="Cancel Workplan" name="action_workplan_cancel" states="confirm,validate" type="object" groups="workplan.workplan_group_hod,workplan.workplan_group_admin"/>
                    <field name="state" widget="statusbar" />
                </header>
                <field name="company_id" invisible="1"/>
                <sheet string="Workplan">
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" attrs="{'readonly':[('state','!=','draft')]}" placeholder="e.g. Yearly Workplan"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" attrs="{'readonly':[('state','!=','draft')]}" domain="[('share', '=', False)]"/>
                            <field name="department_id" attrs="{'readonly':[('state','!=','draft')]}" />
                            <field name="project_id" attrs="{'readonly':[('state','!=','draft')]}" />
                        </group>
                        <group>
                            <label for="date_from" string="Period"/>
                            <div>
                                <div name="date_edit_only" class="o_row oe_edit_only">
                                    <field name="date_from" class='oe_inline' attrs="{'readonly':[('state','!=','draft')]}"/>
                                    <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                                    <field name="date_to" class='oe_inline' attrs="{'readonly':[('state','!=','draft')]}"/>
                                </div>
                                <div name="date_read_only" class="o_row oe_read_only">
                                    <span attrs="{'invisible': [('date_from', '=', False)]}">From <field name="date_from" class='oe_inline'/></span>
                                    <span attrs="{'invisible': [('date_to', '=', False)]}">To <field name="date_to" class='oe_inline'/></span>
                                </div>
                            </div>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Workplan Lines" name="workplan_line">
                            <field name="workplan_lines"
                                   context="{'default_date_from': date_from,'default_date_to': date_to}" colspan="4"
                                   nolabel="1" attrs="{'readonly':[('state','!=','draft')]}">
                                <tree string="Workplan Lines" editable="bottom">
                                    <field name="objective_id" options="{'no_create': True}"/>
                                    <field name="outcome_id" options="{'no_create': True}"/>
                                    <field name="indicator_id" options="{'no_create': True}"/>
                                    <field name="measure"/> 
                                    <field name="target"/>  
                                    <field name="planned_target" />
                                    <field name="actual_target" />
                                    <field name="budget_estimate" sum="Budget Estimate"/>
                                    <field name="allocated_balance" sum="Allocated Balance"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="progress" widget="progressbar" options="{'max': 100}"/>
                                    <field name="date_from" invisible="1"/>
                                    <field name="date_to" invisible="1"/>
                                    <button type="object" name="action_view_activities" string="Activities..."
                                            icon="fa-arrow-circle-o-right"/>
                                </tree>
                                <form string="Workplan Lines">
                                    <group>
                                        <group>
                                            <field name="objective_id" options="{'no_create': True}"/>
                                            <field name="outcome_id" options="{'no_create': True}"/>
                                            <field name="indicator_id" options="{'no_create': True}"/>
                                            <field name="measure"/> 
                                            <field name="target"/>  
                                            <field name="planned_target"/>
                                            <field name="actual_target"/>
                                        </group>
                                        <group>
                                            <label for="date_from" string="Period"/>
                                            <div>
                                                <field name="date_from" class="oe_inline"/>
                                                -
                                                <field name="date_to" class="oe_inline"/>
                                            </div>
                                            <field name="company_id" options="{'no_create': True}"
                                                   groups="base.group_multi_company"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="workplan_workplan_view_tree">
            <field name="name">workplan.workplan.view.tree</field>
            <field name="model">workplan.workplan</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-muted="state in ('done','cancel')" string="Workplan">
                    <field name="name" colspan="1"/>
                    <field name="department_id"/>
                    <field name="project_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <field name="activity_exception_decoration" widget="activity_exception"/>
                </tree>
            </field>
        </record>

        <record id="view_workplan_workplan_search" model="ir.ui.view">
            <field name="name">workplan.workplan.search</field>
            <field name="model">workplan.workplan</field>
            <field name="arch" type="xml">
                <search string="Workplan">
                    <field name="name" filter_domain="[('name', 'ilike', self)]" string="Workplan"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" help="Draft Workplans"/>
                    <filter string="To Approve" name="toapprove" domain="[('state', '=', 'confirm')]"
                            help="To Approve Workplans"/>
                    <filter string="To Close" name="toclose" domain="[('state', '=', 'validate')]"
                            help="To Close Workplans"/> 
                </search>
            </field>
        </record>

        <record id="view_workplan_workplan_kanban" model="ir.ui.view">
            <field name="name">workplan.workplan.kanban</field>
            <field name="model">workplan.workplan</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="row mb4">
                                    <div class="col-8">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="col-4">
                                        <span class="float-end">
                                            <field name="state" widget="label_selection"
                                                options="{'classes': {'draft': 'default', 'done': 'success'}}"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-10">
                                        <i class="fa fa-clock-o" role="img" aria-label="Period" title="Period"/>
                                        <t t-esc="record.date_from.value"/>-
                                        <t t-esc="record.date_to.value"/>
                                    </div>
                                    <div class="col-2">
                                        <span class="float-end">
                                            <field name="user_id" widget="many2one_avatar_user"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_workplan_workplan_view">
            <field name="name">Workplans</field>
            <field name="res_model">workplan.workplan</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="workplan_workplan_view_tree"/>
            <field name="search_view_id" ref="view_workplan_workplan_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click to create a new workplan.
                </p>
                <p>
                    Use workplans to compare actual with expected targets
                </p>
            </field>
        </record>

        <record id="menu_workplan_plan" model="ir.ui.menu">
            <field name="action" ref="act_workplan_workplan_view" />
        </record>

    <!-- Workplan views end-->

    <!-- Workplan Lines views start-->
        <record id="view_workplan_workplan_lines_search" model="ir.ui.view">
            <field name="name">workplan.workplan.lines.search</field>
            <field name="model">workplan.workplan.lines</field>
            <field name="arch" type="xml">
                <search string="Workplan Lines">
                    <field name="objective_id"/>
                    <field name="outcome_id"/>
                    <field name="indicator_id"/>
                    <field name="measure"/> 
                    <field name="target"/>  
                    <field name="workplan_id"/>
                    <filter name="filter_not_cancelled" string="Not Cancelled" domain="[('workplan_state','!=','cancel')]"/>
                    <separator/>
                    <filter string="Date" name="filter_date_from" date="date_from"/>
                    <group expand="0" string="Group By">
                        <filter name="group_workplan_id" string="Workplan" domain="[]" context="{'group_by':'workplan_id'}"/>
                    </group>
                </search>

            </field>
        </record>

        <record model="ir.ui.view" id="view_workplan_workplan_lines_tree">
            <field name="name">workplan.workplan.lines.tree</field>
            <field name="model">workplan.workplan.lines</field>
            <field name="arch" type="xml">
                <tree string="Workplan Lines" create="0">
                    <field name="workplan_id" invisible="1"/>
                    <field name="objective_id" />
                    <field name="outcome_id" />
                    <field name="indicator_id" />
                    <field name="measure"/> 
                    <field name="target"/>  
                    <field name="planned_target" />
                    <field name="actual_target" />
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"  />
                    <field name="date_to"  />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_orkplan_workplan_lines_form">
            <field name="name">workplan.workplan.lines.form</field>
            <field name="model">workplan.workplan.lines</field>
            <field name="arch" type="xml">
                <form string="Workplan Lines">
                    <sheet>
                        <group col="4">
                            <field name="company_id" invisible="1"/>
                            <field name="workplan_state" invisible="1"/>
                            <field name="workplan_id"  attrs="{'readonly':[('workplan_state','!=','draft')]}"/>
                            <field name="objective_id"  attrs="{'readonly':[('workplan_state','!=','draft')]}"/>
                            <field name="outcome_id"  attrs="{'readonly':[('workplan_state','!=','draft')]}"/>
                            <field name="indicator_id"  attrs="{'readonly':[('workplan_state','!=','draft')]}"/>
                            <field name="measure"/> 
                            <field name="target" attrs="{'readonly':[('workplan_state','!=','draft')]}"/>  
                            <field name="planned_target" />
                            <field name="actual_target" />
                            <field name="date_from"  attrs="{'readonly':[('workplan_state','!=','draft')]}"/>
                            <field name="date_to"  attrs="{'readonly':[('workplan_state','!=','draft')]}"/>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"  attrs="{'readonly':[('workplan_state','!=','draft')]}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

         <!-- Workplan Lines views end-->

    </data>
</odoo>