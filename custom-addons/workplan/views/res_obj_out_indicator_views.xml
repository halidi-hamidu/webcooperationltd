<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Start of Workplan Objective-->
        <record id="view_workplan_objective_search" model="ir.ui.view">
            <field name="name">workplan.objective.search</field>
            <field name="model">workplan.objective</field>
            <field name="arch" type="xml">
                <search string="Objective">
                    <field name="name" filter_domain="[('name','ilike',self)]" string="Objective"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </search>
            </field>
        </record>

        <record id="view_workplan_objective_tree" model="ir.ui.view">
            <field name="name">workplan.objective.tree</field>
            <field name="model">workplan.objective</field>
            <field name="arch" type="xml">
                <tree string="Objective">
                    <field name="name"/>
                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>
        
        <record model="ir.ui.view" id="view_workplan_objective_form">
            <field name="name">workplan.objective.form</field>
            <field name="model">workplan.objective</field>
            <field name="arch" type="xml">
                <form string="Objective">
                <field name="company_id" invisible="1"/>
                <sheet>
                    <group col="4">
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Outcomes" name="outcomes">
                            <field name="outcome_ids">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                </form>
            </field>
        </record>

        <record id="open_workplan_objective" model="ir.actions.act_window">
            <field name="name">Objective</field>
            <field name="res_model">workplan.objective</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="view_workplan_objective_tree"/>
            <field name="search_view_id" ref="view_workplan_objective_search"/>
        </record>

        <record id="menu_workplan_objective" model="ir.ui.menu">
            <field name="action" ref="open_workplan_objective" />
        </record>
        <!-- End of Workplan Objective-->

        <!-- Start of Workplan Outcome-->
        <record id="view_workplan_outcome_search" model="ir.ui.view">
            <field name="name">workplan.outcome.search</field>
            <field name="model">workplan.outcome</field>
            <field name="arch" type="xml">
                <search string="Outcome">
                    <field name="name" filter_domain="[('name','ilike',self)]" string="Outcome"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </search>
            </field>
        </record>

        <record id="view_workplan_outcome_tree" model="ir.ui.view">
            <field name="name">workplan.outcome.tree</field>
            <field name="model">workplan.outcome</field>
            <field name="arch" type="xml">
                <tree string="Outcome">
                    <field name="objective_id"/>
                    <field name="name"/>
                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>
        
        <record model="ir.ui.view" id="view_workplan_outcome_form">
            <field name="name">workplan.outcome.form</field>
            <field name="model">workplan.outcome</field>
            <field name="arch" type="xml">
                <form string="Outcome">
                <field name="company_id" invisible="1"/>
                <sheet>
                    <group col="4">
                        <field name="objective_id"/>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Indicators" name="indicators">
                            <field name="indicator_ids">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                </form>
            </field>
        </record>

        <record id="open_workplan_outcome" model="ir.actions.act_window">
            <field name="name">Outcome</field>
            <field name="res_model">workplan.outcome</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="view_workplan_outcome_tree"/>
            <field name="search_view_id" ref="view_workplan_outcome_search"/>
        </record>

        <record id="menu_workplan_outcome" model="ir.ui.menu">
            <field name="action" ref="open_workplan_outcome" />
        </record>
        <!-- End of Workplan Outcome-->

        <!-- Start of Workplan Indicator-->
        <record id="view_workplan_indicator_search" model="ir.ui.view">
            <field name="name">workplan.indicator.search</field>
            <field name="model">workplan.indicator</field>
            <field name="arch" type="xml">
                <search string="Indicator">
                    <field name="name" filter_domain="[('name','ilike',self)]" string="Indicator"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </search>
            </field>
        </record>

        <record id="view_workplan_indicator_tree" model="ir.ui.view">
            <field name="name">workplan.indicator.tree</field>
            <field name="model">workplan.indicator</field>
            <field name="arch" type="xml">
                <tree string="Indicator">
                    <field name="objective_id"/>
                    <field name="outcome_id"/>
                    <field name="name"/>
                    <field name="measure"/>
                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>
        
        <record model="ir.ui.view" id="view_workplan_indicator_form">
            <field name="name">workplan.indicator.form</field>
            <field name="model">workplan.indicator</field>
            <field name="arch" type="xml">
                <form string="Indicator">
                <field name="company_id" invisible="1"/>
                <sheet>
                    <group col="4">
                        <field name="objective_id"/>
                        <field name="outcome_id"/>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Settings" name="setting">
                            <group col="4">
                                <field name="measure"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                </form>
            </field>
        </record>

        <record id="open_workplan_indicator" model="ir.actions.act_window">
            <field name="name">Indicator</field>
            <field name="res_model">workplan.indicator</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="view_workplan_indicator_tree"/>
            <field name="search_view_id" ref="view_workplan_indicator_search"/>
        </record>

        <record id="menu_workplan_indicator" model="ir.ui.menu">
            <field name="action" ref="open_workplan_indicator" />
        </record>
        <!-- End of Workplan Indicator-->

    </data>
</odoo>