<odoo>
    <record id="view_project_task_config_form" model="ir.ui.view">
        <field name="name">project.task.config.form</field>
        <field name="model">project.task.config</field>
        <field name="arch" type="xml">
            <form string="Project Task Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Target"/>
                        </h1>
                    </div>
                    <group>
                        <field name="field_name"/>
                        <field name="readonly"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_task_config_tree" model="ir.ui.view">
        <field name="name">project.task.config.tree</field>
        <field name="model">project.task.config</field>
        <field name="arch" type="xml">
            <tree string="Project Task Configuration">
                <field name="name"/>
                <field name="field_name"/>
                <field name="readonly"/>
            </tree>
        </field>
    </record>

     <record id="open_project_task_config_tree" model="ir.actions.act_window">
        <field name="name">Fields Config</field>
        <field name="res_model">project.task.config</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="view_project_task_config_tree"/>
        <!-- <field name="search_view_id" ref="view_workplan_outcome_search"/> -->
    </record>

    <record id="menu_workplan_project_task_config" model="ir.ui.menu">
        <field name="action" ref="open_project_task_config_tree" />
    </record>
</odoo>