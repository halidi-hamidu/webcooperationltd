<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!--Account budget: Crossover cancel state-->
        <record id="crossovered_budget_view_form" model="ir.ui.view">
            <field name="name">crossovered.budget.view.form.custom</field>
            <field name="model">crossovered.budget</field>
            <field name="inherit_id" ref="account_budget.crossovered_budget_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='crossovered_budget_line']/tree/field[@name='analytic_account_id']" position="after">
                    <field name="task_id"/>
                </xpath>
                <field name="allocated_balance" position="attributes">
                    <attribute name="attrs">{'invisible':[('crossovered_budget_type','=','revenue')]}</attribute>
                </field>
                <field name="allocated_amount" position="attributes">
                    <attribute name="attrs">{'invisible':[('crossovered_budget_type','=','revenue')]}</attribute>
                </field>
                <field name="budget_balance" position="attributes">
                    <attribute name="attrs">{'invisible':[('crossovered_budget_type','=','revenue')]}</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>
