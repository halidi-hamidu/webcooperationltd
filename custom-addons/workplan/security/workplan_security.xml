<?xml version="1.0" ?>
<odoo>
    <record id="module_workplan_category" model="ir.module.category">
        <field name="name">Workplan</field>
        <field name="sequence">19</field>
    </record>
    <record id="workplan_group_user" model="res.groups">
        <field name="name">Officer : Can impliment workplan</field>
        <field name="category_id" ref="module_workplan_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="workplan_group_manager" model="res.groups">
        <field name="name">Manager : Can submit workplan</field>
        <field name="category_id" ref="module_workplan_category"/>
        <field name="implied_ids" eval="[(4, ref('workplan_group_user'))]"/>
    </record>
    <record id="workplan_group_hod" model="res.groups">
        <field name="name">HOD : Confirm workplan</field>
        <field name="category_id" ref="module_workplan_category"/>
        <field name="implied_ids" eval="[(4, ref('workplan_group_manager'))]"/>
    </record>
    <record id="workplan_group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('workplan_group_hod'))]"/>
        <field name="category_id" ref="module_workplan_category"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
     <!-- Rule For Workplan Department-->
    <record id="rule_workplan_department" model="ir.rule">
        <field name="name">Rule: Workplan per Department</field>
        <field name="model_id" ref="model_workplan_workplan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('department_id','=',user.employee_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user')),(4, ref('workplan_group_user')), (4,ref('workplan_group_manager')), (4,ref('workplan_group_hod'))]"/>
    </record>
    <!-- Rule For Workplan Administrator-->
    <record id="rule_workplan_department" model="ir.rule">
        <field name="name">Rule: Workplan Administrator</field>
        <field name="model_id" ref="model_workplan_workplan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('workplan_group_admin'))]"/>
    </record>
</odoo>