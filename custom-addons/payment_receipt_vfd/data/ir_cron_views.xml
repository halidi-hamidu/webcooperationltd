<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="send_payment_receipt_vfd" forcecreate='True' model="ir.cron">
            <field name="name">Send Payment Receipt VFD</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="model_payment_receipt_vfd"/>
            <field name="state">code</field>
            <field name="code">model.send_receipt_cron()</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="get_delivered_reports_sms_notification" forcecreate='True' model="ir.cron">
            <field name="name">Get Payment Receipt Status VFD</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="model_payment_receipt_vfd"/>
            <field name="state">code</field>
            <field name="code">model.get_receipt_status()</field>
        </record>
    </data>
</odoo>
