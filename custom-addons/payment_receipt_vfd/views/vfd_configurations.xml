<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <record id="res_config_settings_view_form_payment_receipt_vfd" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.payment_receipt_vfd</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="25"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="VFD Receipt" string="VFD Receipt" name="payment_receipt_vfd" groups="base.group_erp_manager">
                        <block title="Payment Receipt VFD Configurations" name="vfd_config_container">
                            <setting id="vfd_base_url_setting" string="VFD Base URL">
                                <field name="vfd_base_url"/>
                            </setting>
                            <setting id="vfd_api_key_setting" string="VFD API Key">
                                <field name="vfd_api_key" password="True"/>
                            </setting>
                            <setting id="vfd_api_secret_setting" string="VFD API Secret">
                                <field name="vfd_api_secret" password="True"/>
                            </setting>
                            <setting id="x_tin_setting" string="TIN Number">
                                <field name="x_tin"/>
                            </setting>
                            <setting id="vfd_token_setting" string="VFD Token">
                                <field name="vfd_token" password="True"/>
                            </setting>
                        </block>
                        <block title="Payment Receipt VFD Daily Counter" name="vfd_counter_container">
                            <setting id="enable_edit_fields_setting" string="Enable Field Editing" help="Enable editing of counter fields">
                                <field name="enable_to_edit_fields" widget="boolean_toggle"/>
                            </setting>
                            <setting id="vfd_receipt_count_setting" string="VFD Receipt Count">
                                <field name="vfd_receipt_count" readonly="enable_to_edit_fields == False"/>
                            </setting>
                            <setting id="vfd_daily_counter_setting" string="VFD Daily Counter">
                                <field name="vfd_daily_counter" readonly="enable_to_edit_fields == False"/>
                            </setting>
                            <setting id="counter_latest_update_setting" string="Counter Latest Update">
                                <field name="counter_latest_update" readonly="enable_to_edit_fields == False"/>
                            </setting>
                        </block>
                        <block title="VFD API Settings" name="vfd_api_settings_container">
                            <setting id="vfd_api_actions_setting" string="API Actions">
                                <div class="content-group">
                                    <div class="row ms-2">
                                        <button name="refresh_token" class="oe_highlight" type="object"
                                                string="Refresh Token"/>
                                        <button name="refresh_settings" class="oe_highlight mt-2" type="object"
                                                string="Refresh Settings"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="vfd_header_setting" string="Header">
                                <field name="header" readonly="1"/>
                            </setting>
                            <setting id="vfd_message_setting" string="Message">
                                <field name="message" readonly="1"/>
                            </setting>
                            <setting id="vfd_expires_setting" string="Expires">
                                <field name="expires" readonly="1"/>
                            </setting>
                            <setting id="vfd_verification_code_setting" string="Verification Code">
                                <field name="verification_code" readonly="1"/>
                            </setting>
                            <setting id="vfd_has_vrn_setting" string="Has VRN">
                                <field name="has_vrn" readonly="1"/>
                            </setting>
                        </block>
                        <block title="Electronic Receipt Verification Configurations" name="receipt_verification_container">
                            <setting id="verification_base_url_setting" string="Verification Base URL">
                                <field name="verification_base_url"/>
                            </setting>
                            <setting id="verification_secrete_url_setting" string="Verification Secret URL">
                                <field name="verification_secrete_url"/>
                            </setting>
                            <setting id="verification_code_base_setting" string="Verification Code Base">
                                <field name="verification_code_base"/>
                            </setting>
                            <setting id="starting_sequence_setting" string="Starting Sequence">
                                <field name="starting_sequence"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_payment_receipt_vfd_configuration" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'module' : 'payment_receipt_vfd'}</field>
        </record>


        <menuitem id="payment_receipt_general_settings" name="VFD Settings" parent="account.menu_finance_configuration" groups="base.group_system"/>
        <menuitem id="payment_receipt_vfd_settings" name="VFD Settings" parent="payment_receipt_general_settings"
                  action="action_payment_receipt_vfd_configuration" groups="base.group_system"/>

</odoo>