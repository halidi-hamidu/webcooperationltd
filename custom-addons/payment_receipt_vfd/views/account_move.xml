<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="invoice_form_inherit" model="ir.ui.view">
            <field name="name">account.move.invoice.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@id='account_invoice_payment_btn']" position="after">
                    <field name="is_vfd_receipt_generated" invisible="1"/>
                    <button name="generate_vfd_receipt" type="object" string="Generate VFD Receipt" class="oe_highlight"
                            confirm="Are you sure you want to generate VFD receipt for this transaction? This action can't be undone."
                            invisible="is_vfd_receipt_generated == True or state in ('draft','authorize','cancel') or move_type != 'out_invoice'"/>
                    <button name="regenerate_vfd_receipt" type="object" string="Regenerate VFD Receipt"
                            confirm="This will update the VFD receipt with current invoice data and reset it to queue. Continue?"
                            invisible="is_vfd_receipt_generated == False or state in ('draft','authorize','cancel') or move_type != 'out_invoice'"/>
                    <button name="print_vfd_receipt"  class="oe_highlight" type="object" string="Print VFD Receipt" invisible="is_vfd_receipt_generated == False or state in ('draft','authorize','cancel') or move_type != 'out_invoice'"/>
                    <button name="%(account.account_invoices)d"  class="oe_highlight" type="action" string="Print TAX Invoice" invisible="is_vfd_receipt_generated == False or state in ('draft','authorize','cancel')"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="vfd_info" string="VFD Info" invisible="move_type != 'out_invoice'">
                        <group string="VFD Info">
                            <group id="vfd_tab_group">
                                <field name="payment_type_id" required="move_type == 'out_invoice'"/>
                                <field name="tax_type_id" required="move_type == 'out_invoice'"/>
                                <field name="identity_type_id" required="move_type == 'out_invoice'"/>
                                <field name="is_vfd_receipt_generated" widget="boolean_toggle" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>