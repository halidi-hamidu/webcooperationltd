        <record id="payment_receipt_vfd_act_window" model="ir.actions.act_window">
            <field name="name">VFD Receipt</field>
            <field name="res_model">payment.receipt.vfd</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no Receipts found.
                </p>
            </field>
        </record>

        <record id="payment_receipt_missing_tree_view" model="ir.ui.view">
            <field name="name">payment.receipt.missing.tree</field>
            <field name="model">payment.receipt.missing</field>
            <field name="arch" type="xml">
                <list string="Missing EFD Receipts" default_order="create_date desc">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="payment_receipt_missing_act_window" model="ir.actions.act_window">
            <field name="name">Missing EFD Receipts</field>
            <field name="res_model">payment.receipt.missing</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no Receipts found.
                </p>
            </field>
        </record>

        <menuitem name="EFD Receipts" id="payment_receipt_vfd_menu" parent="account.menu_finance_receivables" sequence="4" action="payment_receipt_vfd_act_window"/>
        <menuitem name="Missing EFD Receipts" id="payment_receipt_missing_menu" parent="account.menu_finance_receivables" sequence="5" action="payment_receipt_missing_act_window" groups="base.group_user" />

    </data>
</odoo>