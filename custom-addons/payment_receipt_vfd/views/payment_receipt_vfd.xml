<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payment_receipt_vfd_form_view" model="ir.ui.view">
            <field name="name">payment.receipt.vfd.form</field>
            <field name="model">payment.receipt.vfd</field>
            <field name="arch" type="xml">
                <form string="VFD Receipt" create="false" edit="false">
                    <header>
                        <button name="send_receipt" string="SEND NOW" class="oe_highlight" invisible="state != 'draft'"
                                type="object"/>
                        <button name="verify_receipt" string="VERIFY NOW" class="oe_highlight" invisible="state != 'verified'" type="object"/>
                        <button name="reset_receipt" string="Reset" invisible="state not in ['reconcilled','diff','missing']" type="object"/>
                        <button name="resend_receipt" string="Resend" invisible="state != 'error'" type="object"/>
                        <button name="print_vfd_receipt" string="Print Receipt" class="oe_highlight" 
                                type="object"/>
                        <button name="cancel_receipt" string="Cancel" invisible="state not in ['draft','sent']" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,sent,verified,error,reconcilled,diff,missing,cancel"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="receipt_no"/>
                            <h1>
                                <field name="receipt_no" placeholder="Reciept No" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="receipt_date" readonly="1"/>
                                <field name="receipt_time_str" readonly="1"/>
                                <field name="invoice_id" readonly="1"/>
                                <field name="receipt_id" readonly="1"/>
                                <field name="receipt_z_no" readonly="1"/>
                                <field name="verification_code" readonly="1"/>
                                <field name="business_line" readonly="1"/>
                            </group>
                            <group>
                                <field name="customer_name" readonly="1"/>
                                <field name="customer_phone" readonly="1"/>
                                <field name="customer_vrn" readonly="1"/>
                                <field name="customer_id" readonly="1"/>
                                <field name="receipt_url" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page name="vfd_items" string="Items">
                                <group>
                                    <field name="items" readonly="1"/>
                                </group>
                            </page>
                            <page name="error_page" string="Error Status"
                                  invisible="state != 'error'">
                                <group>
                                    <field name="error_message" readonly="1"/>
                                </group>
                            </page>
                            <page name="tra_page" string="EFDMS Details">
                                <group>
                                    <group>
                                        <field name="total_excl_tax"/>
                                        <field name="total_tax"/>
                                        <field name="total_incl_tax"/>
                                    </group>
                                    <group>
                                        <field name="base_amount_diff"/>
                                        <field name="tax_amount_diff"/>
                                    </group>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="payment_receipt_vfd_tree_view" model="ir.ui.view">
            <field name="name">payment.receipt.vfd.tree</field>
            <field name="model">payment.receipt.vfd</field>
            <field name="arch" type="xml">
                <list create="false" string="VFD Receipts" decoration-muted="state=='cancel'" decoration-danger="state=='missing' or state=='error'"
                      decoration-success="state=='reconcilled'" decoration-info="state=='verified'" decoration-warning="state=='diff'" 
                      default_order="create_date desc">
                    <field name="receipt_date" optional="hide"/>
                    <field name="receipt_time" string="Receipt Datetime"/>
                    <field name="receipt_time_str" optional="hide"/>
                    <field name="invoice_id"/>
                    <field name="invoice_currency"/>
                    <field name="business_line" optional="show"/>
                    <field name="amount_untaxed_signed" sum="Untaxed"/>
                    <field name="amount_tax_signed" sum="Tax"/>
                    <field name="amount_total_signed" sum="Total"/>
                    <field name="receipt_no" optional="hide"/>
                    <field name="receipt_id" optional="hide"/>
                    <field name="receipt_z_no" optional="hide"/>
                    <field name="customer_name"/>
                    <field name="total_excl_tax" sum="Total Excl Tax"/>
                    <field name="total_tax" sum="Total Tax"/>
                    <field name="total_incl_tax" sum="Total Incl Tax"/>
                    <field name="base_amount_diff" sum="Base Amount Difference"/>
                    <field name="tax_amount_diff" sum="Tax Amount Difference"/>
                    <field name="customer_phone" optional="hide"/>
                    <field name="customer_vrn" optional="hide"/>
                    <field name="customer_id" optional="hide"/>
                    <field name="verification_code" optional="hide"/>
                    <field name="receipt_url" optional="hide"/>
                    <field name="state" optional="show"/>
                </list>
            </field>
        </record>

