<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- START PAYMENT TYPE VIEWS-->
        <record id="vfd_payment_type_form_view" model="ir.ui.view">
            <field name="name">payment.receipt.payment.type.form</field>
            <field name="model">payment.receipt.payment.type</field>
            <field name="arch" type="xml">
                <form string="VFD Payment Types">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="description"/>
                        </group>
                    </sheet><odoo noupdate="1"></odoo>
                </form>
            </field>
        </record>

        <record id="vfd_payment_type_tree_view" model="ir.ui.view">
            <field name="name">payment.receipt.payment.type.tree</field>
            <field name="model">payment.receipt.payment.type</field>
            <field name="arch" type="xml">
                <list string="VFD Payment Types">
                    <field name="name"/>
                    <field name="key"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="vfd_payment_type_act_window" model="ir.actions.act_window">
            <field name="name">VFD Payment Types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">payment.receipt.payment.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Payment Types found.
                </p>
            </field>
        </record>

        <menuitem name="Payment Types" id="vfd_payment_type_menu" parent="payment_receipt_general_settings" action="vfd_payment_type_act_window"/>
        <!-- END PAYMENT TYPE VIEWS-->

