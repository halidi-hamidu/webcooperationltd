<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dev_due_partner_form" model="ir.ui.view">
        <field name="name">view.dev.due.partner.form</field>
        <field name="model">dev.due.partner</field>
        <field name="arch" type="xml">
           <form string="Due Partner">
                <group>
                    <group>
                        <field name="date" string="Date As on"/>
                    </group>
                    <group>
                        <field name="aging_by"/>
                    </group>
                </group>
                <footer>
	            	<button string="View Customer" name="view_due_partner" type="object" class="oe_highlight"/>
	            	 or
	            	 <button string="PDF Statement" name="print_statement" type="object" class="oe_highlight"/>
	            	 or
	            	 <button string="Excel Statement" name="print_excel_statement" type="object" class="oe_highlight"/>
	            	 or
                     <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_dev_due_partner" model="ir.actions.act_window">
        <field name="name">Due Partner Statement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dev.due.partner</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dev_due_partner_form"/>
        <field name="target">new</field>
    </record>
    
    <menuitem name="Due Partner Statement" id="menu_dev_due_partner" 
              parent="account.menu_finance_reports" 
              action="action_dev_due_partner" sequence="1"/>
        
    
</odoo>

