<odoo>

    <record id="paperformat_customer_statement" model="report.paperformat">
        <field name="name">Customer Statement A4</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">55</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">50</field>
        <field name="dpi">90</field>
    </record>
    
    
    <record id="report_customer_statement" model="ir.actions.report">
        <field name="name">Customer Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dev_customer_statement_advance.dev_acc_statement_temp</field>
        <field name="report_file">dev_customer_statement_advance.dev_acc_statement_temp</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_customer_statement"/>
    </record>
    
    
</odoo>
