<odoo>
	<template id="cust_statement_main_template">  
		<t t-call="dev_customer_statement_advance.external_statement_layout">
			<div class="page">
				<style>

				.aging_table{
					width:100%;
					font-size:12px;
				}
				.aging_table td{
					padding:5px;
					border:1px solid black;
				}
				.my_table{
				    width:100%;
				}
				.my_table th{
				    padding:3px;
				    border-bottom:1px solid black;
				}
				.my_table td{
				    padding:3px;
				}
				</style>
				<div class="row">
				    <br/><br/>
				    <div class="col-12 text-center" style="font-size:15px">
				        <b>STATEMENT OF ACCOUNT</b>
				    </div>
				</div>
				
				<div class="row">
				    <div style="font-size:13px" class="col-6" t-esc="o"
                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                    <div class="col-5 pull-right" style="font-size:13px;">
                        <b>As of 
                            <t t-if="o.overdue_date">
                                <span t-esc="o.overdue_date.strftime('%d-%m-%Y')"/>
                            </t></b><br/>
                        <t t-if="o.property_payment_term_id">
                            <b>Credit Term </b><span t-esc="o.property_payment_term_id.name"/>
                        </t>
                    </div>
                </div>
                
				<div class="row mt8 mb8">
				    <br/><br/>
				</div>
				<table class="my_table" style="font-size: 12px" t-if="o.statement_lines">
	            	<thead>
	                    <tr>
	                        <th style="width:17%">Description</th>
	                        <th style="width:12%" class="text-center">Invoice Date</th>
	                        <th style="width:12%" class="text-center">Due Date</th>
	                        <th style="width:17%" class="text-center">Invoice #</th>
	                        <th style="width:14%" class="text-right">Invoice Amt</th>
	                        <th style="width:14%" class="text-right">Payment Amt</th>
	                        <th style="width:14%" class="text-right">Balance Due</th>
	                    </tr>
	                </thead>
	                <tbody class="invoice_tbody">
	                	<t t-set="l_debit" t-value="0" />
                        <t t-set="l_credit" t-value="0" />
                        <t t-set="l_total" t-value="0" />
	                	<t t-foreach="o.statement_lines" t-as="l" >
	                		<tr>
		                        <td>
		                            <span t-esc="l.desc"/>
		                        </td>
	                            <td class="text-center">
	                            	<span t-esc="l.invoice_date.strftime('%d-%m-%Y')"/>
	                            </td>
	                            <td class="text-center">
	                            	<span t-esc="l.due_date.strftime('%d-%m-%Y')"/>
	                            </td>
		                        <td class="text-center">
		                            <span t-esc="l.invoice_number"/>
		                        </td>
		                        <td class="text-right">
		                            <t t-set="l_debit" t-value="l_debit + l.invoice_amount" />
		                            <span t-field="l.invoice_amount"/>
		                        </td>
		                        <td class="text-right">
		                            <t t-set="l_credit" t-value="l_credit + l.payment_amount" />
		                            <span t-field="l.payment_amount"/>
		                        </td>
		                        <td class="text-right">
	                                <t t-set="l_total" t-value="l_total+ l.balance_amount" />
	                                <span t-field="l.balance_amount"/>
		                        </td>
		                    </tr>
	                	</t>
	                	<tr style="background:#e0e0e0;">
                            <td style="border-top:1px solid black" colspan="3"></td>
                            <td style="border-top:1px solid black"><strong>Sub-Total :</strong></td>
                            <td style="border-top:1px solid black" class="text-right">
                                <span t-esc="l_debit" 
                                      t-options='{"widget": "monetary", "display_currency": o.statement_currency_id}'/>
                            </td>
                            <td style="border-top:1px solid black" class="text-right">
                                <span t-esc="l_credit"
                                      t-options='{"widget": "monetary", "display_currency": o.statement_currency_id}'/>
                            </td>
                            <td style="border-top:1px solid black" class="text-right">
                                <span t-esc="l_total" 
                                      t-options='{"widget": "monetary", "display_currency": o.statement_currency_id}'/>
                            </td>
                        </tr>
	                </tbody>
    			</table>
    			
    			<div class="row" t-if="not o.statement_lines">
					<div class="col-12">
						<p>
		                    <strong>There is nothing due with this customer.</strong>
		                </p>
					</div>
				</div>
				<br/><br/>
				<t t-if="o.statement_lines">
				    <t t-if="not o.is_on_date">
					    <t t-set="aging" t-value="set_ageing(o)"/>
					    <table class="col-12 aging_table" t-if="aging">
						    <tr>
							    <td class="text-center">
								    <b>Current</b>
							    </td>
							    <t t-foreach="aging[1]" t-as="a_val" >
								    <td class="text-center">
									    <b><span t-esc="a_val"/></b>
								    </td>
							    </t>
						    </tr>
						    
						    <tr>
							    <td class="text-center">
								    <b><span t-esc="aging[0].get('not_due')" 
								             t-options='{"widget": "monetary", "display_currency": o.statement_currency_id}'/></b>
							    </td>
							    <t t-foreach="aging[1]" t-as="a_val" >
								    <td class="text-center">
									    <b><span t-esc="aging[0].get(a_val)" 
									             t-options='{"widget": "monetary", "display_currency": o.statement_currency_id}'/></b>
								    </td>
							    </t>
						    </tr>
					    </table>
					</t>
					<t t-if="o.is_on_date">
					    <t t-set="aging" t-value="set_ageing_date(o)"/>
					    <table class="col-12 aging_table" t-if="aging">
						    <tr>
							    <td class="text-center">
								    <b>Not Due</b>
							    </td>
							    <t t-foreach="aging[1]" t-as="a_val" >
								    <td class="text-center">
									    <b><span t-esc="a_val"/></b>
								    </td>
							    </t>
						    </tr>
						    
						    <tr>
							    <td class="text-center">
								    <b><span t-esc="aging[0].get('not_due')" 
								             t-options='{"widget": "monetary", "display_currency": o.statement_currency_id}'/></b>
							    </td>
							    <t t-foreach="aging[1]" t-as="a_val" >
								    <td class="text-center">
									    <b><span t-esc="aging[0].get(a_val)" 
									             t-options='{"widget": "monetary", "display_currency": o.statement_currency_id}'/></b>
								    </td>
							    </t>
						    </tr>
					    </table>
					</t>
				</t>
				
    			
		    </div>
		</t>
	</template>
	
	
	<template id="dev_acc_statement_temp">
		<t t-call="web.html_container">
		    <t t-foreach="docs" t-as="o">
		        <t t-call="dev_customer_statement_advance.cust_statement_main_template" />
		    </t>
		</t>
	</template>


</odoo>

