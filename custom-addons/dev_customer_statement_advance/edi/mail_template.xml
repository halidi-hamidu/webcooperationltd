<?xml version="1.0"?>
<odoo>
        <!--Email template -->
        <record id="dev_partner_send_statement" model="mail.template">
            <field name="name">Customer Statement to Partner</field>
            <field name="email_from">{{ (object.company_id.email_formatted or object.company_id.email_formatted) }}</field>
            <field name="subject"> {{(object.name)}} Account Statement</field>
            <field name="partner_to">{{ object.id }}</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="report_template" ref="report_customer_statement"/>
            <field name="report_name">{{(object.name or '')}} Account Statement</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html"><![CDATA[
            	<p>Dear <b><t t-out="object.name or ''"></t></b>,</p>
            	<p></p>
            	<p> Your Account Statement Attach in this email</p>
            	
            	<b>Regards,</b><br/>
            	<t t-out="object.company_id.name or ''"></t>
                ]]></field>
         </record>
         
</odoo>
        
        
        
      
        
        
    
