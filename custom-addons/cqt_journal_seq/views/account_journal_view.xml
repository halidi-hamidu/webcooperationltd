<odoo>
    <record id="cqt_account_journal_view" model="ir.ui.view" >
        <field name="name">cqt.account.journal.seq</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page string="Sequence">
                    <group>
                        <group string="Sequence">
                            <field name="seq_id"/>
                            <field name="seq_num_next"/>
                        </group>
                        <group string="Refund Sequence">
                            <field name="refund_seq_id"/>
                            <field name="refund_seq_num_next"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>