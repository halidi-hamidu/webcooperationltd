<odoo>
    <record id="cqt_account_move_view" model="ir.ui.view">
        <field name="name">cqt.account.move.seq</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="invisible">state == 'draft'</attribute>
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </field>
        </field>
    </record>

    <record id="cqt_account_move_tree" model="ir.ui.view">
        <field name="name">cqt.account.move.seq.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="invisible">state == 'draft'</attribute>
            </field>
        </field>
    </record>
</odoo>