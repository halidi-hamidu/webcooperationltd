<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="header" position="after">
                    <header invisible="not is_vtd_transfer">
                        <field name="vtd_state" widget="statusbar"/>
                    </header>
                </xpath>
                <xpath expr="//page[@name='note']" position="after">
                    <page name="vtd_settings" string="VTD Details"
                          invisible="not is_vtd_transfer">
                        <group>
                            <field name="vtd_state" readonly="1"/>
                        </group>
                        <group>
                            <group>
                                <field name="dispatched_to"/>
                            </group>
                            <group></group>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="is_vtd_transfer"/>
                    <field name="dispatched_to" invisible="not is_vtd_transfer"/>
                </xpath>
            </field>
        </record>

        <!-- <record id="view_picking_type_form_vtd" model="ir.ui.view">
            <field name="name">stock.picking.type.inherit</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sequence_code']" position="after">
                    <field name="type_code"/>
                </xpath>
            </field>
        </record> -->
    </data>
</odoo>