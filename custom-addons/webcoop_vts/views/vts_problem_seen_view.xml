<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="vts_problem_seen_form_view" model="ir.ui.view">
            <field name="name">vts_problem_seen.form</field>
            <field name="model">vts.problem.seen</field>
            <field name="arch" type="xml">
                <form string="VTS Problem Seen">
                    <sheet>
                        <group>
                            <field name="value"/>
                            <field name="key"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="vts_problem_seen_tree_view" model="ir.ui.view">
            <field name="name">vts.reported.problem.tree</field>
            <field name="model">vts.problem.seen</field>
            <field name="arch" type="xml">
                <list string="VTS Problem Seen">
                    <field name="value"/>
                    <field name="key"/>
                </list>
            </field>
        </record>

        <record id="vts_problem_seen_act_window" model="ir.actions.act_window">
            <field name="name">VTS Problem Seen</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vts.problem.seen</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Problem Seen found.
                </p>
            </field>
        </record>

        <menuitem name="Problem Seen" id="vts_problem_seen_menu" parent="vts_config_menu" action="vts_problem_seen_act_window"/>

    </data>
</odoo>