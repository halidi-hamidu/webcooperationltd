<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_create_ticket_from_jobcard_wizard_form" model="ir.ui.view">
        <field name="name">create.ticket.from.jobcard.wizard.form</field>
        <field name="model">create.ticket.from.jobcard.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Ticket from Job Card">
                <sheet>
                    <group>
                        <group>
                            <field name="job_card_id" invisible="1"/>
                            <field name="name" placeholder="e.g., Service Routine - T123ABC"/>
                            <field name="team_id" options="{'no_create': True}"/>
                            <field name="user_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="technician_id" options="{'no_create': True}"/>
                            <field name="partner_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Add ticket description..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_ticket" string="Create Ticket" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
