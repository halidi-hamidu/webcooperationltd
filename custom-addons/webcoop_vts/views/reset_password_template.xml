<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="reset_password_template" name="Reset password">
        <t t-call="web.login_layout">
            <div t-if="message" class="oe_login_form clearfix">
                <p class="alert alert-success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>
                <a href="/web/login" class="d-none btn btn-link btn-sm float-start" role="button">Back to Login</a>
            </div>

            <form class="oe_reset_password_form" role="form" method="post" t-if="not message">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <!-- <t t-if="token and not invalid_token">
                    <t t-call="auth_signup.fields">
                        <t t-set="only_passwords" t-value="1"/>
                    </t>
                </t> -->

                <!-- <t t-if="not token">
                    <div class="mb-3 field-login">
                        <label for="login" class="col-form-label">Your Email</label>
                        <input type="text" name="login" t-att-value="login" id="login" class="form-control"
                            autofocus="autofocus" required="required" autocapitalize="off"/>
                    </div>
                </t> -->

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="request.params.get('token')"/>
                <label for="new_password" class="col-form-label">New Password</label>
                <input type="password" name="new_password" class="form-control" autofocus="autofocus" required="required"/>
                <div class="clearfix oe_login_buttons d-grid mt-3">
                    <button type="submit" class="btn btn-primary">Reset Password</button>
                    <div class="o_login_auth"/>
                </div>

            </form>
            <xpath expr="//div[@class'"></xpath>
            <div class="d-none text-center small mt-4 pt-3 border-top">
                <a class="border-end pe-2 me-1" href="/web/database/manager">Manage Databases</a>
                <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank">Powered by <span>Odoo</span></a>
            </div>

        </t>
    </template>

    <template id="reset_password_success" name="Reset password success">
        <!-- create a template for success layout -->
        <t t-call="web.login_layout">
            <div class="oe_login_form clearfix">
                <p class="alert alert-success" role="status">
                    Your password has been successfully reset.
                </p>
                <a href="/web/login" class="btn btn-link btn-sm float-start d-none" role="button">Back to Login</a>
            </div>
        </t>

    </template>

</odoo>
