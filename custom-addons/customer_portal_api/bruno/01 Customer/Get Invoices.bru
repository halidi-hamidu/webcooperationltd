meta {
  name: Get Invoices
  seq: 2
}

get {
  url: {{base_url}}/api/v1/customer/invoices?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  page: 1
  limit: 20
  ~status: posted
  ~date_from: 2026-01-01
  ~date_to: 2026-12-31
}

tests {
  test("status is 200", function() {
    expect(res.status).to.eql(200);
  });
  test("pagination metadata present", function() {
    expect(res.body.pagination).to.have.all.keys("page", "limit", "total", "pages");
  });
}

docs {
  Returns the authenticated customer's invoices with lines, amounts,
  payment state, and pagination.

  Optional filters (disable with the checkbox in the Params tab):
  - `status`: draft | posted | cancel
  - `date_from` / `date_to`: YYYY-MM-DD range on invoice_date

  Errors: 400 VALIDATION_ERROR (bad page/limit/dates), 401 UNAUTHORIZED
}
