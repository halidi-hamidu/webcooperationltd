meta {
  name: Reset Password
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "customer@example.com"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.eql(200);
  });
  test("generic response message", function() {
    expect(res.body.message).to.include("If an account exists");
  });
}

docs {
  Requests a password-reset email using Odoo's built-in signed,
  expiring reset-token flow. Always returns the same generic response —
  account existence is never revealed.

  Errors: 400 VALIDATION_ERROR (missing email), 429 RATE_LIMITED
}
