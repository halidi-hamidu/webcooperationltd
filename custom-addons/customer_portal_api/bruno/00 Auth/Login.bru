meta {
  name: Login
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "customer@example.com",
    "password": "customer_password"
  }
}

script:post-response {
  if (res.body.success && res.body.data.token) {
    bru.setVar("token", res.body.data.token);
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.eql(200);
  });
  test("returns token", function() {
    expect(res.body.data.token).to.be.a("string");
  });
}

docs {
  Authenticates a portal user and returns a Bearer token.
  The token is automatically saved to the collection variable `token`.

  Errors: 400 VALIDATION_ERROR, 401 INVALID_CREDENTIALS, 429 RATE_LIMITED
}
