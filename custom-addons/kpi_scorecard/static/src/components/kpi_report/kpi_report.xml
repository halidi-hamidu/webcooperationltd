<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="kpi_scorecard.KpiReport" owl="1">
        <div class="o_action o_view_controller o_kanban_view">
            <div class="o_content kpi-content">
                <div class="jstr-navigation-panel jstr-hide-mobile jstr-hide-tablet">
                    <div class="jstr-panel-content">
                        <div class="jstr-panel-header">
                            <div class="jstr-periods-sections mr16">                        
                                <t t-if="state.periodIds">
                                    <select class="jstr-periods-select" t-on-change="(event) => this._onChangePeriod(event)">
                                        <t t-foreach="state.periodIds" t-as="periodChoice" t-key="periodChoice.length">
                                            <option t-attf-selected="#{periodChoice_index == 0 and 'selected' or false}" t-attf-value="#{periodChoice.length}">
                                                <t t-esc="periodChoice.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </t>
                            </div>
                        </div>
                        <div class="jstr-panel-header pt0" t-if="state.multiCompany">
                            <div class="jstr-periods-sections mr16">                        
                                <t t-if="state.kpiCompanies">
                                    <select class="jstr-periods-select" t-on-change="(event) => this._onChangeCompany(event)">
                                        <t t-foreach="state.kpiCompanies" t-as="companyChoice" t-key="companyChoice.id">
                                            <option t-attf-selected="#{companyChoice.selected and 'selected' or false}" t-attf-value="#{companyChoice.id}">
                                                <t t-esc="companyChoice.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </t>
                            </div>
                        </div>
                        <div class="jstr-panel-header pt0">
                            <div class="jstr-periods-sections mr16">
                                <select class="jstr-periods-select" t-on-change="(event) => this._onChangeGraphType(event)">
                                    <option value="line" selected="1" >Line graph</option>
                                    <option value="bar">Bar graph</option>
                                </select>
                            </div>
                        </div>
                        <div class="jstr-panel-body kpi-kanban-switchers">
                            <div>
                                <label class="kpi-kanban-report-switcher">
                                    <input type="checkbox" checked="1" t-on-change="(event) => this._onToggleTargets(event)"/>
                                    <span class="kpi-kanban-report-slider"></span>
                                </label> 
                                <span class="ml8">show targets</span>
                            </div>
                            <div>
                                <label class="kpi-kanban-report-switcher">
                                    <input type="checkbox" checked="1" t-on-change="(event) => this._onToggleActual(event)"/>
                                    <span class="kpi-kanban-report-slider"></span>
                                </label> 
                                <span class="ml8">show actual</span>
                            </div>
                        </div>
                        <KpiJsTreeContainer t-props="getJsTreeProps('kpi_kanban_categories')"/>
                        <KpiJsTreeContainer t-props="getJsTreeProps('kpi_items')"/>
                        <KpiJsTreeContainer t-props="getJsTreeProps('kpi_tags')"/>
                    </div>
                </div>
                <div class="o_kanban_renderer o_renderer d-flex o_kanban_ungrouped align-content-start flex-wrap justify-content-start jstr-kanban-view">
                    <t t-if="state.kpiSet and state.thisPeriodId and state.thisCompanyId">
                        <t t-foreach="state.kpiSet" t-as="kpiItem" t-key="kpiItem.id">
                            <div class="kpi-kanban-article">
                                <div class="kpi-kanban-record-card">
                                    <KpiChart kpiId="kpiItem.id" kpiPeriodLength="state.thisPeriodId.length" kpiPeriodCompanyId="state.thisCompanyId and state.thisCompanyId.id or false" kpiChartType="state.kpiChartType" showTargets="state.showTargets" showActual="state.showActual"/>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="o_view_nocontent">
                            <div class="o_nocontent_help">
                                No KPIs are found! Please make sure that the chosen categories and KPIs are suitable and you have selected the period type<t t-if="state.multiCompany"> and the company</t>.
                            </div>
                        </div>                       
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
