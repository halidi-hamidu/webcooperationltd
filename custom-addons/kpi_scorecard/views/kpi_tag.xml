<?xml version="1.0"?>
<odoo>

    <record id="kpi_tag_view_search" model="ir.ui.view">
        <field name="name">kpi.tag.search</field>
        <field name="model">kpi.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="parent_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                </group>
            </search>
        </field>
    </record>
    <record id="kpi_tag_view_form" model="ir.ui.view">
        <field name="name">kpi.tag.form</field>
        <field name="model">kpi.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="KPI Category"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                        <field name="company_id"
                               options="{'no_create_edit': 1, 'no_quick_create': 1, 'no_open': 1}" 
                               groups="base.group_multi_company"   
                        />
                        
                    </group>
                    <group  invisible="1">
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="kpi_tag_view_tree" model="ir.ui.view">
        <field name="name">kpi.tag.tree</field>
        <field name="model">kpi.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="kpi_tag_action" model="ir.actions.act_window">
        <field name="name">KPI tags</field>
        <field name="res_model">kpi.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" eval="kpi_tag_view_search"/>
    </record>

</odoo>
