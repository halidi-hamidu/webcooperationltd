<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="ects_no_edit_issued" model="ir.rule">
            <field name="name">You can not Edit when the Trip is Issued</field>
            <field ref="model_ects_trip" name="model_id"/>
            <field name="domain_force">[('state', '=', 'issued')]</field>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <!-- You can attach this rule to a specific group, Or make it Global -->
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <!--<field name="global" eval="1"/>-->
        </record>
    </data>
</odoo>