<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ects_cargo_type_form_view" model="ir.ui.view">
            <field name="name">ects.cargo.type.form</field>
            <field name="model">ects.cargo.type</field>
            <field name="arch" type="xml">
                <form string="Cargo Type">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="key"/>
                                <field name="master_price"/>
                                <field name="slave_price"/>
                                <field name="credit_master_price"/>
                                <field name="credit_slave_price"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ects_cargo_type_tree_view" model="ir.ui.view">
            <field name="name">ects.cargo.type.tree</field>
            <field name="model">ects.cargo.type</field>
            <field name="arch" type="xml">
                <tree string="Cargo Type">
                    <field name="name"/>
                    <field name="key"/>
                    <field name="master_price"/>
                    <field name="slave_price"/>
                    <field name="credit_master_price"/>
                    <field name="credit_slave_price"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="ects_cargo_type_act_window" model="ir.actions.act_window">
            <field name="name">ECTS Cargo Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ects.cargo.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Cargo Type Added.
                </p>
            </field>
        </record>

        <menuitem name="Cargo Types" id="ects_cargo_type_menu" parent="ects_trip_config_menu" action="ects_cargo_type_act_window"/>

    </data>
</odoo>