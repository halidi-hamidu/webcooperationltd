<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ects_trip_form_view" model="ir.ui.view">
            <field name="name">ects.trip.form</field>
            <field name="model">ects.trip</field>
            <field name="arch" type="xml">
                <form string="ECTS Trips">
                    <header>
                        <button name="submit_trip" string="SUBMIT" class="oe_highlight" invisible="state != 'draft'" type="object"/>
                        <button name="issue_receipt" string="ISSUE RECEIPT" class="oe_highlight" invisible="state not in ('draft','pending','approved')" type="object"/>
                        <button name="activate_device" string="ACTIVATE DEVICE" class="oe_highlight" invisible="state != 'issued'" type="object"/>
                        <button name="approve_trip" string="APPROVE" class="oe_highlight" invisible="state != 'pending'" type="object"/>
                        <field name="is_reconcilled" invisible="1" />
                        <button name="trip_reconcilled" string="RECONCILLED" class="oe_highlight" type="object" invisible="is_reconcilled == True"/>
                        <button name="trip_unreconcilled" string="UNRECONCILLE" class="oe_highlight" type="object" invisible="is_reconcilled == False"/>
                        <button name="reject_trip" string="REJECT" class="oe_highlight" invisible="state != 'pending'" type="object"/>
                        <button name="cancel_trip_button" string="CANCEL" class="oe_highlight" invisible="state not in ('pending','approved')" type="object"/>
                        <button name="confirm_cancel_trip_button" string="CONFIRM CANCELLATION" class="oe_highlight" invisible="state != 'waiting'" type="object"/>
                        <button name="reset_to_draft" string="Reset To Draft" class=""
                                invisible="state not in ('pending','approved','cancelled','rejected')" type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="number"/>
                            <h1>
                                <field name="number" placeholder="Trip Number"
                                       readonly="state in  ('issued','in-transit','unlocked')"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="create_date"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="employee_id"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="customer_name"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="agent_name"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="source_location"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="destination"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="driver_id"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="passport_number"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="start_date"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="end_date"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                            </group>
                            <group>
                                <field name="lock_assigned_employee_id" invisible="1"/>
                                <field name="e_seal_id" string="Master Lock"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="slave_count"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="cargo_number"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="cargo_type"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="car_type"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="container_horse"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="container_trailer"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="car_plate_number"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="payment_type"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="amount_received"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="gate_number" optional="hide"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="submitted_at"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="issued_at"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="approved_at"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="rejected_at"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                <field name="cancelled_at"
                                       readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="cancellation_reasons" string="Cancellation Reasons"
                                  readonly="state != 'cancelled'">
                                <group>
                                    <field name="cancellation_reasons"
                                           readonly="state in ('issued','cancelled','approved','in-transit','unlocked')"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="ects_trip_tree_view" model="ir.ui.view">
            <field name="name">ects.trip.tree</field>
            <field name="model">ects.trip</field>
            <field name="arch" type="xml">
                <tree string="ECTS Trips" decoration-muted="state == 'cancelled'"
                      decoration-warning="state == 'in-transit'"
                      decoration-success="state == 'unlocked'"
                      decoration-info="state == 'waiting'"
                      decoration-danger="state == 'rejected'">
                    <field name="create_date"/>
                    <field name="number"/>
                    <field name="employee_id"/>
                    <field name="customer_name"/>
                    <field name="source_location"/>
                    <field name="destination"/>
                    <field name="e_seal_id" string="Master Lock"/>
                    <field name="slave_count"/>
                    <field name="driver_id"/>
                    <field name="agent_name"/>
                    <field name="cargo_number"/>
                    <field name="cargo_type"/>
                    <field name="car_type"/>
                    <field name="container_horse" optional="hide"/>
                    <field name="container_trailer" optional="hide"/>
                    <field name="car_plate_number" optional="hide"/>
                    <field name="payment_type"/>
                    <field name="amount_received" sum="Total" groups="base.group_erp_manager"/>
                    <field name="gate_number" optional="hide"/>
                    <field name="start_date" optional="hide"/>
                    <field name="end_date" optional="hide"/>
                    <field name="state"/>
                    <field name="is_swapped"/>
                    <field name="is_reconcilled"/>
                    <field name="passport_number" optional="hide"/>
                    <field name="submitted_at" optional="hide"/>
                    <field name="issued_at" optional="hide"/>
                    <field name="approved_at" optional="hide"/>
                    <field name="rejected_at" optional="hide"/>
                    <field name="cancelled_at" optional="hide"/>
                    <field name="lock_assigned_employee_id" invisible="1"/>
                </tree>
            </field>
        </record>

