        <record id="ects_trip_kanban_view" model="ir.ui.view">
            <field name="name">ects.trip.kanban</field>
            <field name="model">ects.trip</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <field name="number"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_res_partner_kanban">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title oe_partner_heading">
                                        <field name="number"/>
                                    </strong>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="ects_trip_act_window" model="ir.actions.act_window">
            <field name="name">ECTS Trips</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ects.trip</field>
            <field name="view_mode">tree,form,kanban</field>
            <!--<field name="view_mode">kanban,tree,form,calendar,graph,pivot</field>-->
            <field name="context">{"search_default_example_field":1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Trips Found.
                </p>
            </field>
        </record>

        <!-- This Menu Item will appear in the Upper bar, That's why It needs NO parent or action -->
        <menuitem id="ects_menu_root" name="ECTS" web_icon="ictpack_ects,static/description/icon.png"/>
        <menuitem name="ECTS Trips" id="ects_trip_menu" parent="ects_menu_root" action="ects_trip_act_window"/>
        <menuitem name="Configuration" id="ects_trip_config_menu" parent="ects_menu_root"/>

    </data>
</odoo>