<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_partner_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.ects</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="import_contacts" type="object" class="oe_stat_button" />
                </div>
                <xpath expr="//page[@name='internal_notes']" position="after">
                    <page name="ects_settings" string="ECTS Settings">
                        <group>
                            <group>
                                <field name="is_ects_agent"/>
                                <field name="is_ects_driver"/>
                                <field name="driver_license"/>
                            </group>
                            <group>
                                <field name="is_credit_customer"/>
                            </group>
                        </group>

                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>