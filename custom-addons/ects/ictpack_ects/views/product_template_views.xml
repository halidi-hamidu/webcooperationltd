<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_inherit" model="ir.ui.view">
            <field name="name">product.template.product.form.ects</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='inventory']" position="after">
                    <page name="ects" string="ECTS">
                        <group>
                            <group>
                                <field name="is_ects_product"/>
                                <field name="is_master_lock"/>
                            </group>
                        </group>

                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_production_lot_form_inherit" model="ir.ui.view">
            <field name="name">production.lot.form.ects</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="sheet" position="before">
                    <header invisible="is_ects_product == False">
                        <button name="refresh_device_status" type="object" string="REFRESH STATUS"
                                class="oe_highlight"/>
                        <button name="ects_status" type="object" string="ECTS Status"/>
                        <field name="ects_state" widget="statusbar"/>
                    </header>
                </xpath>
                 <xpath expr="//button[@name='action_lot_open_quants']" position="after">
                    <button name="action_view_trip" icon="fa-truck" class="oe_stat_button" type="object" invisible="trip_count == 0">
                        <field name="trip_count" widget="statinfo" string="Associated Trips"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="ects_assigned_to"/>
                    <field name="is_ects_product"/>
                </xpath>
                <xpath expr="//page[@name='description']" position="after">
                    <page name="ects_details" invisible="is_ects_product == False" string="Ects Details">
                        <group>
                            <field name="tra_status" readonly="1"/>
                            <field name="tra_date" readonly="1"/>
                            <field name="tra_power" readonly="1"/>
                            <field name="latitude" readonly="1"/>
                            <field name="longitude" readonly="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_production_lot_tree_inherit" model="ir.ui.view">
            <field name="name">stock.view.production.lot.tree</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='create_date']" position="after">
                    <field name="trip_count"/>
                    <field name="ects_state"/>
                    <field name="tra_date"/>
                    <field name="tra_power"/>
                    <field name="latitude"/>
                    <field name="longitude"/>
                    <button name="open_map" type="object" string="View on Map" class="oe_highlight"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>