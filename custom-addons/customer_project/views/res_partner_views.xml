<?xml version="1.0"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.project</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                    name="action_open_project_config" context="{'default_partner_id': id, 'default_team_id': False}" icon="fa-puzzle-piece" invisible="not project_count">
                    <div class="o_stat_info">
                        <field name="project_count" class="o_stat_value"/>
                        <span class="o_stat_text"> Projects</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="view_partner_tree" model="ir.ui.view">
        <field name="name">res.partner.tree.project</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="project_count" />
            </field>
        </field>
    </record>

</odoo>
