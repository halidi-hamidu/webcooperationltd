<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="header" position="after">
                    <header attrs="{'invisible':[['is_ects_transfer','=',False]]}">
                        <button name="ects_status" type="object" string="ECTS Status"/>
                        <field name="ects_state" widget="statusbar"/>
                    </header>
                </xpath>
                <xpath expr="//page[@name='note']" position="after">
                    <page name="ects_settings" string="ECTS Details"
                          attrs="{'invisible':[['is_ects_transfer','=',False]]}">
                        <group>
                            <field name="ects_state" readonly="1"/>
                        </group>
                        <group>
                            <group>
                                <field name="dispatched_to"/>
                            </group>
                            <group></group>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="is_ects_transfer"/>
                    <field name="dispatched_to" attrs="{'invisible':[['is_ects_transfer','=',False]]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>