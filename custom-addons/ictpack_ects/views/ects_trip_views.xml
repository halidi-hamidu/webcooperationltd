<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ects_trip_form_view" model="ir.ui.view">
            <field name="name">ects.trip.form</field>
            <field name="model">ects.trip</field>
            <field name="arch" type="xml">
                <form string="ECTS Trips">
                    <header>
                        <button name="submit_trip" string="SUBMIT" class="oe_highlight" states="" type="object"/>
                        <button name="issue_receipt" string="ISSUE RECEIPT" class="oe_highlight" states=""
                                type="object"/>
                        <button name="approve_trip" string="APPROVE" class="oe_highlight" states="" type="object"/>
                        <button name="reject_trip" string="REJECT" class="oe_highlight" states="" type="object"/>
                        <button name="cancel_trip" string="CANCEL" class="oe_highlight" states="" type="object"/>
                        <button name="reset_to_draft" string="Reset To Draft" class="" states="" type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="number"/>
                            <h1>
                                <field name="number" placeholder="Trip Number"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="create_date"/>
                                <field name="employee_id"/>
                                <field name="customer_name"/>
                                <field name="agent_name"/>
                                <field name="source_location"/>
                                <field name="destination"/>
                                <field name="driver_id"/>
                                <field name="passport_number"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                            <group>
                                <field name="lock_assigned_employee_id" invisible="1"/>
                                <field name="e_seal_id" string="Master Lock"/>
                                <field name="slave_count"/>
                                <field name="cargo_number"/>
                                <field name="cargo_type"/>
                                <field name="car_type"/>
                                <field name="payment_type"/>
                                <field name="amount_received"/>
                                <field name="gate_number" optional="hide"/>
                                <field name="submitted_at"/>
                                <field name="issued_at"/>
                                <field name="approved_at"/>
                                <field name="rejected_at"/>
                                <field name="cancelled_at"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ects_trip_tree_view" model="ir.ui.view">
            <field name="name">ects.trip.tree</field>
            <field name="model">ects.trip</field>
            <field name="arch" type="xml">
                <tree string="ECTS Trips">
                    <field name="create_date"/>
                    <field name="number"/>
                    <field name="employee_id"/>
                    <field name="customer_name"/>
                    <field name="source_location"/>
                    <field name="destination"/>
                    <field name="e_seal_id" string="Master Lock"/>
                    <field name="slave_count"/>
                    <field name="driver_id"/>
                    <field name="agent_name"/>
                    <field name="cargo_number"/>
                    <field name="cargo_type"/>
                    <field name="car_type"/>
                    <field name="payment_type"/>
                    <field name="amount_received" sum="Total" groups="base.group_erp_manager"/>
                    <field name="gate_number" optional="hide"/>
                    <field name="start_date" optional="hide"/>
                    <field name="end_date" optional="hide"/>
                    <field name="state"/>
                    <field name="passport_number" optional="hide"/>
                    <field name="submitted_at" optional="hide"/>
                    <field name="issued_at" optional="hide"/>
                    <field name="approved_at" optional="hide"/>
                    <field name="rejected_at" optional="hide"/>
                    <field name="cancelled_at" optional="hide"/>
                    <field name="lock_assigned_employee_id" invisible="1"/>
                </tree>
            </field>
        </record>

