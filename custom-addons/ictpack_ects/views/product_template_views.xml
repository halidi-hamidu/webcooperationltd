<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_inherit" model="ir.ui.view">
            <field name="name">product.template.product.form.ects</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='inventory']" position="after">
                    <page name="ects" string="ECTS">
                        <group>
                            <group>
                                <field name="is_ects_product"/>
                                <field name="is_master_lock"/>
                            </group>
                            <group>
                                <!--                                <field name="ects_state" widget="statusbar"/>-->
                                <!--                                <field name="dispatched_to"/>-->
                            </group>
                        </group>

                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_production_lot_form_inherit" model="ir.ui.view">
            <field name="name">production.lot.form.ects</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="sheet" position="before">
                    <header attrs="{'invisible':[['is_ects_product','=',False]]}">
                        <button name="ects_status" type="object" string="ECTS Status"/>
                        <field name="ects_state" widget="statusbar"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="ects_assigned_to"/>
                    <field name="is_ects_product"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>