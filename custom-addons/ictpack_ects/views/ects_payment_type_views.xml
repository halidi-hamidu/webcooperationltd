        <record id="ects_payment_type_act_window" model="ir.actions.act_window">
            <field name="name">ECTS Payment Types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ects.payment.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Payment Types found.
                </p>
            </field>
        </record>

        <menuitem name="Payment Types" id="ects_payment_type_menu" parent="ects_trip_config_menu" action="ects_payment_type_act_window"/>

    </data>
</odoo>