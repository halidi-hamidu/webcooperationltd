<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ects_payment_type_form_view" model="ir.ui.view">
            <field name="name">ects.payment.type.form</field>
            <field name="model">ects.payment.type</field>
            <field name="arch" type="xml">
                <form string="ECTS Payment Types">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="requires_approval"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ects_payment_type_tree_view" model="ir.ui.view">
            <field name="name">ects.payment.type.tree</field>
            <field name="model">ects.payment.type</field>
            <field name="arch" type="xml">
                <tree string="ECTS Payment Types">
                    <field name="name"/>
                    <field name="key"/>
                    <field name="requires_approval"/>
                </tree>
            </field>
        </record>

