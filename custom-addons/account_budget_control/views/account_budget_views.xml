<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!--Budget Analytic: Form View (v19: budget.analytic replaces crossovered.budget)-->
        <record id="budget_analytic_view_form" model="ir.ui.view">
            <field name="name">budget.analytic.view.form.custom</field>
            <field name="model">budget.analytic</field>
            <field name="inherit_id" ref="account_budget.view_budget_analytic_form"/>
            <field name="arch" type="xml">
                <!-- budget_type is already shown natively in the form -->
                <xpath expr="//field[@name='budget_line_ids']/list/field[@name='achieved_amount']" position="after">
                    <field name="budget_analytic_type" invisible="1"/>
                    <field name="allocated_amount" invisible="budget_analytic_type == 'revenue'"/>
                    <field name="budget_balance" invisible="budget_analytic_type == 'revenue'"/>
                    <field name="allocated_balance" invisible="budget_analytic_type == 'revenue'"/>
                </xpath>
                <xpath expr="//field[@name='budget_line_ids']/list/button[@name='action_open_budget_entries']" position="after">
                    <button name="open_budget_allocation_form"
                            invisible="parent.state != 'confirmed' or budget_analytic_type == 'revenue'"
                            context="{'is_relocation': False, 'budget_line_id': id}"
                            type="object" string="Allocate" class="oe_highlight"
                            groups="account.group_account_manager"/>
                    <button name="open_budget_allocation_form"
                            invisible="parent.state != 'confirmed' or budget_analytic_type == 'revenue'"
                            context="{'is_relocation': True, 'budget_line_id': id}"
                            type="object" string="Relocate" class="oe_highlight"
                            groups="account.group_account_manager"/>
                </xpath>
            </field>
        </record>


        <!--Budget Allocation: Allocation views-->
        <record id="view_budget_allocation_search" model="ir.ui.view">
            <field name="name">account.budget.allocation.search</field>
            <field name="model">account.budget.allocation</field>
            <field name="arch" type="xml">
                <search string="Budgetary Allocation">
                    <field name="name" filter_domain="[('name','ilike',self)]" string="Budgetary Allocation"/>
                    <field name="budget_line_id" filter_domain="[('budget_line_id','ilike',self)]" string="Budget Line"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </search>
            </field>
        </record>

        <record id="view_budget_allocation_tree" model="ir.ui.view">
            <field name="name">account.budget.allocation.tree</field>
            <field name="model">account.budget.allocation</field>
            <field name="arch" type="xml">
                <list string="Budgetary Allocation" create="false" delete='false'>
                    <field name="is_relocation" invisible="1"/>
                    <field name="budget_analytic_id" invisible="1"/>
                    <field name="name"/>
                    <field name="budget_line_id"/>
                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="date"/>
                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="view_budget_allocation_form">
            <field name="name">account.budget.allocation.form</field>
            <field name="model">account.budget.allocation</field>
            <field name="arch" type="xml">
                <form string="Budgetary Allocation" create="false" delete='false'>
                    <group>
                        <field name="budget_analytic_id" invisible="1"/>
                        <field name="name"/>
                        <field name="is_relocation" invisible="1"/>
                        <field name="amount"/>
                        <field name="date"/>
                        <field name="to_budget_line_id" invisible="is_relocation == False"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="budget_line_id" invisible="1"/>
                        <field name="date_from" invisible="1"/>
                        <field name="date_to" invisible="1"/>
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_budget_allocation_form_button">
            <field name="name">account.budget.allocation.form</field>
            <field name="model">account.budget.allocation</field>
            <field name="arch" type="xml">
                <form string="Budgetary Allocation" create="false" delete='false'>
                    <group>
                        <field name="budget_analytic_id" invisible="1"/>
                        <field name="name"/>
                        <field name="is_relocation" invisible="1"/>
                        <field name="amount"/>
                        <field name="date"/>
                        <field name="to_budget_line_id" invisible="is_relocation == False" required="is_relocation == True"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="budget_line_id" invisible="1"/>
                    </group>
                    <footer>
                        <button string='Save' name="create_allocation" type="object" invisible="amount &lt;= 0" class="oe_highlight"/>
                        <button string="Discard" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="act_budget_allocation" model="ir.actions.act_window">
            <field name="name">Budgetary Allocation</field>
            <field name="res_model">account.budget.allocation</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_id" ref="view_budget_allocation_tree"/>
            <field name="search_view_id" ref="view_budget_allocation_search"/>
        </record>

    </data>
</odoo>
