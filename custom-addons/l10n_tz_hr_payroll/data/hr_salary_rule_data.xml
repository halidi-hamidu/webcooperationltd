<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_tz_employees_salary_fixed_commission" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.ALW" />
        <field name="name">Allowance</field>
        <field name="code">ALLOWANCE</field>
        <field name="sequence">31</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = version.hra
        </field>
        <field name="struct_id" ref="l10n_tz_hr_payroll.hr_payroll_structure_tz_employee_salary" />
    </record>
    <!--  GROSS  -->
    <record id="l10n_tz_employees_salary_gross" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.GROSS"/>
        <field name="name">Gross Salary</field>
        <field name="code">GROSS</field>
        <field name="sequence">32</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories['BASIC'] + categories['ALW']
        </field>
        <field name="struct_id" ref="l10n_tz_hr_payroll.hr_payroll_structure_tz_employee_salary"/>
        <field name="bold" eval="True"/>
    </record>
    <record id="l10n_tz_employees_salary_gross_taxable" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.GROSS" />
        <field name="name">Gross Taxable</field>
        <field name="code">GROSS_TAXABLE</field>
        <field name="sequence">35</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
<![CDATA[result = result_rules['GROSS']['total'] - categories['TZ_UT_ALW'] - categories['RELIEF']]]>
</field>
        <field name="struct_id" ref="l10n_tz_hr_payroll.hr_payroll_structure_tz_employee_salary" />
        <field name="appears_on_payslip" eval="False" />
    </record>
    <!--  NSSF Employee -->
    <record id="l10n_tz_employees_salary_nssf_hidden" model="hr.salary.rule">
        <field name="category_id" ref="l10n_tz_hr_payroll.HIDDEN" />
        <field name="name">NSSF Employee Deduction</field>
        <field name="code">NSSF_EMPLOYEE_TIER_1</field>
        <field name="sequence">37</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
<![CDATA[pensionable = categories['BASIC'] + categories['ALW']
security_breakdown = payslip._rule_parameter('l10n_tz_security_breakdown')
for amount, coefficient, default in security_breakdown:
    if pensionable > amount:
        result = pensionable * coefficient
    else:
        result = default]]>
</field>
        <field name="struct_id" ref="l10n_tz_hr_payroll.hr_payroll_structure_tz_employee_salary" />
        <field name="appears_on_payslip" eval="False" />
    </record>
    <!--  PAYEE  -->
    <record id="l10n_tz_employees_salary_income_tax" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.DED" />
        <field name="name">Income Tax</field>
        <field name="code">INCOME_TAX</field>
        <field name="sequence">40</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
<![CDATA[remaining_gross = result_rules['GROSS_TAXABLE']['total'] - result_rules['NSSF_EMPLOYEE_TIER_1']['total']
income_tax_breakdown = payslip._rule_parameter('l10n_tz_income_tax_breakdown')
income_tax = 0
for min_amount, max_amount, coefficient, extra_amount in income_tax_breakdown:
    if remaining_gross >= min_amount and remaining_gross < max_amount:
        income_tax += ((remaining_gross - min_amount) * coefficient) + extra_amount
        break
result = income_tax]]>
</field>
        <field name="struct_id" ref="l10n_tz_hr_payroll.hr_payroll_structure_tz_employee_salary" />
        <field name="appears_on_payslip" eval="False" />
    </record>
    <!--  RELIEFS  -->
    <record id="l10n_tz_employees_salary_nhif_amount_hidden" model="hr.salary.rule">
        <field name="category_id" ref="l10n_tz_hr_payroll.HIDDEN" />
        <field name="name">NHIF Amount (Hidden)</field>
        <field name="code">NHIF_AMOUNT_HIDDEN</field>
        <field name="sequence">39</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
<![CDATA[insurance_breakdown = payslip._rule_parameter('l10n_tz_insurance_breakdown')
employee_contribution = payslip._rule_parameter('l10n_tz_nhif_employee_contribution')
total_nhif = categories['BASIC'] * insurance_breakdown
employer_contribution = total_nhif - employee_contribution
if employer_contribution < employee_contribution:
    result = employee_contribution
else:
    result = employer_contribution]]>
</field>
        <field name="struct_id" ref="l10n_tz_hr_payroll.hr_payroll_structure_tz_employee_salary" />
        <field name="appears_on_payslip" eval="False" />
    </record>
    <!--  DEDUCTIONS  -->
    <record id="l10n_tz_employees_salary_paye" model="hr.salary.rule">
        <field name="category_id" ref="l10n_tz_hr_payroll.STATUTORY_DED" />
        <field name="name">P.A.Y.E.</field>
        <field name="code">PAYE</field>
        <field name="sequence">50</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
<![CDATA[result = result_rules['GROSS_TAXABLE']['total'] > 270000]]>
</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
<![CDATA[result = result_rules['INCOME_TAX']['total'] + categories['RELIEF']]]>
</field>
        <field name="struct_id" ref="l10n_tz_hr_payroll.hr_payroll_structure_tz_employee_salary" />
        <field name="appears_on_payslip" eval="True" />
    </record>
