<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit and customize purchase order report -->
        <template id="report_purchaseorder_document_custom" inherit_id="purchase.report_purchaseorder_document">
            
            <!-- Hide default address display -->
            <xpath expr="//t[@t-set='address']" position="replace">
                <t t-set="address">
                    <div></div>
                </t>
            </xpath>

            <!-- Hide default information block -->
            <xpath expr="//t[@t-set='information_block']" position="replace">
                <t t-set="information_block">
                    <div></div>
                </t>
            </xpath>
            
            <!-- Hide layout_document_title -->
            <xpath expr="//div[@class='mt-4']" position="attributes">
                <attribute name="class">mt-4 d-none</attribute>
            </xpath>
            
            <!-- Hide default informations section -->
            <xpath expr="//div[@id='informations']" position="attributes">
                <attribute name="style">display:none</attribute>
            </xpath>
            
            <!-- Add custom styles after oe_structure -->
            <xpath expr="//div[@class='oe_structure'][1]" position="after">
                <style>
                    .table-head-bg{
                    background-color:#bcd5ed !important;
                    color:black !important;
                    }
                    .text-primary-alt{
                    color:#2d74b5 !important;
                    }
                    .table-bordered {
                    border-radius: 8px !important;
                    overflow: hidden !important;
                    border: 1px solid #dee2e6 !important;
                    }
                    .table-bordered thead tr:first-child th:first-child {
                    border-top-left-radius: 8px !important;
                    }
                    .table-bordered thead tr:first-child th:last-child {
                    border-top-right-radius: 8px !important;
                    }
                    .table-bordered tbody tr:last-child td:first-child {
                    border-bottom-left-radius: 8px !important;
                    }
                    .table-bordered tbody tr:last-child td:last-child {
                    border-bottom-right-radius: 8px !important;
                    }
                    .table-bordered th, .table-bordered td {
                    border-color: #dee2e6 !important;
                    }
                </style>
                
                <!-- Company and Document Info -->
                <div class="row">
                    <div class="col-12">
                        <table class="table table-sm o_main_table table-borderless" style="border:none !important">
                            <tbody>
                                <tr>
                                    <td width="60%" style="border-top:none !important">
                                        <strong>
                                            <span class="text-primary-alt" t-field="o.company_id.name"/>
                                        </strong>
                                        <br/>
                                        <span t-field="o.company_id.street"/>
                                        <br/>
                                        <span t-field="o.company_id.street2"/>,<span t-field="o.company_id.city"/>,
                                        <span t-field="o.company_id.country_id"/>
                                        <br/>
                                        <span t-field="o.company_id.phone"/>
                                        <br/>
                                        <t t-if="o.company_id.vat">
                                            <strong>
                                                <span class="text-primary-alt">TIN:</span>
                                            </strong>
                                            <span t-field="o.company_id.vat"/>
                                        </t>
                                        <t t-if="o.company_id.vrn">
                                            <strong>
                                                <span class="text-primary-alt">VRN:</span>
                                            </strong>
                                            <span t-field="o.company_id.vrn"/>
                                        </t>
                                    </td>
                                    <td width="40%" style="border-top:none !important">
                                        <div class="row">
                                            <div class="col-6">
                                                <span>
                                                    <strong class="text-primary-alt">Order No:</strong>
                                                </span>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-primary-alt" t-field="o.name"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong class="text-primary-alt">Order Date</strong>
                                            </div>
                                            <div class="col-6">
                                                <p class="text-primary-alt" t-field="o.date_order"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong class="text-primary-alt">Due Date</strong>
                                            </div>
                                            <div class="col-6" t-if="o.date_planned">
                                                <p class="text-primary-alt" t-field="o.date_planned"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong class="text-primary-alt">Purchase Rep</strong>
                                            </div>
                                            <div class="col-6">
                                                <p class="text-primary-alt" t-field="o.user_id"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong class="text-primary-alt">Order Currency</strong>
                                            </div>
                                            <div class="col-6">
                                                <p class="text-primary-alt" t-field="o.currency_id"/>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <hr/>

                <!-- Billing address -->
                <div class="row">
                    <div class="col-12">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th width="60%" class="table-head-bg">
                                        <strong class="text-primary-alt">SUPPLIER:</strong>
                                    </th>
                                    <th width="40%" class="table-head-bg">
                                        <strong class="text-primary-alt">DELIVER TO:</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="border-top:0px !important">
                                <tr>
                                    <td>
                                        <strong>
                                            <span class="text-primary-alt" t-field="o.partner_id.name"/>
                                        </strong>
                                        <br/>
                                        <span t-field="o.partner_id.street"/>
                                        <br/>
                                        <span t-field="o.partner_id.street2"/>,<span t-field="o.partner_id.city"/>,
                                        <span t-field="o.partner_id.country_id"/>
                                        <br/>
                                        <span t-field="o.partner_id.phone"/>
                                        <br/>
                                        <t t-if="o.partner_id.vat">
                                            <strong>
                                                <span class="text-primary-alt">TIN:</span>
                                            </strong>
                                            <span t-field="o.partner_id.vat"/>
                                        </t>
                                        <t t-if="o.partner_id.vrn">
                                            <strong>
                                                <span class="text-primary-alt">VRN:</span>
                                            </strong>
                                            <span t-field="o.partner_id.vrn"/>
                                        </t>
                                    </td>
                                    <td>
                                        <div class="row">
                                            <div class="col-12">
                                                <strong>
                                                    <span class="text-primary-alt" t-field="o.company_id.name"/>
                                                </strong>
                                                <br/>
                                                <span t-field="o.company_id.street"/>
                                                <br/>
                                                <span t-field="o.company_id.street2"/>,<span
                                                    t-field="o.company_id.city"/>,
                                                <span t-field="o.company_id.country_id"/>
                                                <br/>
                                                <span t-field="o.company_id.phone"/>
                                                <br/>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <hr size="10"/>

                <!-- Supplier Information -->
                <div class="row">
                    <div class="col-12">
                        <table class="table table-bordered o_main_table table-sm">
                            <thead>
                                <tr>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">Supplier Reference</strong>
                                    </th>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">Payment Terms</strong>
                                    </th>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">Incoterms</strong>
                                    </th>
                                    <th class="table-head-bg">
                                        <strong class="text-primary-alt">Delivery Date</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="border-top:0px !important">
                                <tr>
                                    <td>
                                        <p t-field="o.partner_ref"/>
                                    </td>
                                    <td>
                                        <p t-field="o.payment_term_id"/>
                                    </td>
                                    <td>
                                        <p t-field="o.incoterm_id"/>
                                    </td>
                                    <td>
                                        <p t-field="o.date_planned"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <br/>
            </xpath>
            
            <!-- Replace table headers with custom styling -->
            <xpath expr="//table[@class='o_has_total_table table o_main_table table-borderless']/thead/tr" position="replace">
                <tr>
                    <th class="table-head-bg" name="th_description">
                        <strong>Description</strong>
                    </th>
                    <th class="table-head-bg" name="th_taxes">
                        <strong>Taxes</strong>
                    </th>
                    <th name="th_date_req" class="text-center table-head-bg">
                        <strong>Date Req.</strong>
                    </th>
                    <th name="th_quantity" class="text-end table-head-bg">
                        <strong>Qty</strong>
                    </th>
                    <th name="th_price_unit" class="text-end table-head-bg">
                        <strong>Unit Price</strong>
                    </th>
                    <th name="th_amount" class="text-end table-head-bg">
                        <strong>Amount</strong>
                    </th>
                </tr>
            </xpath>
            
            <!-- Replace table data rows -->
            <xpath expr="//table[@class='o_has_total_table table o_main_table table-borderless']/tbody" position="replace">
                <tbody>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="o.order_line" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                                <td id="product">
                                    <span t-field="line.name"/>
                                </td>
                                <td name="td_taxes">
                                    <span t-esc="', '.join(map(lambda x: x.name, line.tax_ids))"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="line.date_planned"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.product_qty"/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_unit"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99" id="section">
                                    <span t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99" id="note">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-end">
                                <td colspan="99" id="subtotal">
                                    <strong class="me-3 text-primary-alt">Subtotal</strong>
                                    <span
                                            t-esc="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    />
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </xpath>
            
            <!-- Hide Payment Terms at bottom -->
            <xpath expr="//strong[text()='Payment Terms: ']" position="attributes">
                <attribute name="style">display:none</attribute>
            </xpath>
            <xpath expr="//strong[text()='Payment Terms: ']/following-sibling::span[@t-field='o.payment_term_id']" position="attributes">
                <attribute name="style">display:none</attribute>
            </xpath>
            
            <!-- Hide portal connect section -->
            <xpath expr="//div[contains(@class, 'text-center') and contains(., 'Connect your software')]" position="attributes">
                <attribute name="style">display:none</attribute>
            </xpath>
            
        </template>

        <template id="stock_report_purchaseorder_document_inherit" inherit_id="purchase_stock.report_purchaseorder_document">
            <xpath expr="//t[@t-set='information_block']" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>
        </template>
        
    </data>
</odoo>
