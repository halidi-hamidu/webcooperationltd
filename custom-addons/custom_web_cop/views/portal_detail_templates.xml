<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project / Vehicle detail page -->
    <template id="portal_project_detail" name="Web Portal Project Detail">
        <t t-call="portal.portal_layout">
            <div id="wrap" class="o_portal_wrap" style="background-color: #FFFFFF; color: #111827; min-height: 100vh; font-family: sans-serif; padding: 20px;">
                <div class="container mt-3">

                    <a href="/web_portal/dashboard?tab=vehicles" style="color: #6B7280; text-decoration: none; font-size: 13px;">← Back to Vehicles / Projects</a>

                    <div class="mt-3 mb-4">
                        <h2 style="font-weight: 700; color: #111827;"><t t-out="portal_project['name']"/></h2>
                        <p style="color: #9CA3AF; font-size: 14px;">
                            <t t-out="portal_project['ref']"/> ·
                            <span t-attf-style="display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; {{ portal_project['status_style'] }}"><t t-out="portal_project['status']"/></span>
                        </p>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Customer</div>
                                <div class="mt-1"><t t-out="portal_project['customer']"/></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Vehicle</div>
                                <div class="mt-1"><t t-out="portal_project['vehicle_plate']"/> — <t t-out="portal_project['vehicle_model']"/></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Start Date</div>
                                <div class="mt-1"><t t-out="portal_project['start_date'] or '—'"/></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Expected Completion</div>
                                <div class="mt-1"><t t-out="portal_project['end_date'] or '—'"/></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Description</div>
                                <div class="mt-1"><t t-out="portal_project['description']"/></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

    <!-- Invoice detail page -->
    <template id="portal_invoice_detail" name="Web Portal Invoice Detail">
        <t t-call="portal.portal_layout">
            <div id="wrap" class="o_portal_wrap" style="background-color: #FFFFFF; color: #111827; min-height: 100vh; font-family: sans-serif; padding: 20px;">
                <div class="container mt-3">

                    <a href="/web_portal/dashboard?tab=invoices" style="color: #6B7280; text-decoration: none; font-size: 13px;">← Back to Invoices</a>

                    <div class="mt-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h2 style="font-weight: 700; color: #111827;"><t t-out="portal_invoice['name']"/></h2>
                            <p style="color: #9CA3AF; font-size: 14px;">
                                <span t-attf-style="display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; {{ portal_invoice['status_style'] }}"><t t-out="portal_invoice['status']"/></span>
                            </p>
                        </div>
                        <t t-if="portal_invoice['amount_due'] &gt; 0 and portal_invoice['status'] != 'Cancelled'">
                            <a href="#" style="background-color: #00CC66; color: #000; border-radius: 8px; padding: 8px 20px; text-decoration: none; font-weight: 600;">💳 Pay Invoice</a>
                        </t>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Customer</div>
                                <div class="mt-1"><t t-out="portal_invoice['customer']"/></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Invoice Date</div>
                                <div class="mt-1"><t t-out="portal_invoice['invoice_date']"/></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Due Date</div>
                                <div class="mt-1" t-attf-style="color: {{portal_invoice['is_overdue'] and '#DC2626' or '#111827'}};"><t t-out="portal_invoice['invoice_date_due']"/></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Total Amount</div>
                                <div class="mt-1"><t t-out="portal_invoice['amount_total']" t-options="{'widget': 'monetary', 'display_currency': portal_invoice['currency']}"/></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Amount Paid</div>
                                <div class="mt-1" style="color: #00A85A;"><t t-out="portal_invoice['amount_paid']" t-options="{'widget': 'monetary', 'display_currency': portal_invoice['currency']}"/></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Amount Due</div>
                                <div class="mt-1" style="color: #DC2626;"><t t-out="portal_invoice['amount_due']" t-options="{'widget': 'monetary', 'display_currency': portal_invoice['currency']}"/></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3" style="border: 1px solid #E0E0E0; border-radius: 8px;">
                                <div style="color: #6B7280; font-size: 11px; text-transform: uppercase; font-weight: 600;">Description</div>
                                <div class="mt-1"><t t-out="portal_invoice['ref']"/></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

</odoo>
