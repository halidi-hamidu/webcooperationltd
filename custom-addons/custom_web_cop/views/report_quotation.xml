<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_purchasequotation_document_custom" inherit_id="purchase.report_purchasequotation_document">
            <xpath expr="//t[@t-set='address']" position="replace"/>
            <xpath expr="//t/t[@t-set='information_block']" position="replace"/>
            <xpath expr="//div/h2" position="replace">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-8">
                            <div class="card">
                                <div class="card-body">
                                    <h4>
                                        <span t-if="o.state == 'purchase rfq'">PURCHASE REQUEST</span>
                                        <span t-if="o.state == 'draft'">DRAFT ORDER/RFQ</span>
                                        <span t-if="o.state == 'sent'">RFQ SENT</span>
                                        <span t-if="o.state == 'to approve'">ORDER WAITING APPROVAL</span>
                                        <span t-if="o.state == 'co approve'">ORDER WAITING FINAL APPROVAL</span>
                                        <span t-if="o.state == 'purchase'">PURCHASE ORDER:
                                            <span t-field="o.name"/>
                                        </span>
                                        <span t-if="o.state == 'done'">PURCHASE ORDER:
                                            <span t-field="o.name"/>
                                        </span>
                                        <span t-if="o.state == 'cancel'">CANCELLED PURCHASE ORDER</span>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br/>
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-6">
                            <div class="card">
                                <div class="card-header">
                                    <strong>SHIPPING ADDRESS:</strong>
                                </div>
                                <div class="card-body">
                                    <div t-if="o.dest_address_id">
                                        <div t-field="o.dest_address_id"
                                             t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                    </div>

                                    <div t-if="not o.dest_address_id and o.picking_type_id and o.picking_type_id.warehouse_id">
                                        <span t-field="o.picking_type_id.warehouse_id.name"/>
                                        <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                             t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card">
                                <div class="card-header">
                                    <strong>VENDOR ADDRESS:</strong>
                                </div>
                                <div class="card-body">
                                    <div t-field="o.partner_id"
                                         t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                    <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'TIN'"/>:
                                        <span t-field="o.partner_id.vat"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br/>
            </xpath>
        </template>
    </data>
</odoo>
