<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_payment_custom" inherit_id="account.report_payment_receipt_document">
            <xpath expr="//div/h3" position="replace"/>
            <xpath expr="//div/div[@class='row mt64']" position="replace">
                <div class="row mt64">
                    <div class="col-xs-6">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <t t-if="o.state == 'posted'">
                                    <span>
                                        <h4>PAYMENT VOUCHER</h4>
                                    </span>
                                </t>
                                <t t-elif="o.state == 'reconciled'">
                                    <span>
                                        <h4>PAYMENT RECEIPT</h4>
                                    </span>
                                </t>
                                <t t-elif="o.state == 'cancelled'">
                                    <span>
                                        <h4>CANCELLED PAYMENT RECEIPT</h4>
                                    </span>
                                </t>
                                <t t-else="">
                                    <span>
                                        <h4>DRAFT PAYMENT RECEIPT</h4>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div/div[@class='row']" position="replace">
                <div class="row">
                    <div class="col-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <span t-if="o.partner_type == 'customer'">RECEIVED FROM:</span>
                                <span t-if="o.partner_type == 'supplier'">PAID TO:</span>
                            </div>
                            <div class="panel-body">
                                <address t-field="o.partner_id"
                                         t-field-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;:      [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>
                                <span t-if="o.partner_id.vat">TIN:
                                    <span t-field="o.partner_id.vat"/>
                                </span>
                                <span t-if="o.partner_id.vrn">VRN:
                                    <span t-field="o.partner_id.vrn"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            		<div class="row">
                    <div class="col-12">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <td>
                                        <span>Receipt No.</span>
                                    </td>
                                    <td>
                                        <span t-field="o.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Receipt Date</td>
                                    <td>
                                        <p t-field="o.payment_date"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Amount Paid</td>
                                    <td>
                                        <t t-if="o.invoice_ids">
                                            <span t-field="o.amount"
                                                  t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                                        </t>
                                        <t t-else="">
                                            <span t-field="o.amount"
                                                  t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Memo</td>
                                    <td>
                                        <span t-field="o.communication"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div/div[@class='row mb64']" position="replace">
            </xpath>

            <xpath expr="//table[@class='table table-sm']" position="replace">
                <t t-if="o.reconciled_invoice_ids">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Invoice Date</th>
                                <th>Invoice Number</th>
                                <th class="text-right">Original Amount</th>
                                <th class="text-right">Amount Paid</th>
                                <th class="text-right">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.reconciled_invoice_ids" t-as="inv">
                                <td><span t-field="inv.invoice_date"/></td>
                            <td><span t-field="inv.name"/></td>
                            <td class="text-right"><span t-field="inv.amount_total"/></td>
                            <td class="text-right"><span t-esc="o._get_invoice_payment_amount(inv)" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/></td>
                            <td class="text-right"><span t-field="inv.amount_residual"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <br/>
                <div class="row">
                    <div class="col-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">AMOUNT IN WORDS:</div>
                            <div class="panel-body">
                                <span t-field="o.amount_in_word"/>
                            </div>
                        </div>
                    </div>
                </div>
                <br/>
                <div class="row">
                    <div class="col-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">RECEIPT FORM</div>
                            <div class="panel-body">
                                <p style="text-align:center">I
                                    ................................................................Certify that on this
                                    ...........day of.......................
                                </p>
                                <p style="text-align:center">Have received CASH/CHEQUE of
                                    <span t-if="o.invoice_ids" t-field="o.amount"
                                          t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                                    <span t-else="" t-field="o.amount"
                                          t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                                </p>
                                <p style="text-align:center">Recipient Signature ..................................</p>
                            </div>
                        </div>
                    </div>
                </div>
                <br/>
                <div class="row">
                    <!--<div class="col-xs-4">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <td>
                                        <span>Prepared By</span>
                                    </td>
                                    <td>
                                        <span t-field="o.create_uid"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Signature</td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-xs-4">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <td>
                                        <span>Approved By</span>
                                    </td>
                                    <td>
                                        <span t-field="o.authorized_by"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Signature</td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-xs-4">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <td>
                                        <span>Paid By</span>
                                    </td>
                                    <td>
                                        <span t-field="o.confirmed_by"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Signature</td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>-->
                </div>
            </xpath>
        </template>
    </data>
</odoo>
