<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="screen_pop_template" name="3CX Screen Pop" inherit_id="web.notification">
        <t t-jquery=".o_notification" t-operation="replace">
            <t t-if="notification.type === '3cx_screen_pop'">
                <div class="o_3cx_screen_pop o_notification">
                    <div class="o_notification_title">
                        <span t-esc="notification.title"/>
                        <button class="o_notification_close fa fa-close" title="Close"/>
                    </div>
                    <div class="o_notification_content">
                        <div class="row">
                            <div class="col-3">
                                <t t-if="notification.data.partner_image">
                                    <img t-att-src="notification.data.partner_image" class="img-fluid rounded-circle"/>
                                </t>
                                <t t-else="">
                                    <div class="o_avatar o_avatar_rounded">
                                        <span class="fa fa-user"/>
                                    </div>
                                </t>
                            </div>
                            <div class="col-9">
                                <h5 t-esc="notification.data.partner_name"/>
                                <div t-if="notification.data.phone">
                                    <i class="fa fa-phone"/> <span t-esc="notification.data.phone"/>
                                </div>
                                <div t-if="notification.data.company">
                                    <i class="fa fa-building"/> <span t-esc="notification.data.company"/>
                                </div>
                                <div class="mt-2">
                                    <a t-att-href="notification.data.redirect_url" class="btn btn-primary btn-sm">
                                        Open Contact
                                    </a>
                                    <button class="btn btn-secondary btn-sm o_3cx_call_back ml-2">
                                        <i class="fa fa-phone"/> Call Back
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <t t-call="web.notification"/>
            </t>
        </t>
    </template>
</odoo>