<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_3cx_config_form" model="ir.ui.view">
        <field name="name">3cx.config.form</field>
        <field name="model">pbx.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="api_url"/>
                        <field name="api_key" password="True"/>
                        <field name="webhook_url" readonly="1"/>
                        <field name="screen_pop_enabled"/>
                        <field name="call_logging_enabled"/>
                        <field name="contact_sync_enabled"/>
                        <field name="debug_mode"/>
                        <field name="last_sync" readonly="1"/>
                    </group>
                    <footer>
                        <button name="setup_3cx_webhooks" string="Setup Webhooks" type="object" class="btn-primary"/>
                        <button name="sync_contacts" string="Sync Contacts" type="object" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_3cx_config" model="ir.actions.act_window">
        <field name="name">3CX Configuration</field>
        <field name="res_model">pbx.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_3cx_main" name="3CX Connector" sequence="10"/>
    <menuitem id="menu_3cx_config" name="Configuration" parent="menu_3cx_main" action="action_3cx_config" sequence="50"/>
</odoo>